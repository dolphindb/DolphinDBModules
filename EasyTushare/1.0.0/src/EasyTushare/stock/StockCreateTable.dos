def createStockFinaMainbz() {
    dbName = "dfs://tushare_basic_db"
    tbName = "stock_fina_mainbz"
    
    if(!existsDatabase(dbName)){
        print("Database of " + dbName + " does not exist, please create database first!")
    }
    else{
        db = database(dbName)
        schemaTB = table(
            array(SYMBOL, 0) as security_id,
            array(DATE, 0) as end_date,
            array(SYMBOL, 0) as bz_item,
            array(SYMBOL, 0) as bz_code,
            array(DOUBLE, 0) as bz_sales,
            array(DOUBLE, 0) as bz_profit,
            array(DOUBLE, 0) as bz_cost,
            array(SYMBOL, 0) as curr_type,
            array(SYMBOL, 0) as update_flag,
            array(TIMESTAMP, 0) as update_time
        )
        db.createDimensionTable(
            table = schemaTB,
            tableName = tbName
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "TS代码"
        columnComments["end_date"] = "报告期"
        columnComments["bz_item"] = "报告类型：P按产品 D按地区 I按行业"
        columnComments["bz_code"] = "主营业务来源"
        columnComments["bz_sales"] = "主营业务收入(元)"
        columnComments["bz_profit"] = "主营业务利润(元)"
