// 股票涨跌停数据
/*
*  @FunctionName: createStockLimit
*  @Brief: Create a DFS table for stock daily up/down limit prices
*  @Param: None
*  @Return: None
*  @SampleUsage: createStockLimit()
*/
def createStockLimit(){
    dbName = "dfs://tushare_daily_db"
    tbName = "stock_limit" 
    
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            // 严格按照图片输出参数的顺序定义字段
            array(DATE, 0) as trade_date,     // 交易日期
            array(SYMBOL, 0) as security_id,      // TS股票代码
            array(DOUBLE, 0) as pre_close,    // 昨日收盘价
            array(DOUBLE, 0) as up_limit,     // 涨停价
            array(DOUBLE, 0) as down_limit,   // 跌停价
            array(TIMESTAMP, 0) as update_time // 数据更新时间
        )
        
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = `trade_date  
        )
        go
        
        columnComments = dict(STRING, STRING)
        columnComments["trade_date"] = "交易日期"
        columnComments["security_id"] = "TS股票代码"
        columnComments["pre_close"] = "昨日收盘价"
        columnComments["up_limit"] = "涨停价"
        columnComments["down_limit"] = "跌停价"
        columnComments["update_time"] = "数据更新时间"
        
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table " + tbName + " created successfully.")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

