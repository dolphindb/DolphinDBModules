/*
*  @FunctionName: createBlockTrade
*  @Brief: Create DFS partitioned table for block_trade
*  @Param: None
*  @Return: None
*  @SampleUsage: createBlockTrade()
*/
def createBlockTrade(){
    dbName = "dfs://tushare_basic_db"
    tbName = "block_trade"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(existsTable(dbName, tbName)){
            print("Table of " + tbName + " already exists, please drop it first!")
            return
        }
        schemaTB = table(
            array(SYMBOL, 0) as security_id,
            array(DATE, 0) as trade_date,
            array(DOUBLE, 0) as price,
            array(DOUBLE, 0) as vol,
            array(DOUBLE, 0) as amount,
            array(STRING, 0) as buyer,
            array(STRING, 0) as seller,
            array(TIMESTAMP, 0) as update_time
        )
        db.createTable(
            table = schemaTB,
            tableName = tbName
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "TS代码"
        columnComments["trade_date"] = "交易日历"
        columnComments["price"] = "成交价"
        columnComments["vol"] = "成交量（万股）"
        columnComments["amount"] = "成交金额"
        columnComments["buyer"] = "买方营业部"
        columnComments["seller"] = "卖方营业部"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

