// 资金流向数据函数
/*
*  @FunctionName: createMoneyflow
*  @Brief: 创建资金流向数据表
*  @Param: None
*  @Return: None
*  @SampleUsage: createMoneyflow()
*  @Data: 资金流向数据
*/
def createMoneyflow(){
    dbName = "dfs://tushare_daily_db"
    tbName = "moneyflow"
    if(!existsDatabase(dbName)){
        print("Database of " + dbName + " does not exist, please create database first!")
    }
    else{
        db = database(dbName)
        if(existsTable(dbName, tbName)){
            print("Table of " + tbName + " already exists, please drop it first!")
            return
        }
        schemaTB = table(
            array(SYMBOL, 0) as security_id,
            array(DATE, 0) as trade_date,
            array(LONG, 0) as buy_sm_vol,
            array(DOUBLE, 0) as buy_sm_amount,
            array(LONG, 0) as sell_sm_vol,
            array(DOUBLE, 0) as sell_sm_amount,
            array(LONG, 0) as buy_md_vol,
            array(DOUBLE, 0) as buy_md_amount,
            array(LONG, 0) as sell_md_vol,
            array(DOUBLE, 0) as sell_md_amount,
            array(LONG, 0) as buy_lg_vol,
            array(DOUBLE, 0) as buy_lg_amount,
            array(LONG, 0) as sell_lg_vol,
            array(DOUBLE, 0) as sell_lg_amount,
            array(LONG, 0) as buy_elg_vol,
            array(DOUBLE, 0) as buy_elg_amount,
            array(LONG, 0) as sell_elg_vol,
            array(DOUBLE, 0) as sell_elg_amount,
            array(LONG, 0) as net_mf_vol,
            array(DOUBLE, 0) as net_mf_amount,
            array(TIMESTAMP, 0) as update_time
        )
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName, 
            partitionColumns=`trade_date
        )
        go 
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "TS股票代码"
        columnComments["trade_date"] = "交易日期"
        columnComments["buy_sm_vol"] = "小单买入量（手）"
        columnComments["buy_sm_amount"] = "小单买入金额（万元）"
        columnComments["sell_sm_vol"] = "小单卖出量（手）"
        columnComments["sell_sm_amount"] = "小单卖出金额（万元）"
        columnComments["buy_md_vol"] = "中单买入量（手）"
        columnComments["buy_md_amount"] = "中单买入金额（万元）"
        columnComments["sell_md_vol"] = "中单卖出量（手）"
        columnComments["sell_md_amount"] = "中单卖出金额（万元）"
        columnComments["buy_lg_vol"] = "大单买入量（手）"
        columnComments["buy_lg_amount"] = "大单买入金额（万元）"
        columnComments["sell_lg_vol"] = "大单卖出量（手）"
        columnComments["sell_lg_amount"] = "大单卖出金额（万元）"
        columnComments["buy_elg_vol"] = "特大单买入量（手）"
        columnComments["buy_elg_amount"] = "特大单买入金额（万元）"
        columnComments["sell_elg_vol"] = "特大单卖出量（手）"
        columnComments["sell_elg_amount"] = "特大单卖出金额（万元）"
        columnComments["net_mf_vol"] = "净流入量（手）"
        columnComments["net_mf_amount"] = "净流入额（万元）"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName,tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
    }
}

