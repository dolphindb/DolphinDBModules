/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

// 股票基础数据函数
/*
*  @FunctionName: create_bak_basic_table
*  @Brief: 创建股票历史基本面数据表
*  @Param: None
*  @Return: None
*  @SampleUsage: createBakBasic()
*/
def createBakBasic() {
    dbName = "dfs://tushare_basic_db"
    tbName = "bak_basic"
    
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(existsTable(dbName, tbName)){
            print("Table of " + tbName + " already exists, please drop it first!")
            return
        }
        schemaTB = table(
            array(DATE, 0) as trade_date,
            array(SYMBOL, 0) as security_id,
            array(STRING, 0) as name,
            array(SYMBOL, 0) as industry,
            array(SYMBOL, 0) as area_name,
            array(DOUBLE, 0) as pe,
            array(DOUBLE, 0) as float_share,
            array(DOUBLE, 0) as total_share,
            array(DOUBLE, 0) as total_assets,
            array(DOUBLE, 0) as liquid_assets,
            array(DOUBLE, 0) as fixed_assets,
            array(DOUBLE, 0) as reserved,
            array(DOUBLE, 0) as reserved_pershare,
            array(DOUBLE, 0) as eps,
            array(DOUBLE, 0) as bvps,
            array(DOUBLE, 0) as pb,
            array(DATE, 0) as list_date,
            array(DOUBLE, 0) as undp,
            array(DOUBLE, 0) as per_undp,
            array(DOUBLE, 0) as rev_yoy,
            array(DOUBLE, 0) as profit_yoy,
            array(DOUBLE, 0) as gpr,
            array(DOUBLE, 0) as npr,
            array(INT, 0) as holder_num,
            array(TIMESTAMP, 0) as update_time
        )
        db.createTable(
            table = schemaTB,
            tableName = tbName
        )
        columnComments = dict(STRING, STRING)
        columnComments["trade_date"] = "交易日期"
        columnComments["security_id"] = "TS股票代码"
        columnComments["name"] = "股票名称"
        columnComments["industry"] = "行业"
        columnComments["area_name"] = "地域"
        columnComments["pe"] = "市盈率（动）"
        columnComments["float_share"] = "流通股本（亿）"
        columnComments["total_share"] = "总股本（亿）"
        columnComments["total_assets"] = "总资产（亿）"
        columnComments["liquid_assets"] = "流动资产（亿）"
        columnComments["fixed_assets"] = "固定资产（亿）"
        columnComments["reserved"] = "公积金"
        columnComments["reserved_pershare"] = "每股公积金"
        columnComments["eps"] = "每股收益"
        columnComments["bvps"] = "每股净资产"
        columnComments["pb"] = "市净率"
        columnComments["list_date"] = "上市日期"
        columnComments["undp"] = "未分配利润"
        columnComments["per_undp"] = "每股未分配利润"
        columnComments["rev_yoy"] = "收入同比（%）"
        columnComments["profit_yoy"] = "利润同比（%）"
        columnComments["gpr"] = "毛利率（%）"
        columnComments["npr"] = "净利润率（%）"
        columnComments["holder_num"] = "股东人数"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

