*/
def createPledgeStat(){
    dbName = "dfs://tushare_basic_db"
    tbName = "pledge_stat"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(existsTable(dbName, tbName)){
            print("Table of " + tbName + " already exists, please drop it first!")
            return
        }
        schemaTB = table(
            array(SYMBOL, 0) as security_id,
            array(DATE, 0) as end_date,
            array(INT, 0) as pledge_count,
            array(DOUBLE, 0) as unrest_pledge,
            array(DOUBLE, 0) as rest_pledge,
            array(DOUBLE, 0) as total_share,
            array(DOUBLE, 0) as pledge_ratio,
