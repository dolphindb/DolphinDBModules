            array(DOUBLE, 0) as interval_3,        // 近3月涨幅
            array(DOUBLE, 0) as interval_6,        // 近6月涨幅
            array(TIMESTAMP, 0) as update_time      // 数据更新时间
        )
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = `trade_date
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "股票代码"
