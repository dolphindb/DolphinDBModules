*/
def createStockBakDaily(){
    dbName = "dfs://tushare_daily_db"
    tbName = "stock_bak_daily" 
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as security_id,          // 股票代码
            array(DATE, 0) as trade_date,         // 交易日期
            array(STRING, 0) as name,              // 股票名称
