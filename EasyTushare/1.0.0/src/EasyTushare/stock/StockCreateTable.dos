*/
def createPledgeDetail(){
    dbName = "dfs://tushare_basic_db"
    tbName = "pledge_detail"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(existsTable(dbName, tbName)){
            print("Table of " + tbName + " already exists, please drop it first!")
            return
        }
        schemaTB = table(
            array(SYMBOL, 0) as security_id,
            array(DATE, 0) as ann_date,
            array(STRING, 0) as holder_name,
            array(DOUBLE, 0) as pledge_amount,
            array(DATE, 0) as start_date,
            array(DATE, 0) as end_date,
            array(SYMBOL, 0) as is_release,
            array(DATE, 0) as release_date,
            array(STRING, 0) as pledgor,
            array(DOUBLE, 0) as holding_amount,
            array(DOUBLE, 0) as pledged_amount,
            array(DOUBLE, 0) as p_total_ratio,
            array(DOUBLE, 0) as h_total_ratio,
            array(SYMBOL, 0) as is_buyback,
            array(TIMESTAMP, 0) as update_time
        )
        db.createTable(
            table = schemaTB,
            tableName = tbName
        )
        
