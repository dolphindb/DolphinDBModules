            array(DOUBLE, 0) as float_share,      // 流通股本（万股）
            array(DOUBLE, 0) as free_share,       // 自由流通股本（万）
            array(DOUBLE, 0) as total_mv,         // 总市值（万元）
            array(DOUBLE, 0) as circ_mv,          // 流通市值（万元）
            array(TIMESTAMP, 0) as update_time    // 数据更新时间
        )
        
