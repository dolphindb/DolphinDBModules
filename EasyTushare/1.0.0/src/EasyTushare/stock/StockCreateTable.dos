        columnComments["pe_ttm"] = "市盈率（TTM，亏损的PE为空）"
        columnComments["pb"] = "市净率（总市值/净资产）"
        columnComments["ps"] = "市销率"
        columnComments["ps_ttm"] = "市销率（TTM）"
        columnComments["dv_ratio"] = "股息率（%）"
        columnComments["dv_ttm"] = "股息率（TTM）（%）"
        columnComments["total_share"] = "总股本（万股）"
