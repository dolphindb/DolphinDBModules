        }
    }else{
        db = database(dbName, RANGE, 2000.01.01..(today()+365 * 10))
        createStkSurv()
    }
}

/*
 * @Author: ytxie yating.xie@dolphindb.com
 * @Date: 2026-03-03 12:00:00
 * @LastEditors: ytxie yating.xie@dolphindb.com
 * @LastEditTime: 2026-03-03 12:00:00
 * @Description: TUSHARE-股票数据-特色数据-券商每月荐股-DFS表创建
 */
def createBrokerRecommend(){
    dbName = "dfs://tushare_basic_db"
    tbName = "broker_recommend"
    
    if(existsDatabase(dbName)){
        db = database(dbName)
        
        // 根据 Tushare 券商每月荐股接口定义表结构
        schemaTB = table(
            array(MONTH, 0) as trade_month,           // 月度
            array(SYMBOL, 0) as broker,         // 券商
            array(SYMBOL, 0) as security_id,    // 股票代码 (ts_code)
            array(SYMBOL, 0) as name,           // 股票简称
            array(TIMESTAMP, 0) as update_time  // 更新时间
        )
        
        db.createDimensionTable(
            table = schemaTB,
            tableName = tbName
        )
        
        // 设置字段注释
        columnComments = dict(STRING, STRING)
        columnComments["trade_month"] = "月度"
        columnComments["broker"] = "券商名称"
        columnComments["security_id"] = "股票代码"
        columnComments["name"] = "股票简称"
        columnComments["update_time"] = "更新时间"
        
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("券商每月荐股表 " + tbName + " 创建成功！")
        
    }else{
        // 维度库如果不存在，则创建（这里采用 VALUE 分区或根据实际需求调整）
        db = database(dbName, VALUE, 2010.01M..2030.12M)
        print("数据库 " + dbName + " 已创建！")
        createBrokerRecommend()
    }
}
