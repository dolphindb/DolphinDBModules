// 股票-特色数据-20260306函数

/*
 * @Author: ytxie yating.xie@dolphindb.com
 * @Date: 2026-03-03 12:00:00
 * @LastEditors: ytxie yating.xie@dolphindb.com
 * @LastEditTime: 2026-03-03 12:00:00
 * @Description: TUSHARE-股票数据-参考数据-卖方盈利预测数据-DFS表创建
 */
def createReportRc(){
    dbName = "dfs://tushare_daily_db"
    tbName = "report_rc"
    
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        
        // 严格对应 Tushare report_rc 接口的输出参数
        schemaTB = table(
            array(SYMBOL, 0) as security_id,           // 股票代码 (ts_code)
            array(SYMBOL, 0) as name,           // 股票名称
            array(DATE, 0) as report_date,      // 研报日期
            array(SYMBOL, 0) as report_title,   // 报告标题
            array(SYMBOL, 0) as report_type,    // 报告类型
            array(SYMBOL, 0) as classify,       // 报告分类
            array(SYMBOL, 0) as org_name,       // 机构名称
            array(SYMBOL, 0) as author_name,    // 作者
            array(SYMBOL, 0) as quarter,        // 预测报告期
            array(DOUBLE, 0) as op_rt,          // 预测营业收入（万元）
            array(DOUBLE, 0) as op_pr,          // 预测营业利润（万元）
            array(DOUBLE, 0) as tp,             // 预测利润总额（万元）
            array(DOUBLE, 0) as np,             // 预测净利润（万元）
            array(DOUBLE, 0) as eps,            // 预测每股收益（元）
            array(DOUBLE, 0) as pe,             // 预测市盈率
            array(DOUBLE, 0) as rd,             // 预测股息率
            array(DOUBLE, 0) as roe,            // 预测净资产收益率
            array(DOUBLE, 0) as ev_ebitda,      // 预测EV/EBITDA
            array(SYMBOL, 0) as rating,         // 卖方评级
            array(DOUBLE, 0) as max_price,      // 预测最高目标价
            array(DOUBLE, 0) as min_price,      // 预测最低目标价
            // array(SYMBOL, 0) as imp_dg,         // 机构关注度 // web 里有，但是接口获取回来没有这一列
            array(TIMESTAMP, 0) as update_time  // 更新时间
        )
        
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = `report_date        // 按研报日期分区
        )
        
        // 设置字段注释
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "股票代码"
        columnComments["name"] = "股票名称"
        columnComments["report_date"] = "研报日期"
        columnComments["report_title"] = "报告标题"
        columnComments["report_type"] = "报告类型"
        columnComments["classify"] = "报告分类"
        columnComments["org_name"] = "机构名称"
        columnComments["author_name"] = "作者"
        columnComments["quarter"] = "预测报告期"
        columnComments["op_rt"] = "预测营业收入（万元）"
        columnComments["op_pr"] = "预测营业利润（万元）"
        columnComments["tp"] = "预测利润总额（万元）"
        columnComments["np"] = "预测净利润（万元）"
        columnComments["eps"] = "预测每股收益（元）"
        columnComments["pe"] = "预测市盈率"
        columnComments["rd"] = "预测股息率"
        columnComments["roe"] = "预测净资产收益率"
        columnComments["ev_ebitda"] = "预测EV/EBITDA"
        columnComments["rating"] = "卖方评级"
        columnComments["max_price"] = "预测最高目标价"
        columnComments["min_price"] = "预测最低目标价"
        // columnComments["imp_dg"] = "机构关注度"
        columnComments["update_time"] = "更新时间"
        
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("卖方盈利预测表 " + tbName + " 创建成功！")
        
        }
    }else{
        db = database(dbName, RANGE, 2000.01.01..(today()+365 * 10))
        print("数据库 " + dbName + " 已创建！")
        createReportRc()
    }
}

/*
 * @Author: ytxie yating.xie@dolphindb.com
 * @Date: 2026-03-03 12:00:00
 * @LastEditors: ytxie yating.xie@dolphindb.com
 * @LastEditTime: 2026-03-03 12:00:00
 * @Description: TUSHARE-股票数据-港股数据-AH股比价-DFS表创建
 */
def createStkAhComparison(){
    dbName = "dfs://tushare_daily_db"
    tbName = "stk_ah_comparison"
    
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        
        // 根据Tushare AH股比价接口定义表结构
        schemaTB = table(
            array(SYMBOL, 0) as hk_code,        // 港股股票代码
            array(SYMBOL, 0) as security_id,           // A股股票代码 (ts_code)
            array(DATE, 0) as trade_date,       // 交易日期
            array(SYMBOL, 0) as hk_name,        // 港股股票名称
            array(DOUBLE, 0) as hk_pct_chg,     // 港股股票涨跌幅
            array(DOUBLE, 0) as hk_close,       // 港股股票收盘价
            array(SYMBOL, 0) as name,           // A股股票名称
            array(DOUBLE, 0) as close,          // A股股票收盘价
            array(DOUBLE, 0) as pct_chg,        // A股股票涨跌幅
            array(DOUBLE, 0) as ah_comparison,  // 比价(A/H)
            array(DOUBLE, 0) as ah_premium,     // 溢价(A/H)%
            array(TIMESTAMP, 0) as update_time  // 更新时间
        )
        
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = `trade_date
        )
        
        
        
        // 设置字段注释
        columnComments = dict(STRING, STRING)
        columnComments["hk_code"] = "港股股票代码"
        columnComments["security_id"] = "A股股票代码"
        columnComments["trade_date"] = "交易日期"
        columnComments["hk_name"] = "港股股票名称"
        columnComments["hk_pct_chg"] = "港股股票涨跌幅"
        columnComments["hk_close"] = "港股股票收盘价"
        columnComments["name"] = "A股股票名称"
        columnComments["close"] = "A股股票收盘价"
        columnComments["pct_chg"] = "A股股票涨跌幅"
        columnComments["ah_comparison"] = "比价(A/H)"
        columnComments["ah_premium"] = "溢价(A/H)%"
        columnComments["update_time"] = "更新时间"
        
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("AH股比价表 " + tbName + " 创建成功！")
        
        }
    }else{
        db = database(dbName, RANGE, 2000.01.01..(today()+365 * 10))
        print("数据库 " + dbName + " 已创建！")
        createStkAhComparison()
    }
}

