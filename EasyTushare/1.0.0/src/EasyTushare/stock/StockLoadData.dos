*//*
*  @FunctionName: appendTop10Holders
*  @Brief: Pull tushare api [top10_holders] and append to top10_holders
*  @Param: token, start_date, end_date
*  @Return: appended row count
*  @SampleUsage: appendTop10Holders(token, start_date, end_date)
*/

def appendTop10Holders(token, start_date, end_date){
    // 对于 ts_code 是必选的接口, 先使用 stock_basic 获取数据 ts_code 列表
    // 获取要写入dfs表的信息
    dbName = "dfs://tushare_basic_db"
    tableName = "top10_holders"
    api = "top10_holders"
    pt = loadTable(dbName, tableName)
    days = start_date..end_date
    delete from pt where ann_date in days
    for(one_date in days){ // i = 0
        dateText = temporalFormat(one_date,"yyyyMMdd")
        offset_ = 0 
        prev_count_ = 0
        do {
            res = getApiData(token, api, {"ann_date":dateText,"offset":offset_})
            cur_count_ = res.count()
           
            if(!res.isVoid() and cur_count_ != 0){
                // 类型转换
                replaceColumn!(res, "ann_date", temporalParse(res.ann_date,"yyyyMMdd"))
                replaceColumn!(res, "end_date", temporalParse(res.end_date,"yyyyMMdd"))
                rename!(res, `ts_code, `code)
                // 列顺序重排
                reorderColumns!(res, ["code","ann_date","end_date","holder_name","hold_amount","hold_ratio","hold_float_ratio","hold_change","holder_type"])
                // 记录更新时间
                update res set update_time = now()
                // 追加数据
                pt.append!(res)
                offset_ = prev_count_ + cur_count_ + 1
                prev_count_ = prev_count_ + cur_count_
                print("Success append data for Table " + api + " for date: " + dateText+ ",count:"+cur_count_.string())
            }else {
                break
            }
        } while(true)
        
    }
    print("appendTop10Holders done")
}
