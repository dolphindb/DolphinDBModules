def appendStkAhComparison(token, start_date, end_date){
    dts = getMarketCalendar("XSHG", start_date, end_date)
    dbName = "dfs://tushare_daily_db"
    tbName = "stk_ah_comparison"
    pt = loadTable(dbName, tbName)
    delete from loadTable(dbName, tbName) where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){
        api = "stk_ah_comparison" 
        trade_date_str = dt.format("yyyyMMdd")
        try {
            res = getApiData(token, api, {"trade_date": trade_date_str})
            if(!res.isVoid() and res.rows() > 0){
                // 1. 数据处理：改名、日期转换及类型显式转换
                replaceColumn!(res, "trade_date", temporalParse(res.trade_date, "yyyyMMdd"))
                replaceColumn!(res, "hk_pct_chg", res.hk_pct_chg.double())
                replaceColumn!(res, "hk_close", res.hk_close.double())
                replaceColumn!(res, "close", res.close.double())
                replaceColumn!(res, "pct_chg", res.pct_chg.double())
                replaceColumn!(res, "ah_comparison", res.ah_comparison.double())
                replaceColumn!(res, "ah_premium", res.ah_premium.double())

                // 2. 插入更新时间
                update res set update_time = now()

                // 3. 追加数据
                pt.append!(res)
                print("成功导入AH股比价数据 日期: " + trade_date_str + ", 记录数: " + res.rows().string())
            }
        } catch(ex) {
            print("导入日期 " + trade_date_str + " 时发生错误: " + ex)
        }
    }
}

