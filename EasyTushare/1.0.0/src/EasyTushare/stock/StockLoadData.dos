// 股票月线数据（后复权）导入
/*
*  @FunctionName: appendStockMonthlyBack
*  @Brief: 导入股票月线数据（后复权）
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockMonthlyBack("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockMonthlyBack(token,start_date,end_date){ 
    delete from loadTable("dfs://tushare_daily_db","stock_monthly_back") where trade_date >= start_date and trade_date <= end_date
    // 使用py插件，加载tushare模块
    ts = py::import("tushare")
    py::setGlobalConfig("autoConvert", true);

    // 设置tushare的token
    py::call(ts, "set_token", py::str(token))

    // 初始化 pro 接口
    pro = py::call(ts, "pro_api",py::str(token));

    // 字段
    field_type_mapping = {
        "ts_code": STRING,
        "trade_date": STRING,
        "open": DOUBLE,
        "high": DOUBLE,
        "low": DOUBLE,
        "close": DOUBLE,
        "pre_close": DOUBLE,
        "change": DOUBLE,
        "pct_chg": DOUBLE,
        "vol": DOUBLE,
        "amount": DOUBLE,
        "adj_factor": DOUBLE,
        "ma5": DOUBLE,
        "ma_v_5": DOUBLE,
        "ma20": DOUBLE,
        "ma_v_20": DOUBLE,
        "ma50": DOUBLE,
        "ma_v_50": DOUBLE
    }

    basic = py::call(pro, "stock_basic", ["L,D","ts_code"]);
    allCodes = py::fromPandas(basic);
    codes = allCodes.ts_code

    // 处理时间范围，每个股票20年读取一次
    // start_date = 2000.01.01
    // end_date = 2026.07.22
    days = start_date..end_date
    if (size(days) == 1 and !(isLastTradingDayOfMonth(days[0], "XSHG"))) {
        return 
    }
    yearBeginDays = yearBegin(days).distinct().sort!()
    batchs = size(yearBeginDays)/30
    for (i in 0..batchs){  // i=0
        startIndex = i*30
        endIndex = min((i+1)*30, size(yearBeginDays))
        yearDays = yearBeginDays[startIndex:endIndex]
        start_day = temporalFormat(max(yearDays[0], start_date), "yyyyMMdd")
        end_day = temporalFormat(min(yearEnd(yearDays[size(yearDays)-1]), end_date), "yyyyMMdd")

        for (code in codes) {   // start_day = "20260330"  end_day = "20260330"
            // 获取数据，添加重试逻辑，最多重试10次
            // code = "000001.SZ"
            retry_count = 0
            max_retries = 10
            success = false
            resTemp = NULL
            
            do{
                try {
                    resTemp = py::call(ts, "pro_bar", code,NULL,start_day,end_day,"M","E","","hfq",[5,20,50],["tor","vr"],true);
                    success = true
                } catch(ex) {
                    retry_count = retry_count + 1
                    print("Retry " + retry_count + " failed for code " + code + ": " + ex)
                    if(retry_count >= max_retries) {
                        print("Failed to get data for code " + code + " after " + max_retries + " retries, exiting...")
                        return
                    }
                    sleep(5000)
                }
            } while(retry_count < max_retries and !success) 
    
            try{
                res = py::fromPandas(resTemp,field_type_mapping)
                if(res.count()!=0){
                    replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))

                    res.reorderColumns!(["ts_code", "trade_date", "open", "high", "low", "close", "pre_close", "change", "pct_chg", "vol", "amount", "adj_factor", "ma5", "ma_v_5", "ma20", "ma_v_20", "ma50", "ma_v_50"])

                    update res set update_time = now()
                    loadTable("dfs://tushare_daily_db","stock_monthly_back").append!(res)
                }
            } catch(ex) {
            }
        }
    }
}

// 股票月线数据（前复权）导入
/*
*  @FunctionName: appendStockMonthlyPrev
*  @Brief: 导入股票月线数据（前复权）
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockMonthlyPrev("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockMonthlyPrev(token,start_date1,end_date){ 
    truncate("dfs://tushare_daily_db","stock_monthly_prev")
    // 使用py插件，加载tushare模块
    ts = py::import("tushare")
    py::setGlobalConfig("autoConvert", true);

    // 设置tushare的token
    py::call(ts, "set_token", py::str(token))

    // 初始化 pro 接口
    pro = py::call(ts, "pro_api",py::str(token));

    // 获取股票基本信息，主要是为了获取ts_code
    basic = py::call(pro, "stock_basic", ["L,D","ts_code"]);
    allCodes = py::fromPandas(basic);
    codes = allCodes.ts_code
    
    // // 先获取全市场所有股票
    // allCodes = getApiData(token, "stock_basic", {"list_status": "L"}, ["ts_code"])
    // codes = allCodes.ts_code
    field_type_mapping = {
        "ts_code": STRING,
        "trade_date": STRING,
        "open": DOUBLE,
        "high": DOUBLE,
        "low": DOUBLE,
        "close": DOUBLE,
        "pre_close": DOUBLE,
        "change": DOUBLE,
        "pct_chg": DOUBLE,
        "vol": DOUBLE,
        "amount": DOUBLE,
        "adj_factor": DOUBLE,
        "ma5": DOUBLE,
        "ma_v_5": DOUBLE,
        "ma20": DOUBLE,
        "ma_v_20": DOUBLE,
        "ma50": DOUBLE,
        "ma_v_50": DOUBLE
    }
    // 处理时间范围，每个股票20年读取一次
    start_date = 2000.01.01
    days = start_date..end_date
    if (size(days) == 1 and !(isLastTradingDayOfMonth(days[0], "XSHG"))) {
        return
    }
    yearBeginDays = yearBegin(days).distinct().sort!()
    batchs = size(yearBeginDays)/30
    for (i in 0..batchs){  
        startIndex = i*30
        endIndex = min((i+1)*30, size(yearBeginDays))
        yearDays = yearBeginDays[startIndex:endIndex]
        start_day = temporalFormat(max(yearDays[0], start_date), "yyyyMMdd")
        end_day = temporalFormat(min(yearEnd(yearDays[size(yearDays)-1]), end_date), "yyyyMMdd") 
        for (code in codes) {  
            // 获取数据，添加重试逻辑，最多重试10次
            retry_count = 0
            max_retries = 10
            success = false
            resTemp = NULL
            
            do{
                try {
                    resTemp = py::call(ts, "pro_bar", code,NULL,start_day,end_day,"M","E","","qfq",[5,20,50],["tor","vr"],true);
                    success = true
                } catch(ex) {
                    retry_count = retry_count + 1
                    print("Retry " + retry_count + " failed for code " + code + ": " + ex)
                    if(retry_count >= max_retries) {
                        print("Failed to get data for code " + code + " after " + max_retries + " retries, exiting...")
                        return
                    }
                    sleep(1000)
                }
            } while(retry_count < max_retries and !success) 
    
            try{
                res = py::fromPandas(resTemp,field_type_mapping)
                if(res.count()!=0){
                    replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))

                    res.reorderColumns!(["ts_code", "trade_date", "open", "high", "low", "close", "pre_close", "change", "pct_chg", "vol", "amount", "adj_factor", "ma5", "ma_v_5", "ma20", "ma_v_20", "ma50", "ma_v_50"])

                    update res set update_time = now()
                    print("Successfully imported monthly prev data for code " + code+ " for " + start_day + " to " + end_day)
                    loadTable("dfs://tushare_daily_db","stock_monthly_prev").append!(res)
                }
            }catch(ex){
                // print("Error: " + ex)
            }
        }
    }
}

// 股票周线数据（后复权）导入
/*
*  @FunctionName: appendStockWeeklyBack
*  @Brief: 导入股票周线数据（后复权）
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockWeeklyBack("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockWeeklyBack(token,start_date,end_date){ 
    delete from loadTable("dfs://tushare_daily_db","stock_weekly_back") where trade_date >= start_date and trade_date <= end_date
    // 使用py插件，加载tushare模块
    ts = py::import("tushare")
    py::setGlobalConfig("autoConvert", true);

    // 设置tushare的token
    py::call(ts, "set_token", py::str(token))

    // 初始化 pro 接口
    pro = py::call(ts, "pro_api",py::str(token));

    field_type_mapping = {
        "ts_code": STRING,
        "trade_date": STRING,
        "open": DOUBLE,
        "high": DOUBLE,
        "low": DOUBLE,
        "close": DOUBLE,
        "pre_close": DOUBLE,
        "change": DOUBLE,
        "pct_chg": DOUBLE,
        "vol": DOUBLE,
        "amount": DOUBLE,
        "adj_factor": DOUBLE,
        "ma5": DOUBLE,
        "ma_v_5": DOUBLE,
        "ma20": DOUBLE,
        "ma_v_20": DOUBLE,
        "ma50": DOUBLE,
        "ma_v_50": DOUBLE
    }


    basic = py::call(pro, "stock_basic", ["L,D","ts_code"]);

    allCodes = py::fromPandas(basic);
    codes = allCodes.ts_code

    // 处理时间范围，每个股票20年读取一次
    days = start_date..end_date
    if (size(days) == 1 and !(isLastTradingDayOfWeek(days[0], "XSHG"))) {
        return
    }
    yearBeginDays = yearBegin(days).distinct().sort!()
    batchs = size(yearBeginDays)/30
    for (i in 0..batchs){  
        startIndex = i*30
        endIndex = min((i+1)*30, size(yearBeginDays))
        yearDays = yearBeginDays[startIndex:endIndex]
        start_day = temporalFormat(max(yearDays[0], start_date), "yyyyMMdd")
        end_day = temporalFormat(min(yearEnd(yearDays[size(yearDays)-1]), end_date), "yyyyMMdd")

        for (code in codes) {  
            // 获取数据，添加重试逻辑，最多重试10次
            retry_count = 0
            max_retries = 10
            success = false
            resTemp = NULL
            
            do{
                try {
                    resTemp = py::call(ts, "pro_bar", code,NULL,start_day,end_day,"W","E","","hfq",[5,20,50],["tor","vr"],true);
                    sleep(50)
                    success = true
                } catch(ex) {
                    retry_count = retry_count + 1
                    print("Retry " + retry_count + " failed for code " + code + ": " + ex)
                    if(retry_count >= max_retries) {
                        print("Failed to get data for code " + code + " after " + max_retries + " retries, exiting...")
                        return
                    }
                    sleep(5000)
                }
            } while(retry_count < max_retries and !success) 
    
            try{
                res = py::fromPandas(resTemp,field_type_mapping)
                if(res.count()!=0){
                    replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))

                    res.reorderColumns!(["ts_code", "trade_date", "open", "high", "low", "close", "pre_close", "change", "pct_chg", "vol", "amount", "adj_factor", "ma5", "ma_v_5", "ma20", "ma_v_20", "ma50", "ma_v_50"])

                    update res set update_time = now()
                    print("Successfully imported weekly back data for code " + code+ " for " + start_day + " to " + end_day)
                    loadTable("dfs://tushare_daily_db","stock_weekly_back").append!(res)
                }
            }catch(ex){
                // print("Error: " + ex)
            }
        }
    }
}

