        }
        if(typestr(raw) like "%TABLE%" and raw.size()>0){
            replaceColumn!(raw, "ann_date", temporalParse(raw.ann_date,"yyyyMMdd"))
            replaceColumn!(raw, "end_date", temporalParse(raw.end_date,"yyyyMMdd"))
            replaceColumn!(raw, "holder_num", int(raw.holder_num))
            rename!(raw, `ts_code, `code)
            reorderColumns!(raw, ["code","ann_date","end_date","holder_num"])
            update raw set update_time = now()
            pt.append!(raw)
            n = n + size(raw)
        } else {
            print("no data for "+ p["ann_date"])
        }
    }
    print("appendStkHoldernumber done, appended "+ string(n) + " rows")
}

