/*
*  @FunctionName: appendStkAccount
*  @Brief: Pull tushare api [stk_account] and append to stk_account
*  @Param: token, start_date, end_date
*  @Return: appended row count
*  @SampleUsage: appendStkAccount(token, start_date, end_date)
*/

def appendStkAccount(token, start_date, end_date){
    dbName = "dfs://tushare_basic_db"
    tableName = "stk_account"
    api = "stk_account"
    pt = loadTable(dbName, tableName)
    n = 0
    p = {"start_date":temporalFormat(start_date,"yyyyMMdd"),
        "end_date":temporalFormat(end_date,"yyyyMMdd")}
    delete from pt where date >= start_date and date <= end_date
    print("query stk_account for "+ p["start_date"] + " to " + p["end_date"])
    try{
        raw = getApiData(token, api, p)
    }catch(ex){
        print("appendStkAccount error: failed to get api data for "+ p["start_date"] + " to " + p["end_date"])
        return 
    }
    if(typestr(raw) like "%TABLE%" and raw.size()>0){
        replaceColumn!(raw, "date", temporalParse(raw.date,"yyyyMMdd"))
        replaceColumn!(raw, "weekly_new", double(raw.weekly_new))
        replaceColumn!(raw, "total", double(raw.total))
        replaceColumn!(raw, "weekly_hold", double(raw.weekly_hold))
        replaceColumn!(raw, "weekly_trade", double(raw.weekly_trade))
        reorderColumns!(raw, ["date","weekly_new","total","weekly_hold","weekly_trade"])
        update raw set update_time = now()
        pt.append!(raw)
        n = size(raw)
    } else {
        print("no data for " + p["date"])
    } 

    print("appendStkAccount done, appended "+ string(n) + " rows")
}

