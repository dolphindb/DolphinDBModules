/*
*  @FunctionName: appendStockHsgt
*  @Brief: 追加沪深港股通标的数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockHsgt("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockHsgt(token,start_date,end_date){
    api = "stock_hsgt" 
    types = ["HK_SZ","SZ_HK","HK_SH","SH_HK"]
    delete from loadTable("dfs://tushare_basic_db","stock_hsgt") 
    for(type_ in types){
        // dt = dts[0]
        raw = getApiData(token, api, {"type":type_})

        if(raw.count() != 0){
            res = select ts_code as code, trade_date, type, name, type_name, now() as update_time from raw

            replaceColumn!(res, "code", symbol(string(res.code)))
            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "type", symbol(string(res.type)))
            replaceColumn!(res, "name", string(res.name))
            replaceColumn!(res, "type_name", symbol(string(res.type_name)))

            delete from loadTable("dfs://tushare_basic_db","stock_hsgt") where type == type_
            loadTable("dfs://tushare_basic_db","stock_hsgt").append!(res)
            print("Success append data for type: " + type)
        }
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendStockSt
*  @Brief: 追加股票ST状态数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockSt("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockSt(token,start_date,end_date){
    api = "stock_st" 
    dts = getMarketCalendar("XSHG",start_date,end_date)
    delete from loadTable("dfs://tushare_basic_db","stock_st") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){
        // dt = dts[0]
        raw = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
        if( !raw.isVoid() and raw.count() != 0){

            res = select ts_code as code, name, trade_date, type, type_name, now() as update_time from raw

            replaceColumn!(res, "code", symbol(string(res.code)))
            replaceColumn!(res, "name", string(res.name))
            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "type", symbol(string(res.type)))
            replaceColumn!(res, "type_name", symbol(string(res.type_name)))

            loadTable("dfs://tushare_basic_db","stock_st").append!(res)
            print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
        } else {
            print("No data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

