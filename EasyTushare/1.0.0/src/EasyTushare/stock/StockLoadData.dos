// use tushare
def appendStockSuspend(token,start_date,end_date){ 
    api = "suspend_d" 
    cols = ["trade_date", "ts_code", "suspend_timing", "suspend_type"]
    delete from loadTable("dfs://tushare_daily_db","stock_suspend") where trade_date >= start_date and trade_date <= end_date
    for (oneDate in getMarketCalendar("SSE", start_date, end_date)){  
        trade_date = temporalFormat(oneDate, "yyyyMMdd")

        p = {"trade_date": trade_date} 
    
        // 获取数据
        res = getApiData(token, api, p, cols)
        if (res.count()!=0){
            res.reorderColumns!(["ts_code", "trade_date","suspend_timing", "suspend_type"])
        
            replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))
            
            update res set update_time = now()
            
            loadTable("dfs://tushare_daily_db","stock_suspend").append!(res)
            
            print("Success append data for Table " + api + " for date: " + trade_date)
        } else {
            print("no data for Table " + api + " for date: " + trade_date)
        }
    } 
    print("Success append data for Table " + api)
}


