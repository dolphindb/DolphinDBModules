// 打板专题数据相关函数

/*
*  @FunctionName: appendDcDaily
*  @Brief: 追加东财概念板块行情数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendDcDaily("your_token", 2025.01.01, 2025.02.01)
*/
def appendDcDaily(token, start_date, end_date){
    pt = loadTable("dfs://tushare_daily_db","dc_daily")
    dts = getMarketCalendar("XSHG", start_date, end_date)
    api = "dc_daily" 
    delete from loadTable("dfs://tushare_daily_db","dc_daily") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){
        // 获取数据
        try{
            res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
        }catch(ex){
            print("appendDcDaily error: failed to get api data for "+ dt.temporalFormat("yyyyMMdd"))
            continue
        }
        if(form(res) == 6 and size(res) > 0){
            // 类型转换
            replaceColumn!(res, "trade_date", temporalParse(res.trade_date,"yyyyMMdd"))
            // 列顺序重排（使用原始接口列名 ts_code，顺序与 schemaTB 一致）
            reorderColumns!(res, ["ts_code","trade_date","close","open","high","low","change","pct_change","vol","amount","swing","turnover_rate", "category"])
            // 追加数据（按顺序对应，最后添加 update_time）
            pt.append!(select *, now() as update_time from res)
            print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

