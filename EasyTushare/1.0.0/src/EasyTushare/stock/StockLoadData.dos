// 股票参考数据
/*
*  @FunctionName: appendBlockTrade
*  @Brief: Pull tushare api [block_trade] and append to block_trade
*  @Param: token, start_date, end_date
*  @Return: appended row count
*  @SampleUsage: appendBlockTrade(token, start_date, end_date)
*/

def appendBlockTrade(token, start_date, end_date){
    dbName = "dfs://tushare_basic_db"
    tableName = "block_trade"
    api = "block_trade"
    pt = loadTable(dbName, tableName)
    delete from pt where trade_date >= start_date and trade_date <= end_date

    n = 0
    p = {"trade_date":"20240101"}
    for(dt in start_date..end_date){
        p["trade_date"] = temporalFormat(dt,"yyyyMMdd")
        print("query block_trade for "+ p["trade_date"])
        try{
            raw = getApiData(token, api, p)
        }catch(ex){
            print("appendBlockTrade error: failed to get api data for "+ p["trade_date"])
            continue
        }
        if(typestr(raw) like "%TABLE%" and raw.size()>0){
            replaceColumn!(raw, "trade_date", temporalParse(raw.trade_date,"yyyyMMdd"))
            replaceColumn!(raw, "price", double(raw.price))
            replaceColumn!(raw, "vol", double(raw.vol))
            replaceColumn!(raw, "amount", double(raw.amount))
            replaceColumn!(raw, "buyer", string(raw.buyer))
            replaceColumn!(raw, "seller", string(raw.seller))
            rename!(raw, `ts_code, `security_id)
            reorderColumns!(raw, ["security_id","trade_date","price","vol","amount","buyer","seller"])
            update raw set update_time = now()
            pt.append!(raw)
            n = n + size(raw)
        } else {
            print("no data for "+ p["trade_date"])
        }
    }
    print("appendBlockTrade done, appended "+ string(n) + " rows")
}

