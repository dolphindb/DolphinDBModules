/*
*  @FunctionName: appendDcMember
*  @Brief: 追加东财概念板块成分股数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendDcMember("your_token", 2025.01.01, 2025.02.01)
*/
def appendDcMember(token, start_date, end_date){
    pt = loadTable("dfs://tushare_daily_db","dc_member")
    dts = getMarketCalendar("XSHG", start_date, end_date)
    api = "dc_member"
    delete from loadTable("dfs://tushare_daily_db","dc_member") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){
        offset_ = 0
        prev_count = 0
        cur_count = 0 
        do {
            res = get_api_data(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd"),"offset":offset_})
            cur_count = res.count()
            if(form(res) == 6 and cur_count > 0){
                // 类型转换
                replaceColumn!(res, "trade_date", temporalParse(res.trade_date,"yyyyMMdd"))
                reorderColumns!(res, ["trade_date","ts_code","con_code","name"])
                // 追加数据（按顺序对应，最后添加 update_time）
                pt.append!(select *, now() as update_time from res)
                print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd") + "for count:" + cur_count)

                prev_count = prev_count + cur_count
                offset_ = prev_count + 1
            }
        } while(res.count()!=0)
    }
    print("Success append data for Table " + api)
}

