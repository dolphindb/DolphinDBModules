    for(dt in dts){ // dt = 2026.09.04
        // 获取数据
        try{
            res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
        }catch(ex){
            print("appendKplList error: failed to get api data for "+ dt.temporalFormat("yyyyMMdd"))
            continue
        }
        if(form(res) == 6 and size(res) > 0){
            // 类型转换
            replaceColumn!(res, "trade_date", temporalParse(res.trade_date,"yyyyMMdd"))
            replaceColumn!(res, "lu_time", time(res.lu_time))
            replaceColumn!(res, "ld_time", time(res.ld_time))
            replaceColumn!(res, "open_time", time(res.open_time))
            replaceColumn!(res, "last_time", time(res.last_time))
            // 列顺序重排（使用原始接口列名 ts_code，顺序与 schemaTB 一致）
