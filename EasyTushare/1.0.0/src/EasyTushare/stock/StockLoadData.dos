def appendTdxDaily(token, start_date, end_date){
    pt = loadTable("dfs://tushare_daily_db","tdx_daily")
    dts = getMarketCalendar("XSHG", start_date, end_date)
    cols = ["ts_code","trade_date","close","open","high","low","pre_close","change","pct_change","vol","amount","rise","vol_ratio","turnover_rate","swing","up_num","down_num","limit_up_num","limit_down_num","lu_days","day3","day5","day10","day20","day60","mtd","ytd","year1","pe","pb","float_mv","ab_total_mv","float_share","total_share","bm_buy_net","bm_buy_ratio","bm_net","bm_ratio"]
    api = "tdx_daily"
    delete from loadTable("dfs://tushare_daily_db","tdx_daily") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){
        // 获取数据
        try{
            res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")}, ddbCols=cols)
        }catch(ex){
            print("appendTdxDaily error: failed to get api data for "+ dt.temporalFormat("yyyyMMdd"))
            continue
        }
        if(form(res) == 6 and size(res) > 0){
            // 类型转换
            replaceColumn!(res, "trade_date", temporalParse(res.trade_date,"yyyyMMdd"))
            replaceColumn!(res, "rise", double(res.rise))
            replaceColumn!(res, "up_num", int(res.up_num))
            replaceColumn!(res, "down_num", int(res.down_num))
            replaceColumn!(res, "limit_up_num", int(res.limit_up_num))
            replaceColumn!(res, "limit_down_num", int(res.limit_down_num))
            replaceColumn!(res, "lu_days", int(res.lu_days))
            replaceColumn!(res, "pe", double(res.pe))
            replaceColumn!(res, "pb", double(res.pb))
            // 列顺序重排（使用原始接口列名 ts_code，顺序与 schemaTB 一致）
            reorderColumns!(res, cols)
            // 追加数据（按顺序对应，最后添加 update_time）
            pt.append!(select *, now() as update_time from res)
            print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

