/*
 * @Author: ytxie yating.xie@dolphindb.com
 * @Date: 2026-03-03 12:00:00
 * @LastEditors: ytxie yating.xie@dolphindb.com
 * @LastEditTime: 2026-03-03 12:00:00
 * @Description: TUSHARE-股票数据-特色数据-券商每月荐股-数据导入
 */
def appendBrokerRecommend(token, start_date, end_date){
    // 生成月份序列 (例如 '202101' 到 '202106')
    ms = start_date.month() .. end_date.month()
    
    dbName = "dfs://tushare_basic_db"
    tbName = "broker_recommend"
    pt = loadTable(dbName, tbName)

    for(m in ms){
        delete from loadTable(dbName, tbName) where month = m

         // m = 2026.03M
        api = "broker_recommend" 
        // Tushare 接口要求格式为 YYYYMM
        month_str = m.format("yyyyMM")
        
        try {
            // 获取当月推荐金股
            res = getApiData(token, api, {"month": month_str})
            
            if(!res.isVoid() and res.rows() > 0){
                // 1. 类型显式转换
                // 将 YYYYMM 字符串转换为 DolphinDB 的 MONTH 类型
                replaceColumn!(res, "month", temporalParse(res.month, "yyyyMM"))
                
                // 2. 插入更新时间
                update res set update_time = now()

                current_cnts = exec count(*) from pt where month = m
                if (current_cnts == 0) {
                    // 3. 追加数据
                    pt.append!(res)
                    print("成功导入券商每月荐股数据 月份: " + month_str + ", 记录数: " + res.rows().string())
                } 
                sleep(5000)
            } else {
                print("月份: " + month_str + " 无数据返回。")
            }
        } catch(ex) {
            print("导入月份 " + month_str + " 时发生错误: " + ex)
        }
    }
}

def appendCyqPerf(token, start_date, end_date) {
    // 获取交易日历（以上海证券交易所 XSHG 为准）
    dts = getMarketCalendar("XSHG", start_date, end_date)
    
    dbName = "dfs://tushare_daily_db"
    tbName = "cyq_perf"
    
    // 加载目标分区表
    pt = loadTable(dbName, tbName)
    delete from loadTable(dbName, tbName) where trade_date >= start_date and trade_date <= end_date
    
    for(dt in dts){
        api = "cyq_perf" 
        // 构造 Tushare 参数：日期格式为 yyyyMMdd
        trade_date_str = dt.format("yyyyMMdd")
        
        try {
            // 从 Tushare 获取数据
            res = getApiData(token, api, {"trade_date": trade_date_str})
            
            // 如果当天有数据返回（防止非交易日或数据未更新导致空表错误）
            if(!res.isVoid() and res.rows() > 0){
                // 将字符串日期转换为 DATE 类型
                replaceColumn!(res, "trade_date", temporalParse(res.trade_date, "yyyyMMdd"))
                // 注意：由于之前的建表语句中没有 update_time 字段，
                // 如果您需要记录更新时间，请确保建表时已包含该列。
                // 如果不需要该列，可以注释掉下面这行：
                update res set update_time = now()
                // 将数据追加到分区表中
                pt.append!(res)
                print("成功导入日期: " + trade_date_str + ", 记录数: " + res.rows().string())
            } else {
                print("日期: " + trade_date_str + " 无数据返回。")
            }
        } catch(ex) {
            print("导入日期 " + trade_date_str + " 时发生错误: " + ex)
        }
    }
}

def appendCyqChips(token, start_date, end_date){  // start_date = 2025.03.01, end_date = 2026.01.05
    // 获取交易日历
    dts = getMarketCalendar("XSHG", start_date, end_date)

    // 获取所有标的代码
    ts_codes = getAllCodes(token)
    
    dbName = "dfs://tushare_daily_db"
    tbName = "cyq_chips"
    pt = loadTable(dbName, tbName)
    api = "cyq_chips" 
    delete from loadTable(dbName, tbName) where trade_date >= start_date and trade_date <= end_date
    
    dts = dts.sort!()
    batchs = size(dts)/5

    for (i in 0..batchs){  // i=41
        startIndex = i*5
        endIndex = min((i+1)*5, size(dts))
        fiveDays = dts[startIndex:endIndex]
        start_day = temporalFormat(fiveDays[0], "yyyyMMdd")
        end_day = temporalFormat(fiveDays[size(fiveDays)-1], "yyyyMMdd")

        try {
            cnt = 0
            for (tscode in ts_codes) { // tscode = "600000.SH"
                // 获取数据
                res = getApiData(token, api, {"start_date": start_day, "end_date": end_day, "ts_code": tscode})
                
                if(!res.isVoid() and res.rows() > 0){
                    // 1. 日期格式转换
                    replaceColumn!(res, "trade_date", temporalParse(res.trade_date, "yyyyMMdd"))
                    // 2. 插入更新时间
                    update res set update_time = now()
                    // 3. 写入 DFS 表
                    pt.append!(res)
                    cnt += res.rows()
                } else {
                    print("日期范围: " + start_day + " 至 " + end_day + " 标的：" + tscode + " 无数据返回。")
                }
            }
            print("成功导入日期范围: " + start_day + " 至 " + end_day + ", 记录数: " + cnt)
        } catch(ex) {
            print("导入日期范围 " + start_day + " 至 " + end_day + " 标的：" + tscode + " 时发生错误: " + ex)
        }
    }
}

