/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

// 判断指定日期 d 是否为本周最后一个交易日（A股用 XSHG / XSHE）
def isLastTradingDayOfWeek(d, market="XSHG") {
    // 本周周日（weekEnd 默认 weekday=6 即周日）
    sunday = weekEnd(d)
    monday = sunday - 6
    // 取本周一~周日之间的所有交易日
    cal = getMarketCalendar(market, monday, sunday)
    if (cal.size() == 0) return false
    lastTd = cal[cal.size()-1]   // 本周最后一个交易日
    return d == lastTd
}

def isLastTradingDayOfMonth(d, market="XSHG") {
    mStart = monthStart(d)          // 当月 1 号
    mEnd   = monthEnd(d)            // 当月最后一天（自然日）
    cal    = getMarketCalendar(market, mStart, mEnd)
    if (cal.size() == 0) return false
    return d == cal.last()
}


/*
*  @FunctionName: appendBakBasic
*  @Brief: 追加股票历史基本面数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendBakBasic("your_token", 2025.01.01, 2025.02.01)
*/
def appendBakBasic(token,start_date,end_date){
    api = "bak_basic" 
    dts = getMarketCalendar("XSHG",start_date,end_date)
    for(dt in dts){
        // dt = 2019.12.31
        raw = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
        if(raw.count() != 0){ 
            res = select trade_date, ts_code as code, name, industry, area, pe, float_share, total_share, total_assets, liquid_assets, fixed_assets, reserved, reserved_pershare, eps, bvps, pb, list_date, undp, per_undp, rev_yoy, profit_yoy, gpr, npr, holder_num, now() as update_time from raw

            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "code", symbol(string(res.code)))
            replaceColumn!(res, "name", string(res.name))
            replaceColumn!(res, "industry", symbol(string(res.industry)))
            replaceColumn!(res, "area", symbol(string(res.area)))
            replaceColumn!(res, "pe", double(res.pe))
            replaceColumn!(res, "float_share", double(res.float_share))
            replaceColumn!(res, "total_share", double(res.total_share))
            replaceColumn!(res, "total_assets", double(res.total_assets))
            replaceColumn!(res, "liquid_assets", double(res.liquid_assets))
            replaceColumn!(res, "fixed_assets", double(res.fixed_assets))
            replaceColumn!(res, "reserved", double(res.reserved))
            replaceColumn!(res, "reserved_pershare", double(res.reserved_pershare))
            replaceColumn!(res, "eps", double(res.eps))
            replaceColumn!(res, "bvps", double(res.bvps))
            replaceColumn!(res, "pb", double(res.pb))
            replaceColumn!(res, "list_date", temporalParse(string(res.list_date), "yyyyMMdd"))
            replaceColumn!(res, "undp", double(res.undp))
            replaceColumn!(res, "per_undp", double(res.per_undp))
            replaceColumn!(res, "rev_yoy", double(res.rev_yoy))
            replaceColumn!(res, "profit_yoy", double(res.profit_yoy))
            replaceColumn!(res, "gpr", double(res.gpr))
            replaceColumn!(res, "npr", double(res.npr))
            replaceColumn!(res, "holder_num", int(res.holder_num))

            delete from loadTable("dfs://tushare_basic_db","bak_basic") where trade_date = dt
            loadTable("dfs://tushare_basic_db","bak_basic").append!(res)
            print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendBseMapping
*  @Brief: 追加股票代码映射数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendBseMapping("your_token", 2025.01.01, 2025.02.01)
*/
def appendBseMapping(token, start_date, end_date){
    api = "bse_mapping" 
    dts = getMarketCalendar("XSHG", start_date, end_date)

    res = getApiData(token, api)
    if(res.count() != 0){
        replaceColumn!(res,"list_date",temporalParse(res.list_date,"yyyyMMdd"))

        update res set update_time = now()

        truncate("dfs://tushare_basic_db","bse_mapping") 
        loadTable("dfs://tushare_basic_db","bse_mapping").append!(res) 
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendNamechange
*  @Brief: 追加股票名称变更数据
*  @Param: token - Tushare API令牌 
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendNamechange("your_token", 2025.01.01, 2025.02.01)
*/
def appendNamechange(token,start_date,end_date){
    api = "stock_basic" //接口名称为股票列表
    cols = ["ts_code"]
    // 获取数据
    codes =exec ts_code from getApiData(token, api,{"list_status":"L,D,G,P"}, cols)
    api = "namechange" 
    truncate("dfs://tushare_basic_db","namechange") 
    offset_ = 0
    prev_count_=0
    curr_count = 0
    do {
        res = getApiData(token, api, {"offset":offset_})
        if(!res.isVoid() and res.count() != 0){
            replaceColumn!(res,"start_date",temporalParse(res.start_date,"yyyyMMdd"))
            replaceColumn!(res,"end_date",temporalParse(res.end_date,"yyyyMMdd"))
            replaceColumn!(res,"ann_date",temporalParse(res.ann_date,"yyyyMMdd"))

            update res set update_time = now()

            loadTable("dfs://tushare_basic_db","namechange").append!(res)
            curr_count = res.count()
            prev_count_ = prev_count_ + curr_count
            offset_ = prev_count_ + 1
            print(prev_count_)
        }
    } while(res.count() != 0)
    print("Success append data for Table " + api)   
}

/*
*  @FunctionName: appendNewShare
*  @Brief: 追加新股上市数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendNewShare("your_token", 2025.01.01, 2025.02.01)
*/
def appendNewShare(token,start_date,end_date){ 
    // start_date = 2026.04.21
    // end_date = 2026.04.21
    api = "new_share" 
    dts = getMarketCalendar("XSHG",start_date,end_date)
    delete from loadTable("dfs://tushare_basic_db","new_share") where ipo_date >= start_date and ipo_date <= end_date
    for(dt in dts){
        // dt = 2026.04.21
        raw = getApiData(token, api, {"start_date":dt.temporalFormat("yyyyMMdd"),"end_date":dt.temporalFormat("yyyyMMdd")})

        if(!raw.isVoid() and raw.count() != 0){ 

            res = select ts_code as code, sub_code, name, ipo_date, issue_date, amount, market_amount, price, pe, limit_amount, funds, ballot, now() as update_time from raw
            
            replaceColumn!(res, "code", symbol(string(res.code)))
            replaceColumn!(res, "sub_code", symbol(string(res.sub_code)))
            replaceColumn!(res, "name", string(res.name))
            replaceColumn!(res, "ipo_date", temporalParse(string(res.ipo_date), "yyyyMMdd"))
            replaceColumn!(res, "issue_date", temporalParse(string(res.issue_date), "yyyyMMdd"))
            replaceColumn!(res, "amount", double(res.amount))
            replaceColumn!(res, "market_amount", double(res.market_amount))
            replaceColumn!(res, "price", double(res.price))
            replaceColumn!(res, "pe", double(res.pe))
            replaceColumn!(res, "limit_amount", double(res.limit_amount))
            replaceColumn!(res, "funds", double(res.funds))
            replaceColumn!(res, "ballot", double(res.ballot))

            loadTable("dfs://tushare_basic_db","new_share").append!(res)
            print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
            sleep(500)
        } else {
            print("No data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
            sleep(500)
        }
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendSt
*  @Brief: 追加股票ST状态数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendSt("your_token", 2025.01.01, 2025.02.01)
*/
def appendSt(token,start_date,end_date){
    api = "st" 
    dts = getMarketCalendar("XSHG",start_date,end_date)
    truncate("dfs://tushare_basic_db","st") 
    offset_ = 0
    prev_count_=0
    curr_count = 0
    do {
        res = getApiData(token, api, {"offset":offset_})
        if(!res.isVoid() and res.count() != 0){
            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "name", string(res.name))
            replaceColumn!(res, "pub_date", temporalParse(string(res.pub_date), "yyyyMMdd"))
            replaceColumn!(res, "imp_date", temporalParse(string(res.imp_date), "yyyyMMdd"))
            replaceColumn!(res, "st_type", symbol(string(res.st_type)))
            replaceColumn!(res, "st_reason", string(res.st_reason))
            replaceColumn!(res, "st_explain", string(res.st_explain))
            update res set update_time = now()

            loadTable("dfs://tushare_basic_db","st") .append!(res)
            curr_count = res.count()
            prev_count_ = prev_count_ + curr_count
            offset_ = prev_count_ + 1
        }
    } while(res.count()!=0)
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendStkManagers
*  @Brief: 追加股票管理层数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStkManagers("your_token", 2025.01.01, 2025.02.01)
*/
def appendStkManagers(token,start_date,end_date){
    api = "stk_managers" 
    // dts = getMarketCalendar("XSHG",start_date,end_date)
    cols = ["ts_code", "ann_date", "name", "gender", "lev", "title", "edu", "national", "birthday", "begin_date", "end_date"]
    raw = getApiData(token, api, cols)
    delete from loadTable("dfs://tushare_basic_db","stk_managers") 
    if(raw.count() != 0){ 
        res = select ts_code as code, ann_date, name, gender, lev, title, edu, national, birthday, begin_date, end_date, now() as update_time from raw
        
        replaceColumn!(res, "code", symbol(string(res.code)))
        replaceColumn!(res, "ann_date", temporalParse(string(res.ann_date), "yyyyMMdd"))
        replaceColumn!(res, "name", string(res.name))
        replaceColumn!(res, "gender", symbol(string(res.gender)))
        replaceColumn!(res, "lev", symbol(string(res.lev)))
        replaceColumn!(res, "title", string(res.title))
        replaceColumn!(res, "edu", symbol(string(res.edu)))
        replaceColumn!(res, "national", symbol(string(res.national)))
        replaceColumn!(res, "birthday", temporalParse(iif(strlen(string(res.birthday)) == 4, string(res.birthday) + "01", string(res.birthday)), "yyyyMM"))
        replaceColumn!(res, "begin_date", temporalParse(string(res.begin_date), "yyyyMMdd"))
        replaceColumn!(res, "end_date", temporalParse(string(res.end_date), "yyyyMMdd"))

        //先清空再导入
        truncate("dfs://tushare_basic_db","stk_managers")
        loadTable("dfs://tushare_basic_db","stk_managers").append!(res)
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendStkPremarket
*  @Brief: 追加股票盘前数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStkPremarket("your_token", 2025.01.01, 2025.02.01)
*/
def appendStkPremarket(token,start_date,end_date){
    api = "stk_premarket" 
    dts = getMarketCalendar("XSHG",start_date,end_date)
    delete from loadTable("dfs://tushare_basic_db","stk_premarket") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){
        // dt = dts[0]
        raw = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})

        if(raw.count() != 0){

            res = select trade_date, ts_code as code, total_share, float_share, pre_close, up_limit, down_limit, now() as update_time from raw

            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "code", symbol(string(res.code)))
            replaceColumn!(res, "total_share", double(res.total_share))
            replaceColumn!(res, "float_share", double(res.float_share))
            replaceColumn!(res, "pre_close", double(res.pre_close))
            replaceColumn!(res, "up_limit", double(res.up_limit))
            replaceColumn!(res, "down_limit", double(res.down_limit))


            loadTable("dfs://tushare_basic_db","stk_premarket").append!(res)
            print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendStkRewards
*  @Brief: 追加股票管理层薪酬数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStkRewards("your_token", 2025.01.01, 2025.02.01)
*/
def appendStkRewards(token,start_date1,end_date1){
    api = "stock_basic" //接口名称为股票列表
    cols = ["ts_code"]
    // 获取数据
    codes =exec ts_code from getApiData(token, api, {"list_status":"L,D"}, cols)
    // 2026.07.31 9 all 1,633,120
    delete from loadTable("dfs://tushare_basic_db","stk_rewards") where end_date in start_date1..end_date1
    codes_lists = codes.cut(codes.size()/50)
    for(dt in start_date1..end_date1){
        // dt = 2026.04.21
        dt = dt.temporalFormat("yyyyMMdd")
        for(codes_list in codes_lists){
            // codes_list = codes_lists[0]
            code=codes_list.toStdJson().strReplace("[","").strReplace("]","").strReplace("\"","")
            offset_ = 0
            prev_count_=0
            curr_count = 0
            do {
                api = "stk_rewards"
                cols = ["ts_code", "ann_date", "end_date", "name", "title", "reward", "hold_vol"]
                p = {"ts_code":code,"end_date":dt,"offset":offset_}
                res = getApiData(token, api, p, cols)
                if(!res.isVoid() and res.count() != 0){
                res = select ts_code as code, ann_date, end_date, name, title, reward, hold_vol, now() as update_time from res
            
                replaceColumn!(res, "code", symbol(string(res.code)))
                replaceColumn!(res, "ann_date", temporalParse(string(res.ann_date), "yyyyMMdd"))
                replaceColumn!(res, "end_date", temporalParse(string(res.end_date), "yyyyMMdd"))
                replaceColumn!(res, "name", string(res.name))
                replaceColumn!(res, "title", string(res.title))
                replaceColumn!(res, "reward", double(res.reward))
                replaceColumn!(res, "hold_vol", double(res.hold_vol))

                loadTable("dfs://tushare_basic_db","stk_rewards").append!(res)
                curr_count = res.count()
                prev_count_ = prev_count_ + curr_count
                offset_ = prev_count_ + 1
                print(offset_)
                }
            } while(res.count()!=0)
        }
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendStockBasic
*  @Brief: 追加股票基础信息数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockBasic("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockBasic(token, start_date, end_date){
    api = "stock_basic"
    cols = ["ts_code", "symbol", "name", "area", "industry", "fullname", "enname", "cnspell", "market", "exchange", "curr_type", "list_status", "list_date", "delist_date", "is_hs", "act_name", "act_ent_type"]
    raw = getApiData(token, api,{"list_status":"L,D"} ,cols)
    delete from loadTable("dfs://tushare_basic_db","stock_basic") 
    if(raw.count() != 0){

        res = select ts_code as code, symbol, name, area, industry, fullname, enname, cnspell, market, exchange, curr_type, list_status, list_date, delist_date, is_hs, act_name, act_ent_type, now() as update_time from raw

        replaceColumn!(res, "code", symbol(string(res.code)))
        replaceColumn!(res, "symbol", symbol(string(res.symbol)))
        replaceColumn!(res, "name", string(res.name))
        replaceColumn!(res, "area", symbol(string(res.area)))
        replaceColumn!(res, "industry", symbol(string(res.industry)))
        replaceColumn!(res, "fullname", string(res.fullname))
        replaceColumn!(res, "enname", string(res.enname))
        replaceColumn!(res, "cnspell", string(res.cnspell))
        replaceColumn!(res, "market", symbol(string(res.market)))
        replaceColumn!(res, "exchange", symbol(string(res.exchange)))
        replaceColumn!(res, "curr_type", symbol(string(res.curr_type)))
        replaceColumn!(res, "list_status", symbol(string(res.list_status)))
        replaceColumn!(res, "list_date", temporalParse(string(res.list_date), "yyyyMMdd"))
        replaceColumn!(res, "delist_date", temporalParse(string(res.delist_date), "yyyyMMdd"))
        replaceColumn!(res, "is_hs", symbol(string(res.is_hs)))
        replaceColumn!(res, "act_name", string(res.act_name))
        replaceColumn!(res, "act_ent_type", symbol(string(res.act_ent_type)))

        //先清空再导入
        truncate("dfs://tushare_basic_db","stock_basic")
        loadTable("dfs://tushare_basic_db","stock_basic").append!(res)
    }
    print("Success append data for Table " + api)
}

/*
