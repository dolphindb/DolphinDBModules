/*
*  @FunctionName: appendPledgeDetail
*  @Brief: Pull tushare api [pledge_detail] and append to pledge_detail
*  @Param: token
*  @Return: appended row count
*  @SampleUsage: appendPledgeDetail(token)
*/

def appendPledgeDetail(token,start_date,end_date){
    dbName = "dfs://tushare_basic_db"
    tableName = "pledge_detail"
    api = "pledge_detail"
    pt = loadTable(dbName, tableName)
    delete from pt where ann_date >= start_date and ann_date <= end_date

    for(dt in start_date..end_date){
        // dt = 2026.07.06
        dt = temporalFormat(dt,"yyyyMMdd")
        offset_ = 0
        prev_count_=0
        curr_count = 0
        do {
            raw = getApiData(token, api, {"ann_date": dt, "offset": offset_})
            cur_count_ = raw.count()
            
            if(!raw.isVoid() and cur_count_ != 0){
                replaceColumn!(raw, "ann_date", temporalParse(string(raw.ann_date),"yyyyMMdd"))
                replaceColumn!(raw, "start_date", temporalParse(string(raw.start_date),"yyyyMMdd"))
                replaceColumn!(raw, "end_date", temporalParse(string(raw.end_date),"yyyyMMdd"))
                replaceColumn!(raw, "release_date", temporalParse(string(raw.release_date),"yyyyMMdd"))
                replaceColumn!(raw, "pledgor", string(raw.pledgor))
                replaceColumn!(raw, "is_release", string(raw.is_release))
                replaceColumn!(raw, "is_buyback", string(raw.is_buyback))
                replaceColumn!(raw, "pledge_amount", double(raw.pledge_amount))
                replaceColumn!(raw, "holding_amount", double(raw.holding_amount))
                replaceColumn!(raw, "pledged_amount", double(raw.pledged_amount))
                replaceColumn!(raw, "p_total_ratio", double(raw.p_total_ratio))
                replaceColumn!(raw, "h_total_ratio", double(raw.h_total_ratio))
                rename!(raw, `ts_code, `code)
                reorderColumns!(raw, ["code","ann_date","holder_name","pledge_amount","start_date","end_date","is_release","release_date","pledgor","holding_amount","pledged_amount","p_total_ratio","h_total_ratio","is_buyback"])
                update raw set update_time = now()
                pt.append!(raw)
                offset_ = prev_count_ + cur_count_ + 1
                prev_count_ = prev_count_ + cur_count_
                sleep(100)
            }else {
                break
            }
        } while(true)
        print("Success append data for Table " + api +  ",dt:"+dt.string())
    }

}

