    delete from loadTable("dfs://tushare_daily_db","stock_bak_daily") where trade_date >= start_date and trade_date <= end_date
    for (oneDate in getMarketCalendar("SSE", start_date, end_date)){  
        trade_date = temporalFormat(oneDate, "yyyyMMdd")

        p = {"trade_date": trade_date} 
    
        // 获取数据
        try{
            res = getApiData(token, api, p, cols)
            if(res.count()!=0){
            replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))
        
            update res set update_time = now()
            
            loadTable("dfs://tushare_daily_db","stock_bak_daily").append!(res)
            }
        }catch(ex){
            print("no data for date: " + trade_date)
        }
    } 
    print("Success append data for Table " + api)
}


// 股票日线数据（前复权）导入
/*
*  @FunctionName: appendStockDailyPrev
*  @Brief: 导入股票日线数据（后复权）
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockDailyPrev("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockDailyPrev(token,start_date1,end_date){ 

    truncate("dfs://tushare_daily_db","stock_daily_prev")
    // 使用py插件，加载tushare模块
    ts = py::import("tushare")
    py::setGlobalConfig("autoConvert", true);

    // 设置tushare的token
    py::call(ts, "set_token", py::str(token))

    // 初始化 pro 接口
    pro = py::call(ts, "pro_api",py::str(token));

    field_type_mapping = {
        "ts_code": STRING,
        "trade_date": STRING,
        "open": DOUBLE,
        "high": DOUBLE,
        "low": DOUBLE,
        "close": DOUBLE,
        "pre_close": DOUBLE,
        "change": DOUBLE,
        "pct_chg": DOUBLE,
        "vol": DOUBLE,
        "amount": DOUBLE,
        "turnover_rate": DOUBLE,
        "volume_ratio": DOUBLE,
        "adj_factor": DOUBLE,
        "ma5": DOUBLE,
        "ma_v_5": DOUBLE,
        "ma20": DOUBLE,
        "ma_v_20": DOUBLE,
        "ma50": DOUBLE,
        "ma_v_50": DOUBLE
    }

    basic = py::call(pro, "stock_basic", ["L,D","ts_code"]);
    allCodes = py::fromPandas(basic);
    codes = allCodes.ts_code
    
    // 处理时间范围，每个股票20年读取一次
    start_date = 2000.01.01
    days = start_date..end_date
    yearBeginDays = yearBegin(days).distinct().sort!()
    batchs = size(yearBeginDays)/20
    for (i in 0..batchs){  // i = 0
        startIndex = i*20
        endIndex = min((i+1)*20, size(yearBeginDays))
        yearDays = yearBeginDays[startIndex:endIndex]
        start_day = temporalFormat(max(yearDays[0], start_date), "yyyyMMdd")
        end_day = temporalFormat(min(yearEnd(yearDays[size(yearDays)-1]), end_date), "yyyyMMdd")

        for (code in codes) {  // code = "600508.SH"
           // 获取数据，添加重试逻辑，最多重试10次
            retry_count = 0
            max_retries = 10
            success = false
            resTemp = NULL
            // start_day = "20260610"
            // end_day = "20260610"
            do{
                try {
                    resTemp = py::call(ts, "pro_bar", code,NULL,start_day,end_day,"D","E","","qfq",[5,20,50],["tor","vr"],true);
                    success = true
                } catch(ex) {
                    retry_count = retry_count + 1
                    print("Retry " + retry_count + " failed for code " + code + ": " + ex)
                    if(retry_count >= max_retries) {
                        print("Failed to get data for code " + code + " after " + max_retries + " retries, exiting...")
                        return
                    }
                    sleep(5000)
                }
            } while(retry_count < max_retries and !success) 
    
            try{
                res = py::fromPandas(resTemp,field_type_mapping)
                if(res.count()!=0){
                    replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))

                    res.reorderColumns!(["ts_code", "trade_date", "open", "high", "low", "close", "pre_close", "change", "pct_chg", "vol", "amount", "turnover_rate", "volume_ratio", "adj_factor", "ma5", "ma_v_5", "ma20", "ma_v_20", "ma50", "ma_v_50"])

                    update res set update_time = now()

                    print("Successfully imported daily prev data for code " + code+ " for " + start_day + " to " + end_day)
                    loadTable("dfs://tushare_daily_db","stock_daily_prev").append!(res)
                }
            }catch(ex) {}
        }
    }
}

// 股票日线数据（后复权）导入
/*
*  @FunctionName: appendStockDailyBack
*  @Brief: 导入股票日线数据（前复权）
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockDailyBack("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockDailyBack(token,start_date,end_date){ 
   
    // 使用py插件，加载tushare模块
    ts = py::import("tushare")
    py::setGlobalConfig("autoConvert", true);

    // 设置tushare的token
    py::call(ts, "set_token", py::str(token))

    pro = py::call(ts, "pro_api",py::str(token));

    // 获取股票基本信息，主要是为了获取ts_code
    basic = py::call(pro, "stock_basic", ["L,D","ts_code"]);
    allCodes = py::fromPandas(basic);
    codes = allCodes.ts_code
    delete from loadTable("dfs://tushare_daily_db","stock_daily_back") where trade_date >= start_date and trade_date <= end_date

    field_type_mapping = {
        "ts_code": STRING,
        "trade_date": STRING,
        "open": DOUBLE,
        "high": DOUBLE,
        "low": DOUBLE,
        "close": DOUBLE,
        "pre_close": DOUBLE,
        "change": DOUBLE,
        "pct_chg": DOUBLE,
        "vol": DOUBLE,
        "amount": DOUBLE,
        "turnover_rate": DOUBLE,
        "volume_ratio": DOUBLE,
        "adj_factor": DOUBLE,
        "ma5": DOUBLE,
        "ma_v_5": DOUBLE,
        "ma20": DOUBLE,
        "ma_v_20": DOUBLE,
        "ma50": DOUBLE,
        "ma_v_50": DOUBLE
    }

    // 处理时间范围，每个股票20年读取一次
    // start_date = 2026.03.10
    // end_date = 2026.03.10
    // days = 2026.03.10..2026.03.10
    days = start_date..end_date
    yearBeginDays = yearBegin(days).distinct().sort!()
    batchs = size(yearBeginDays)/20
    for (i in 0..batchs){   // i=0
        startIndex = i*20
        endIndex = min((i+1)*20, size(yearBeginDays))
        yearDays = yearBeginDays[startIndex:endIndex]
        start_day = temporalFormat(max(yearDays[0], start_date), "yyyyMMdd")
        end_day = temporalFormat(min(yearEnd(yearDays[size(yearDays)-1]), end_date), "yyyyMMdd")

        for (code in codes) {  
            // 获取数据，添加重试逻辑，最多重试10次
            retry_count = 0
            max_retries = 10
            success = false
            resTemp = NULL
            
            do{
                try {
                    resTemp = py::call(ts, "pro_bar", code,NULL,start_day,end_day,"D","E","","hfq",[5,20,50],["tor","vr"],true);
                    success = true
                } catch(ex) {
                    retry_count = retry_count + 1
                    print("Retry " + retry_count + " failed for code " + code + ": " + ex)
                    if(retry_count >= max_retries) {
                        print("Failed to get data for code " + code + " after " + max_retries + " retries, exiting...")
                        return
                    }
                    sleep(1000)
                }
            } while(retry_count < max_retries and !success) 
    
            try{
                res = py::fromPandas(resTemp,field_type_mapping)
                if(res.count()!=0){
                    replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))

                    res.reorderColumns!(["ts_code", "trade_date", "open", "high", "low", "close", "pre_close", "change", "pct_chg", "vol", "amount", "turnover_rate", "volume_ratio", "adj_factor", "ma5", "ma_v_5", "ma20", "ma_v_20", "ma50", "ma_v_50"])

                    update res set update_time = now()
                    print("Successfully imported daily back data for code " + code+ " for " + start_day + " to " + end_day)
                    loadTable("dfs://tushare_daily_db","stock_daily_back").append!(res)
                }
            }catch(ex) {}
        }
    }
}

// 股票港股通每日成交数据导入
/*
*  @FunctionName: appendStockGgtDaily
*  @Brief: 导入股票港股通每日成交统计数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockGgtDaily("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockGgtDaily(token,start_date,end_date){ 
    api = "ggt_daily" 
    cols = ["trade_date", "buy_amount", "buy_volume", "sell_amount", "sell_volume"]
    delete from loadTable("dfs://tushare_daily_db","stock_ggt_daily") where trade_date >= start_date and trade_date <= end_date

    days = start_date..end_date
    // days = 2026.03.10..2026.03.10
    yearBeginDays = yearBegin(days).distinct().sort!()
    len = size(yearBeginDays)
    for (i in 0..(len-1)) { // i=26
        start_day = temporalFormat(max(yearBeginDays[i], start_date), "yyyyMMdd")
        end_day = temporalFormat(min(yearEnd(yearBeginDays[i]), end_date), "yyyyMMdd")

        p = {"start_date": start_day, "end_date": end_day} 
        // 获取数据
        res = getApiData(token, api, p, cols)
        if(res.count()!=0){
            res.reorderColumns!(cols)
            
            replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))
            update res set update_time = now()
            loadTable("dfs://tushare_daily_db","stock_ggt_daily").append!(res)
            print("Successfully imported ggt daily data from " + start_day + " to " + end_day)
        }
    }  
    
    print("Success append data for Table " + api)
}

// 股票港股通月度成交数据导入
/*
*  @FunctionName: appendStockGgtMonthly
*  @Brief: 导入股票港股通每月成交统计数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockGgtMonthly("your_token", 2025.01.01, 2025.02.01)
*/
/** 
    建议每次全量导入，不建议增量导入 
    直接传入日期 2000.01.01 到 today()
*/
def appendStockGgtMonthly(token,start_date,end_date){ 
    api = "ggt_monthly" 
    cols = ["month", "day_buy_amt", "day_buy_vol", "day_sell_amt", "day_sell_vol","total_buy_amt", "total_buy_vol", "total_sell_amt", "total_sell_vol"]

    // start_date = 2026.01.10
    // end_date = 2026.03.10
    days = start_date..end_date
    yearBeginDays = yearBegin(days).distinct().sort!()
    delete from loadTable("dfs://tushare_daily_db","stock_ggt_monthly") where trade_date >= start_date and trade_date <= end_date
    for (oneDate in yearBeginDays){  // oneDate = 2026.01.01
        start_day = temporalFormat(max(month(oneDate), month(start_date)), "yyyyMM")
        end_day = temporalFormat(min(month(yearEnd(oneDate)), month(end_date)), "yyyyMM")
        if (end_date < monthEnd(end_date)) {
            end_day = temporalFormat(min(month(yearEnd(oneDate)), month(end_date)-1), "yyyyMM")
        }
        start_time = start_day
        end_time = end_day 

        if (start_time <= end_time) {
            p = {"start_month": start_time, "end_month": end_time} 

        try {
            res = getApiData(token, api, p, cols)
            if(res.count()!=0){
                replaceColumn!(res,"month",temporalParse(res.month,"yyyyMM"))
            
                update res set update_time = now()
                
                loadTable("dfs://tushare_daily_db","stock_ggt_monthly").append!(res)
                print("Successfully imported ggt monthly data from " + start_time + " to " + end_time)
                }
            } catch(ex) {
                print("no data for period: " + start_time + " to " + end_time)
            }
        }  
    }  
    print("Success append data for Table " + api)
}

