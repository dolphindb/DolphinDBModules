*  @SampleUsage: appendShareFloat(token, start_date, end_date)
*/

def appendShareFloat(token, start_date, end_date){
    dbName = "dfs://tushare_basic_db"
    tableName = "share_float"
    api = "share_float"
    pt = loadTable(dbName, tableName)

    n = 0
    p = {"ann_date":"20240101"}
    delete from pt where ann_date >= start_date and ann_date <= end_date
    for(dt in start_date..end_date){
        p["ann_date"] = temporalFormat(dt,"yyyyMMdd")
        print("query share_float for "+ p["ann_date"])
        try{
            raw = getApiData(token, api, p)
        }catch(ex){
            print("appendShareFloat error: failed to get api data for "+ p["ann_date"])
            continue
        }
        if(typestr(raw) like "%TABLE%" and raw.size()>0){
            replaceColumn!(raw, "ann_date", temporalParse(raw.ann_date,"yyyyMMdd"))
            replaceColumn!(raw, "float_date", temporalParse(raw.float_date,"yyyyMMdd"))
            replaceColumn!(raw, "float_share", double(raw.float_share))
            replaceColumn!(raw, "float_ratio", double(raw.float_ratio))
            replaceColumn!(raw, "holder_name", string(raw.holder_name))
            replaceColumn!(raw, "share_type", symbol(raw.share_type))
            rename!(raw, `ts_code, `code)
            reorderColumns!(raw, ["code","ann_date","float_date","float_share","float_ratio","holder_name","share_type"])
            update raw set update_time = now()
            pt.append!(raw)
            n = n + size(raw)
        } else {
            print("no data for " + p["ann_date"])
        }
    }
    print("appendShareFloat done, appended "+ string(n) + " rows")
}

