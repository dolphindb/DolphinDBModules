 * @Date: 2026-03-03 12:00:00
 * @LastEditors: ytxie yating.xie@dolphindb.com
 * @LastEditTime: 2026-03-03 12:00:00
 * @Description: TUSHARE-股票数据-参考数据-卖方盈利预测数据-数据导入
 */
def appendReportRc(token, start_date, end_date){
    // 获取交易日历
    dts = start_date..end_date
    
    dbName = "dfs://tushare_daily_db"
    tbName = "report_rc"
    pt = loadTable(dbName, tbName)
    delete from loadTable(dbName, tbName) where report_date >= start_date and report_date <= end_date
    for(dt in dts){
        api = "report_rc" 
        trade_date_str = dt.format("yyyyMMdd")
        
        try {
            // report_rc 接口支持按报告日期直接查询当日所有研报
            res = getApiData(token, api, {"report_date": trade_date_str})
            
            if(!res.isVoid() and res.rows() > 0){
                // 1. 显式类型转换
                replaceColumn!(res, "report_date", temporalParse(res.report_date, "yyyyMMdd"))
                
                // 2. 插入更新时间
                update res set update_time = now()

                // 3. 追加数据
                pt.append!(res)
                print("成功导入卖方盈利预测数据 日期: " + trade_date_str + ", 记录数: " + res.rows().string())
            }
        } catch(ex) {
            print("导入日期 " + trade_date_str + " 时发生错误: " + ex)
        }
    }
}

