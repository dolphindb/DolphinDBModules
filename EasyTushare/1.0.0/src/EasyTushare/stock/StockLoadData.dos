// 股票1分钟K线数据导入
/*
*  @FunctionName: appendStock1minK
*  @Brief: 导入股票1分钟K线数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStock1minK("your_token", 2025.01.01, 2025.02.01)
*/
def appendStock1minK(token,start_date,end_date) { // start_date = 2026.01.01, end_date = 2026.03.02
    api = "stk_mins" 
    cols = []

    // 先获取全市场所有股票
    allCodes = getApiData(token, "stock_basic", {"list_status": "L,D"}, ["ts_code"])
    codes = allCodes.ts_code

    // 处理时间范围，每个股票一个月读取一次
    days = getMarketCalendar("XSHG",start_date, end_date)
    // days = 2009.01.01..end_date // 从2009年1月1日开始导入
    // days = 2026.03.10..2026.03.10 // 从2009年1月1日开始导入
    delete from loadTable("dfs://tushare_minute_db","stock_1min_k") where date(trade_time) >= start_date and date(trade_time) <= end_date
    for (one_day in days) { // i=0
        start_day = temporalFormat(one_day, "yyyy-MM-dd")
        end_day = temporalFormat(one_day, "yyyy-MM-dd")
        start_time = start_day + " 09:00:00"
        end_time = end_day + " 19:00:00"

        codes_batchs = codes.cut(29)
        for (one_batch in codes_batchs) { // code = "000001.SZ,000002.SZ"
            codebath_str = one_batch.concat(",")
            p = {"ts_code": codebath_str, "freq":"1min", "start_date": start_time, "end_date": end_time}
    
            // 获取数据
            res = getApiData(token, api, p, cols)
            if(res.count()!=0){
                replaceColumn!(res,"trade_time",timestamp(res.trade_time))
                res = select 
                        ts_code, 
                        trade_time,
                        open, 
                        high, 
                        low, 
                        close,
                        vol, 
                        amount
                    from res
                update res set update_time = now()
                loadTable("dfs://tushare_minute_db","stock_1min_k").append!(res)
                print("Successfully imported 1min K data for stock " + codebath_str + " from " + start_day + " to " + end_day)
                sleep(250)
            }
        }
    } 
    print("Success append data for Table " + api)
}

