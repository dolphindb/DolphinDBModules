/*
*  @FunctionName: appendStkHoldertrade
*  @Brief: Pull tushare api [stk_holdertrade] and append to stk_holdertrade
*  @Param: token, start_date, end_date
*  @Return: appended row count
*  @SampleUsage: appendStkHoldertrade(token, start_date, end_date)
*/

def appendStkHoldertrade(token, start_date, end_date){
    dbName = "dfs://tushare_basic_db"
    tableName = "stk_holdertrade"
    api = "stk_holdertrade"
    pt = loadTable(dbName, tableName)
    
    n = 0
    p = {"ann_date":"20240101"}
    cols = ["ts_code","ann_date","holder_name","holder_type","in_de","change_vol","change_ratio","after_share","after_ratio","avg_price","total_share","begin_date","close_date"]
    delete from pt where ann_date >= start_date and ann_date <= end_date
    for(dt in start_date..end_date){    // dt = 2024.01.02
        p["ann_date"] = temporalFormat(dt,"yyyyMMdd")
        print("query stk_holdertrade for "+ p["ann_date"])
        try{
            raw = getApiData(token, api, p, cols)
        }catch(ex){
            print("appendStkHoldertrade error: failed to get api data for "+ p["ann_date"])
            continue
        }
        if(typestr(raw) like "%TABLE%" and raw.size()>0){
            replaceColumn!(raw, "ann_date", temporalParse(raw.ann_date,"yyyyMMdd"))
            replaceColumn!(raw, "holder_type", symbol(raw.holder_type))
            replaceColumn!(raw, "in_de", symbol(raw.in_de))
            replaceColumn!(raw, "change_vol", double(raw.change_vol))
            replaceColumn!(raw, "change_ratio", double(raw.change_ratio))
            replaceColumn!(raw, "after_share", double(raw.after_share))
            replaceColumn!(raw, "after_ratio", double(raw.after_ratio))
            replaceColumn!(raw, "avg_price", double(raw.avg_price))
            replaceColumn!(raw, "total_share", double(raw.total_share))
            replaceColumn!(raw, "begin_date", temporalParse(string(raw.begin_date),"yyyyMMdd"))
            replaceColumn!(raw, "close_date", temporalParse(string(raw.close_date),"yyyyMMdd"))
            rename!(raw, `ts_code, `code)
            reorderColumns!(raw, ["code","ann_date","holder_name","holder_type","in_de","change_vol","change_ratio","after_share","after_ratio","avg_price","total_share","begin_date","close_date"])
            update raw set update_time = now()
            pt.append!(raw)
            n = n + size(raw)
        } else {
            print("no data for " + p["ann_date"])
        }
    }
    print("appendStkHoldertrade done, appended "+ string(n) + " rows")
}

