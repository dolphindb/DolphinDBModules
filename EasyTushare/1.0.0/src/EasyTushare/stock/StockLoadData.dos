*/
/*
*  @FunctionName: appendPledgeStat
*  @Brief: Pull tushare api [pledge_stat] and append to pledge_stat
*  @Param: token, start_date, end_date
*  @Return: appended row count
*  @SampleUsage: appendPledgeStat(token, start_date, end_date)
*/

def appendPledgeStat(token, start_date, end_date){
    // 获取要写入dfs表的信息
    dbName = "dfs://tushare_basic_db"
    tableName = "pledge_stat"
    api = "pledge_stat"
    pt = loadTable(dbName, tableName)
    // 遍历日期, 调用 pledge_stat 接口获取数据
    n = 0
    p = {"end_date":"20260306"}
    days = start_date..end_date
    delete from pt where end_date in days
    for(dt in days){      // dt = 2026.07.24
        p["end_date"] = temporalFormat(dt,"yyyyMMdd")
        print("query pledge_stat for "+ p["end_date"])
        try{
            raw = getApiData(token, api, p)
        }catch(ex){
            print("appendTop10Floatholders error: failed to get api data for "+ p["ts_code"])
            continue
        }
        if(typestr(raw) like "%TABLE%" and raw.size()>0){
            n = n + size(raw)
            // 类型转换
            replaceColumn!(raw, "end_date", temporalParse(raw.end_date,"yyyyMMdd"))
            replaceColumn!(raw, "pledge_count", int(raw.pledge_count))
            rename!(raw, `ts_code, `code)
            // 列顺序重排
            reorderColumns!(raw, ["code","end_date", "pledge_count", "unrest_pledge", "rest_pledge", "total_share", "pledge_ratio"])
            // 记录更新时间
            update raw set update_time = now()
            // 追加数据
            pt.append!(raw)
        } else {
            print("no data for " + p["end_date"])
        }
    }
    print("appendPledgeStat done, appended "+ string(n) + " rows")
}

