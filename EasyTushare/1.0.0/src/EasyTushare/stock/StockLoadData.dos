def appendStockGgtTop10(token,start_date,end_date){ 
    api = "ggt_top10" 
    cols = ["trade_date", "ts_code", "name", "close", "p_change", "rank", "market_type", "amount", "net_amount", "sh_amount", "sh_net_amount", "sh_buy", "sh_sell", "sz_amount", "sz_net_amount", "sz_buy", "sz_sell"]
    
    delete from loadTable("dfs://tushare_daily_db","stock_ggt_top10") where trade_date >= start_date and trade_date <= end_date
    for (oneDate in getMarketCalendar("SSE", start_date, end_date)){  
        trade_date = temporalFormat(oneDate, "yyyyMMdd")

        p = {"trade_date": trade_date} 
    
        // 获取数据
        res = getApiData(token, api, p, cols)
        if(res.count()!=0){
