*  @Return: None
*  @SampleUsage: appendMoneyflowIndDc("your_token", 2025.01.01, 2025.02.01)
*/
def appendMoneyflowIndDc(token,start_date,end_date){
    dts = getMarketCalendar("XSHG",start_date,end_date)
    api = "moneyflow_ind_dc" 
    delete from loadTable("dfs://tushare_daily_db","moneyflow_ind_dc") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){//dt = dts[0]
        // 获取数据
        try{
            res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
        }catch(ex){
            print(ex)
        }
        
        if(res.count() != 0){
            replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))
            replaceColumn!(res,"rank",int(res.rank))
            update res set update_time = now()
        
            loadTable("dfs://tushare_daily_db","moneyflow_ind_dc").append!(res)
            print("Success append data for Table " + api + " for date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

