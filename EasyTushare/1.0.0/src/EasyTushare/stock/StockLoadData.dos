def appendStockFinaAudit(token, start_date, end_date){
    api = "fina_audit"
    cols = ["ts_code","ann_date","end_date","audit_result","audit_fees","audit_agency","audit_sign"]
    //按股票代码循环
    codes = getApiData(token, "stock_basic", {"list_status":"L,D"}, ["ts_code"])
    codes = codes.ts_code
    // 先清空再全量导入 
    truncate("dfs://tushare_basic_db","stock_fina_audit")
    for(code in codes){
        // code = codes[0]
        p = {"ts_code" : code}
        //获取数据
        res = getApiData(token, api, p, cols)
        if (!res.isVoid() and res.rows() > 0) {
            res.rename!(`ts_code, `security_id)
            //数据预处理
            res.replaceColumn!("ann_date", temporalParse(res.ann_date,"yyyyMMdd"))
            res.replaceColumn!("end_date", temporalParse(res.end_date,"yyyyMMdd"))
            update res set update_time = now()
            
            res.reorderColumns!(loadTable("dfs://tushare_basic_db","stock_fina_audit").columnNames())

            loadTable("dfs://tushare_basic_db","stock_fina_audit").append!(res)
            print("Success append data for Table " + api + " for code: " + code)
        } else {
            print("标的：" + code + " 无数据返回。")
        }
    }
    print("Success append data for Table " + api)
}

