def appendStockDividend(token, start_date, end_date){
    api = "dividend"
    cols = ["ts_code","end_date","ann_date","div_proc","stk_div","stk_bo_rate","stk_co_rate","cash_div","cash_div_tax","record_date","ex_date","pay_date","div_listdate","imp_ann_date","base_date","base_share"]
    
    pos_start = yearBegin(start_date)-1
    pos_end = yearEnd(end_date)

    delete from loadTable("dfs://tushare_basic_db","stock_dividend") where end_date >= pos_start and end_date <= pos_end 

    for(dt in pos_start..pos_end){
        dt = temporalFormat(dt, "yyyyMMdd")
        offset_ = 0
        prev_count_=0
        curr_count = 0
        do {
            res = getApiData(token, api, {"end_date" : dt,"offset":offset_},cols)
            if(res.count() != 0){
                res.rename!(`ts_code,`security_id)
                //数据预处理
                res.replaceColumn!("ann_date", temporalParse(res.ann_date.string(),"yyyyMMdd"))
                res.replaceColumn!("end_date", temporalParse(res.end_date.string(),"yyyyMMdd"))
                res.replaceColumn!("record_date", temporalParse(res.record_date.string(),"yyyyMMdd"))
                res.replaceColumn!("ex_date", temporalParse(res.ex_date.string(),"yyyyMMdd"))
                res.replaceColumn!("pay_date", temporalParse(res.pay_date.string(),"yyyyMMdd"))
                res.replaceColumn!("div_listdate", temporalParse(res.div_listdate.string(),"yyyyMMdd"))
                res.replaceColumn!("imp_ann_date", temporalParse(res.imp_ann_date.string(),"yyyyMMdd"))
                res.replaceColumn!("base_date", temporalParse(res.base_date.string(),"yyyyMMdd"))
                update res set update_time = now()

                res.reorderColumns!(loadTable("dfs://tushare_basic_db","stock_dividend").columnNames())
                loadTable("dfs://tushare_basic_db","stock_dividend").append!(res)
                curr_count = res.count()
                prev_count_ = prev_count_ + curr_count
                offset_ = prev_count_ + 1
            }
        } while(res.count()!=0)
    }
}

