/*
 * @Author: DolphinDB Yanyan Xu
 * @Date: 2026-03-04
 * @LastEditors: DolphinDB Yanyan Xu
 * @LastEditTime: 2026-03-05
 * @Description: tushare 股票数据-财务数据-主营业务构成数据导入
 */
def appendStockFinaMainbz(token, start_date, end_date){
    api = "fina_mainbz_vip"
    cols = ["ts_code","end_date","bz_item","bz_code","bz_sales","bz_profit","bz_cost","curr_type","update_flag"]
    //季度报告，每个季度获取一次
    days = temporalAdd(start_date,-6,"M")..end_date
    quarters = quarterEnd(days).distinct()
    // quarters = quarters.at(quarters<=end_date)
    delete from loadTable("dfs://tushare_basic_db","stock_fina_mainbz") where end_date in quarters
    for(quarter in quarters){
        types = ["P","D","I"]
        for(type in types){
            // quarter = quarters[3]
            // type = types[2]
            report_period = temporalFormat(quarter, "yyyyMMdd")
            offset_ = 0
            prev_count_=0
            curr_count = 0
            do {
                res = getApiData(token, api, {"period" : report_period,"type":type,"offset":offset_},cols)
                if(res.count() != 0){
                    res.rename!(`ts_code,`security_id)
                    //数据预处理
                    res.replaceColumn!("end_date", temporalParse(res.end_date,"yyyyMMdd"))
                    update res set update_time = now()

                    res.reorderColumns!(loadTable("dfs://tushare_basic_db","stock_fina_mainbz").columnNames())

                    loadTable("dfs://tushare_basic_db","stock_fina_mainbz").append!(res)
                    curr_count = res.count()
                    prev_count_ = prev_count_ + curr_count
                    offset_ = prev_count_ + 1
                }
            } while(res.count()!=0)
        }
    }
}


def appendStockForecast(token, start_date, end_date){
    api = "forecast_vip"

    //季度报告，每个季度获取一次
    days = start_date..end_date
    delete from loadTable("dfs://tushare_basic_db","stock_forecast") where ann_date in days
    for(one_date in days){
        //quarter = 2003.03.31
        daystr = temporalFormat(one_date, "yyyyMMdd")
        p = {"ann_date" : daystr}
        //获取数据
        res = getApiData(token, api, p)
        if (!res.isVoid() and res.count() != 0){
            res.rename!(`ts_code,`security_id)
            //数据预处理
            res.replaceColumn!("ann_date", temporalParse(res.ann_date,"yyyyMMdd"))
            res.replaceColumn!("end_date", temporalParse(res.end_date,"yyyyMMdd"))
            res.replaceColumn!("first_ann_date", temporalParse(res.first_ann_date,"yyyyMMdd"))
            res.replaceColumn!("change_reason", string(res.change_reason))
            update res set update_time = now()
            
            res.reorderColumns!(loadTable("dfs://tushare_basic_db","stock_forecast").columnNames())

            loadTable("dfs://tushare_basic_db","stock_forecast").append!(res)
            print("Success append data for Table " + api + " for date: " + daystr)
        } else {
            print("No data for Table " + api + " for date: " + daystr)
        }
    }
}


def appendStockIncome(token, start_date, end_date){
    api = "income_vip"
    supple_cols = ["ts_code", "net_after_nr_lp_correct", "credit_impa_loss", "net_expo_hedging_benefits", "oth_impair_loss_assets", "total_opcost", "amodcost_fin_assets", "oth_income", "asset_disp_income", "continued_net_profit", "end_net_profit"]

    days = start_date..end_date
    delete from loadTable("dfs://tushare_basic_db","stock_income") where ann_date in days
    for(one_date in days){
        day_str = temporalFormat(one_date, "yyyyMMdd")
        p = {"ann_date" : day_str}
        // 获取数据
        res = getApiData(token, api, p)
        if (!res.isVoid() and res.count() != 0) {
            res.rename!(`ts_code,`security_id)
            supple_res = getApiData(token, api, p, supple_cols)
            res = res.join(supple_res)
            //数据预处理
            res.replaceColumn!("ann_date", temporalParse(res.ann_date,"yyyyMMdd"))
            res.replaceColumn!("f_ann_date", temporalParse(res.f_ann_date,"yyyyMMdd"))
            res.replaceColumn!("end_date", temporalParse(res.end_date,"yyyyMMdd"))
            update res set update_time = now()
            res.dropColumns!(`ts_code)
            
            res.reorderColumns!(loadTable("dfs://tushare_basic_db","stock_income").columnNames())
            loadTable("dfs://tushare_basic_db","stock_income").append!(res)
            print("Success append data for Table " + api + " for date: " + day_str)
        } else {
            print("No data for Table " + api + " for date: " + day_str)
        }
    }
}

// 资金流向数据相关函数

/*
*  @FunctionName: appendMoneyflow
*  @Brief: 追加个股资金流向数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendMoneyflow("your_token", 2025.01.01, 2025.02.01)
*/
def appendMoneyflow(token,start_date,end_date){
    dts = getMarketCalendar("XSHG",start_date,end_date)
    api = "moneyflow" 
    delete from loadTable("dfs://tushare_daily_db","moneyflow") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){//dt = 2012.09.21
        
        // 获取数据
        try{
            res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
        }catch(ex){
            print(ex)
        }
        
        if(res.count() != 0){
            replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))
            replaceColumn!(res,"buy_sm_vol",long(res.buy_sm_vol))
            replaceColumn!(res,"sell_sm_vol",long(res.sell_sm_vol))
            replaceColumn!(res,"buy_md_vol",long(res.buy_md_vol))
            replaceColumn!(res,"sell_md_vol",long(res.sell_md_vol))
            replaceColumn!(res,"buy_lg_vol",long(res.buy_lg_vol))
            replaceColumn!(res,"sell_lg_vol",long(res.sell_lg_vol))
            replaceColumn!(res,"buy_elg_vol",long(res.buy_elg_vol))
            replaceColumn!(res,"sell_elg_vol",long(res.sell_elg_vol))
            replaceColumn!(res,"net_mf_vol",long(res.net_mf_vol))

            update res set update_time = now()
        
            loadTable("dfs://tushare_daily_db","moneyflow").append!(res)
            print("Success append data for Table " + api + " for date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

