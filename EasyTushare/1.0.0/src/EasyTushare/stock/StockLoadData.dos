    pt = loadTable("dfs://tushare_daily_db","ths_hot")
    dts = getMarketCalendar("XSHG", start_date, end_date)
    //getMarketCalendar("XSHG", 2023.08.18, end_date)
    api = "ths_hot"
    delete from loadTable("dfs://tushare_daily_db","ths_hot") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){ // dt = 2023.08.21
        // 获取数据
        try{ 
            res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
            // select * from res where trade_date = "20230821"
        }catch(ex){
            print("appendThsHot error: failed to get api data for "+ dt.temporalFormat("yyyyMMdd"))
            continue
        }
        if(form(res) == 6 and size(res) > 0){
            // 类型转换
            replaceColumn!(res, "trade_date", temporalParse(trim(res.trade_date),"yyyyMMdd"))
            replaceColumn!(res, "rank", int(res.rank))
            replaceColumn!(res, "concept", string(res.concept))
            replaceColumn!(res, "rank_reason", string(res.rank_reason))
            replaceColumn!(res, "hot", string(res.hot))
            replaceColumn!(res, "rank_time", timestamp(res.rank_time))
            // 列顺序重排（使用原始接口列名，顺序与 schemaTB 一致）
            reorderColumns!(res, ["trade_date","data_type", "ts_code","ts_name","rank","pct_change","current_price","concept","rank_reason","hot","rank_time"])
            // 追加数据（按顺序对应，最后添加 update_time）
            update res set update_time = now()
            pt.append!(res)
            print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
        } else {
            print("no data for "+ dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

