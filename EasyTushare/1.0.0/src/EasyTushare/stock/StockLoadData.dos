def appendHmList(token, start_date, end_date){
    pt = loadTable("dfs://tushare_basic_db","hm_list")
    api = "hm_list" 
    // 获取数据（静态数据，一次性获取全部）
    res = getApiData(token, api, {})
    if(form(res) == 6 and size(res) > 0){
        // 列顺序重排（使用原始接口列名，顺序与 schemaTB 一致）
        reorderColumns!(res, ["name","desc","orgs"])
        // 追加数据（按顺序对应，最后添加 update_time）

        // 由于数据量较小，且无日期字段，直接删除后全量追加
        truncate("dfs://tushare_basic_db","hm_list")
        pt.append!(select *, now() as update_time from res)
        print("Success append data for Table " + api)
    }
}

