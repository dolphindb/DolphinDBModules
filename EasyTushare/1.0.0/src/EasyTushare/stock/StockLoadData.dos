// 股票周线数据导入
/*
*  @FunctionName: appendStockWeekly
*  @Brief: 导入股票周线数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendStockWeekly("your_token", 2025.01.01, 2025.02.01)
*/
def appendStockWeekly(token,start_date,end_date){ 
    api = "weekly" 
    cols = []
    delete from loadTable("dfs://tushare_daily_db","stock_weekly") where trade_date >= start_date and trade_date <= end_date
    for (oneDate in getMarketCalendar("SSE", start_date, end_date)){  

        if (!isLastTradingDayOfWeek(oneDate, market="XSHG")) {
            continue
        }
        trade_date = temporalFormat(oneDate, "yyyyMMdd")

        p = {"trade_date": trade_date} 
        
        try {
            // 获取数据
            res = getApiData(token, api, p, cols)
            if(res.count()!=0){
                replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))
            
                update res set update_time = now()
                
                loadTable("dfs://tushare_daily_db","stock_weekly").append!(res)
                print("Successfully imported weekly data for date " + trade_date)
            }
        } catch(ex) {
            if (ex[1].endsWith("X can't be an empty tuple.")) {
                print("No data returned for date " + trade_date + ", skipping.")
            }
        }  
    } 
    print("Success append data for Table " + api)
}

