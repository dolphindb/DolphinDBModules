/*
*  @FunctionName: appendLimitListD
*  @Brief: 追加每日涨停股票列表数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendLimitListD("your_token", 2025.01.01, 2025.02.01)
*/
def appendLimitListD(token, start_date, end_date){
    pt = loadTable("dfs://tushare_daily_db","limit_list_d")
    dts = getMarketCalendar("XSHG", start_date, end_date)
    api = "limit_list_d"
    delete from loadTable("dfs://tushare_daily_db","limit_list_d") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){
        // 获取数据
        try{
            res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
        }catch(ex){
            print("appendLimitListD error: failed to get api data for "+ dt.temporalFormat("yyyyMMdd"))
            continue
        }
        if(form(res) == 6 and size(res) > 0){
            reorderColumns!(res, ["trade_date","ts_code","industry","name","close","pct_chg","amount","limit_amount","float_mv","total_mv","turnover_ratio","fd_amount","first_time","last_time","open_times","up_stat","limit_times","limit"])
            replaceColumn!(res, "trade_date", temporalParse(res.trade_date,"yyyyMMdd"))
            replaceColumn!(res, "open_times", res.open_times.int())
            replaceColumn!(res, "limit_times", res.limit_times.int())
            replaceColumn!(res, "first_time", iif(res.first_time.isNull(), time(NULL), temporalParse(lpad(res.first_time,6,"0"),"HHmmss").time()))
            replaceColumn!(res, "last_time", iif(res.last_time.isNull(), time(NULL), temporalParse(lpad(res.last_time,6,"0"),"HHmmss").time()))
            pt.append!(select *, now() as update_time from res)
            print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendLimitListThs
*  @Brief: 追加同花顺涨跌停池数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendLimitListThs("your_token", 2025.01.01, 2025.02.01)
*/
def appendLimitListThs(token, start_date, end_date){
    pt = loadTable("dfs://tushare_daily_db","limit_list_ths")
    dts = getMarketCalendar("XSHG", start_date, end_date)
    api = "limit_list_ths"
    delete from loadTable("dfs://tushare_daily_db","limit_list_ths") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){
        for(lt in ['涨停池','连扳池','冲刺涨停','炸板池','跌停池']){ 
            // lt = '冲刺涨停'
            // 获取数据
            try{
                res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd"), limit_type:lt})
            }catch(ex){
                print("appendLimitListThs error: failed to get api data for "+ dt.temporalFormat("yyyyMMdd") + " with limit_type " + lt)
                continue
            }
            if(form(res) == 6 and size(res) > 0){
                // 类型转换
                reorderColumns!(res, ["trade_date","ts_code","name","price","pct_chg","open_num","lu_desc","limit_type","tag","status","limit_order","limit_amount","turnover_rate","free_float","lu_limit_order","limit_up_suc_rate","turnover","market_type"])
                replaceColumn!(res, "trade_date", temporalParse(res.trade_date,"yyyyMMdd"))
                replaceColumn!(res, "open_num", res.open_num.int())
                replaceColumn!(res, "lu_desc", res.lu_desc.string())
                replaceColumn!(res, "tag", res.tag.string())
                replaceColumn!(res, "status", res.status.string())
                pt.append!(select *, now() as update_time from res)
                print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd") + " with limit_type " + lt)
            }
        }
    }
    print("Success append data for Table " + api)
}

