/*
*  @FunctionName: appendMoneyflowHsgt
*  @Brief: 追加沪深港通资金流向数据
*  @Param: token - Tushare API令牌 token = 
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendMoneyflowHsgt("your_token", 2025.01.01, 2025.02.01)
*/
// use tushare
def appendMoneyflowHsgt(token,start_date,end_date){ //start_date = 2025.01.01, end_date =2025.02.01
    dts = getMarketCalendar("XSHG",start_date,end_date)
    api = "moneyflow_hsgt"
    delete from loadTable("dfs://tushare_daily_db","moneyflow_hsgt") where trade_date >= start_date and trade_date <= end_date
    for(dt in dts){//dt = 2018.01.25
        // 获取数据
        try{
            res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
        }catch(ex){
            print(ex)
        }
        
        if(res.count() != 0){
            replaceColumn!(res,"trade_date",temporalParse(res.trade_date,"yyyyMMdd"))
            update res set update_time = now()

            str_ght = string(res.hgt)
            str_north_money = string(res.north_money)
            str_sgt = string(res.sgt)
            str_ggt_ss = string(res.ggt_ss)
            str_south_money = string(res.south_money)
            str_ggt_sz = string(res.ggt_sz)
            
            replaceColumn!(res,"hgt",double(iif(like(str_ght,"%M%"),str_ght.substr(0,str_ght.strlen()-1),str_ght)))
            replaceColumn!(res,"north_money",double(iif(like(str_north_money,"%M%"),str_north_money.substr(0,str_north_money.strlen()-1),str_north_money)))
            replaceColumn!(res,"sgt",double(iif(like(str_sgt,"%M%"),str_sgt.substr(0,str_sgt.strlen()-1),str_sgt)))
            replaceColumn!(res,"ggt_ss",double(iif(like(str_ggt_ss,"%M%"),str_ggt_ss.substr(0,str_ggt_ss.strlen()-1),str_ggt_ss)))
            replaceColumn!(res,"south_money",double(iif(like(str_south_money,"%M%"),str_south_money.substr(0,str_south_money.strlen()-1),str_south_money)))
            replaceColumn!(res,"ggt_sz",double(iif(like(str_ggt_sz,"%M%"),str_ggt_sz.substr(0,str_ggt_sz.strlen()-1),str_ggt_sz)))

            loadTable("dfs://tushare_daily_db","moneyflow_hsgt").append!(res)
            print("Success append data for Table " + api + " for date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendMoneyflowIndDc
*  @Brief: 追加东方财富概念及行业板块资金流向数据
*  @Param: token - Tushare API令牌
