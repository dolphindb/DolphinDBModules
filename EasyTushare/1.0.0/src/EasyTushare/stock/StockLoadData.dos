    for(dt in dts){
        // 获取数据
        try{
            res = getApiData(token, api, {"trade_date":dt.temporalFormat("yyyyMMdd")})
        }catch(ex){
            print("appendTopList error: failed to get api data for "+ dt.temporalFormat("yyyyMMdd"))
            continue
        }
        if(res.count() != 0){
            reorderColumns!(res, ["trade_date","ts_code","name","close","pct_change","turnover_rate","amount","l_sell","l_buy","l_amount","net_amount","net_rate","amount_rate","float_values","reason"])
            replaceColumn!(res, "trade_date", temporalParse(res.trade_date,"yyyyMMdd"))
            pt.append!(select *, now() as update_time from res)
            print("Success append data for trade_date: " + dt.temporalFormat("yyyyMMdd"))
        }
    }
    print("Success append data for Table " + api)
}

// 股票-特色数据-20260306相关函数
def getAllCodes(token) {
    api = "stock_basic" //接口名称为股票列表
    p = {"list_status": "L,D"} 
    cols = ["ts_code"]
    // 获取数据
    res = getApiData(token, api, p, cols) 
    return res.ts_code
}

