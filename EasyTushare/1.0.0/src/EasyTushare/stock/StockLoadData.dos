        try{
            raw = getApiData(token, api, p)
        }catch(ex){
            print("appendRepurchase error: failed to get api data for "+ p["ann_date"])
            continue
        }
        if(typestr(raw) like "%TABLE%" and raw.size()>0){
            replaceColumn!(raw, "ann_date", temporalParse(raw.ann_date,"yyyyMMdd"))
            replaceColumn!(raw, "end_date", temporalParse(string(raw.end_date),"yyyyMMdd"))
            replaceColumn!(raw, "exp_date", temporalParse(string(raw.exp_date),"yyyyMMdd"))
            replaceColumn!(raw, "proc", symbol(raw.proc))
            replaceColumn!(raw, "vol", double(raw.vol))
            replaceColumn!(raw, "amount", double(raw.amount))
            replaceColumn!(raw, "high_limit", double(raw.high_limit))
            replaceColumn!(raw, "low_limit", double(raw.low_limit))
            rename!(raw, `ts_code, `code)
            reorderColumns!(raw, ["code","ann_date","end_date","proc","exp_date","vol","amount","high_limit","low_limit"])
            update raw set update_time = now()
            pt.append!(raw)
            n = n + size(raw)
        } else {
            print("no data for " + p["ann_date"])
        }
    }
    print("appendRepurchase done, appended "+ string(n) + " rows")
}

