// 财务数据相关函数
def appendStockBalancesheet(token, start_date, end_date){
    api = "balancesheet_vip"
    supple_cols = ["ts_code", "oth_eq_invest", "oth_illiq_fin_assets", "oth_eq_ppbond", "receiv_financing", "use_right_assets", "lease_liab"]

    days = start_date..end_date
    delete from loadTable("dfs://tushare_basic_db","stock_balancesheet") where ann_date in days

    for(one_date in days){ // one_date = 2026.07.16
        //quarter = quarters[0]
        daystr = temporalFormat(one_date, "yyyyMMdd")
        p = {"ann_date" : daystr}
        //获取数据
        res = getApiData(token, api, p)
        if(res.count() != 0){
            res.rename!(`ts_code,`security_id)
            supple_res = getApiData(token, api, p, supple_cols)
            res = res.join(supple_res)
            //数据预处理
            res.replaceColumn!("ann_date", temporalParse(res.ann_date,"yyyyMMdd"))
            res.replaceColumn!("f_ann_date", temporalParse(res.f_ann_date,"yyyyMMdd"))
            res.replaceColumn!("end_date", temporalParse(res.end_date,"yyyyMMdd"))
            res.replaceColumn!("end_type", string(res.end_type))
            res.replaceColumn!("security_id", symbol(res.security_id))
            update res set update_time = now()
            res.dropColumns!(`ts_code)
            // res.rename!(`ts_code,`security_id)
            
            res.reorderColumns!(loadTable("dfs://tushare_basic_db","stock_balancesheet").columnNames())

            loadTable("dfs://tushare_basic_db","stock_balancesheet").append!(res)
            print("Success append data for Table " + api + " for date: " + daystr)
        }
    }
}

def appendStockCashflow(token, start_date, end_date){
    api = "cashflow_vip"

    days = start_date..end_date
    delete from loadTable("dfs://tushare_basic_db","stock_cashflow") where ann_date in days
    for(one_date in days){ // one_date = 2026.08.03 
        daystr = temporalFormat(one_date,"yyyyMMdd")
        p = {"ann_date":daystr }
        //获取数据
        res = getApiData(token, api, p)
        cur_count_ = res.count()
        // select * from res where ts_code = "600941.SH" 
        if(!res.isVoid() and cur_count_ != 0){
            res.rename!(`ts_code,`security_id)
            //数据预处理
            res.replaceColumn!("ann_date", temporalParse(res.ann_date,"yyyyMMdd"))
            res.replaceColumn!("f_ann_date", temporalParse(res.f_ann_date,"yyyyMMdd"))
            res.replaceColumn!("end_date", temporalParse(res.end_date,"yyyyMMdd"))
            update res set update_time = now()
            
            res.reorderColumns!(loadTable("dfs://tushare_basic_db","stock_cashflow").columnNames())

            loadTable("dfs://tushare_basic_db","stock_cashflow").append!(res)
            print("Success append data for Table " + api + " for date: " + daystr+ ",count:"+cur_count_.string())    
        }
    }
}

