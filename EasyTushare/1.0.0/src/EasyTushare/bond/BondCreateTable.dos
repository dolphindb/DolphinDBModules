/**
*  @FunctionName: createRepoDaily
*  @Brief: Create a DFS table for repo_daily
*  @Param: None
*  @Return: None
*  @SampleUsage: createRepoDaily()
*/
def createRepoDaily(){
    dbName = "dfs://tushare_daily_db"
    tbName = "repo_daily"
    
    if(existsDatabase(dbName)){
        db = database(dbName)

        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as security_id,
            array(DATE, 0) as trade_date,
            array(SYMBOL, 0) as repo_maturity,
            array(DOUBLE, 0) as pre_close,
            array(DOUBLE, 0) as open,
            array(DOUBLE, 0) as high,
            array(DOUBLE, 0) as low,
            array(DOUBLE, 0) as close,
            array(DOUBLE, 0) as weight,
            array(DOUBLE, 0) as weight_r,
            array(DOUBLE, 0) as amount,
            array(INT, 0) as num,
            array(TIMESTAMP, 0) as update_time
        )
        
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns=`trade_date
        )
    
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "TS代码"
        columnComments["trade_date"] = "交易日期"
        columnComments["repo_maturity"] = "期限品种"
        columnComments["pre_close"] = "前收盘(%)"
        columnComments["open"] = "开盘价(%)"
        columnComments["high"] = "最高价(%)"
        columnComments["low"] = "最低价(%)"
        columnComments["close"] = "收盘价(%)"
        columnComments["weight"] = "加权价(%)"
        columnComments["weight_r"] = "加权价(利率债)(%)"
        columnComments["amount"] = "成交金额(万元)"
        columnComments["num"] = "成交笔数(笔)"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table " + tbName + " created successfully!")
    }
    } else {
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}


/**
*  @FunctionName: createYcCb
*  @Brief: Create a DFS table for yc_cb
*  @Param: None
*  @Return: None
*  @SampleUsage: createYcCb()
*/
def createYcCb(){
    dbName = "dfs://tushare_daily_db"
    tbName = "yc_cb"
    
    if(existsDatabase(dbName)){
        db = database(dbName)

        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(DATE, 0) as trade_date,
            array(SYMBOL, 0) as security_id,
            array(STRING, 0) as curve_name,
            array(SYMBOL, 0) as curve_type,
            array(DOUBLE, 0) as curve_term,
            array(DOUBLE, 0) as yield,
            array(TIMESTAMP, 0) as update_time
        )
        
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns=`trade_date
        )
    
        columnComments = dict(STRING, STRING)
        columnComments["trade_date"] = "交易日期"
        columnComments["security_id"] = "曲线编码"
        columnComments["curve_name"] = "曲线名称"
        columnComments["curve_type"] = "曲线类型：0-到期，1-即期"
        columnComments["curve_term"] = "期限(年)"
        columnComments["yield"] = "收益率(%)"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table " + tbName + " created successfully!")
    }
    } else {
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}
