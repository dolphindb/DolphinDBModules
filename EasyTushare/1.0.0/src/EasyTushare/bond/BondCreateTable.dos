/**
*  @FunctionName: createCbIssue
*  @Brief: Create a DFS table for cb_issue
*  @Param: None
*  @Return: None
*  @SampleUsage: createCbIssue()
*/
def createCbIssue(){
    dbName = "dfs://tushare_basic_db"
    tbName = "cb_issue"
    
    if(existsDatabase(dbName)){
        db = database(dbName)

        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as security_id,
            array(DATE, 0) as ann_date,
            array(DATE, 0) as res_ann_date,
            array(DOUBLE, 0) as plan_issue_size,
            array(DOUBLE, 0) as issue_size,
            array(DOUBLE, 0) as issue_price,
            array(SYMBOL, 0) as issue_type,
            array(DOUBLE, 0) as issue_cost,
            array(SYMBOL, 0) as onl_code,
            array(STRING, 0) as onl_name,
            array(DATE, 0) as onl_date,
            array(DOUBLE, 0) as onl_size,
            array(DOUBLE, 0) as onl_pch_vol,
            array(INT, 0) as onl_pch_num,
            array(DOUBLE, 0) as onl_pch_excess,
            array(DOUBLE, 0) as onl_winning_rate,
            array(SYMBOL, 0) as shd_ration_code,
            array(STRING, 0) as shd_ration_name,
            array(DATE, 0) as shd_ration_date,
            array(DATE, 0) as shd_ration_record_date,
            array(DATE, 0) as shd_ration_pay_date,
            array(DOUBLE, 0) as shd_ration_price,
            array(DOUBLE, 0) as shd_ration_ratio,
            array(DOUBLE, 0) as shd_ration_size,
            array(DOUBLE, 0) as shd_ration_vol,
            array(INT, 0) as shd_ration_num,
            array(DOUBLE, 0) as shd_ration_excess,
            array(DOUBLE, 0) as offl_size,
            array(DOUBLE, 0) as offl_deposit,
            array(DOUBLE, 0) as offl_pch_vol,
            array(INT, 0) as offl_pch_num,
            array(DOUBLE, 0) as offl_pch_excess,
            array(DOUBLE, 0) as offl_winning_rate,
            array(STRING, 0) as lead_underwriter,
            array(DOUBLE, 0) as lead_underwriter_vol,
            array(TIMESTAMP, 0) as update_time
        )
        
        db.createTable(
            table = schemaTB,
            tableName = tbName
        )
    
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "转债代码"
        columnComments["ann_date"] = "发行公告日"
        columnComments["res_ann_date"] = "发行结果公告日"
        columnComments["plan_issue_size"] = "计划发行总额（元）"
        columnComments["issue_size"] = "发行总额（元）"
        columnComments["issue_price"] = "发行价格"
        columnComments["issue_type"] = "发行方式"
        columnComments["issue_cost"] = "发行费用（元）"
        columnComments["onl_code"] = "网上申购代码"
        columnComments["onl_name"] = "网上申购简称"
        columnComments["onl_date"] = "网上发行日期"
        columnComments["onl_size"] = "网上发行总额（张）"
        columnComments["onl_pch_vol"] = "网上发行有效申购数量（张）"
        columnComments["onl_pch_num"] = "网上发行有效申购户数"
        columnComments["onl_pch_excess"] = "网上发行超额认购倍数"
        columnComments["onl_winning_rate"] = "网上发行中签率（%）"
        columnComments["shd_ration_code"] = "老股东配售代码"
        columnComments["shd_ration_name"] = "老股东配售简称"
        columnComments["shd_ration_date"] = "老股东配售日"
        columnComments["shd_ration_record_date"] = "老股东配售股权登记日"
        columnComments["shd_ration_pay_date"] = "老股东配售缴款日"
        columnComments["shd_ration_price"] = "老股东配售价格"
        columnComments["shd_ration_ratio"] = "老股东配售比例"
        columnComments["shd_ration_size"] = "老股东配售数量（张）"
        columnComments["shd_ration_vol"] = "老股东配售有效申购数量（张）"
        columnComments["shd_ration_num"] = "老股东配售有效申购户数"
        columnComments["shd_ration_excess"] = "老股东配售超额认购倍数"
        columnComments["offl_size"] = "网下发行总额（张）"
        columnComments["offl_deposit"] = "网下发行定金比例（%）"
        columnComments["offl_pch_vol"] = "网下发行有效申购数量（张）"
        columnComments["offl_pch_num"] = "网下发行有效申购户数"
        columnComments["offl_pch_excess"] = "网下发行超额认购倍数"
        columnComments["offl_winning_rate"] = "网下发行中签率"
        columnComments["lead_underwriter"] = "主承销商"
        columnComments["lead_underwriter_vol"] = "主承销商包销数量（张）"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table " + tbName + " created successfully!")
    }
    } else {
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}


