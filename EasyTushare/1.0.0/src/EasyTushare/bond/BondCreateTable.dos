/**
*  @FunctionName: createCbShare
*  @Brief: Create a DFS table for cb_share
*  @Param: None
*  @Return: None
*  @SampleUsage: createCbShare()
*/
def createCbShare(){
    dbName = "dfs://tushare_daily_db"
    tbName = "cb_share"
    
    if(existsDatabase(dbName)){
        db = database(dbName)

        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as security_id,
            array(STRING, 0) as bond_short_name,
            array(DATE, 0) as publish_date,
            array(DATE, 0) as end_date,
            array(DOUBLE, 0) as issue_size,
            array(DOUBLE, 0) as convert_price_initial,
            array(DOUBLE, 0) as convert_price,
            array(DOUBLE, 0) as convert_val,
            array(DOUBLE, 0) as convert_vol,
            array(DOUBLE, 0) as convert_ratio,
            array(DOUBLE, 0) as acc_convert_val,
            array(DOUBLE, 0) as acc_convert_vol,
            array(DOUBLE, 0) as acc_convert_ratio,
            array(DOUBLE, 0) as remain_size,
            array(DOUBLE, 0) as total_shares,
            array(TIMESTAMP, 0) as update_time
        )
        
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns=`publish_date
        )
    
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "债券代码"
        columnComments["bond_short_name"] = "债券简称"
        columnComments["publish_date"] = "公告日期"
        columnComments["end_date"] = "统计截止日期"
        columnComments["issue_size"] = "可转债发行总额"
        columnComments["convert_price_initial"] = "初始转换价格"
        columnComments["convert_price"] = "本次转换价格"
        columnComments["convert_val"] = "本次转股金额"
        columnComments["convert_vol"] = "本次转股数量"
        columnComments["convert_ratio"] = "本次转股比例"
        columnComments["acc_convert_val"] = "累计转股金额"
        columnComments["acc_convert_vol"] = "累计转股数量"
        columnComments["acc_convert_ratio"] = "累计转股比例"
        columnComments["remain_size"] = "可转债剩余金额"
        columnComments["total_shares"] = "转股后总股本"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table " + tbName + " created successfully!")
    }
    } else {
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

