/**
*  @FunctionName: createBcBestotcqt
*  @Brief: Create a DFS table for bc_bestotcqt
*  @Param: None
*  @Return: None
*  @SampleUsage: createBcBestotcqt()
*/
def createBcBestotcqt(){
    dbName = "dfs://tushare_daily_db"
    tbName = "bc_bestotcqt"
    
    if(existsDatabase(dbName)){
        db = database(dbName)

        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(DATE, 0) as trade_date,
            array(SYMBOL, 0) as security_id,
            array(STRING, 0) as name,
            array(STRING, 0) as remain_maturity,
            array(SYMBOL, 0) as bond_type,
            array(SYMBOL, 0) as best_buy_bank,
            array(DOUBLE, 0) as best_buy_yield,
            array(DOUBLE, 0) as best_buy_price,
            array(SYMBOL, 0) as best_sell_bank,
            array(DOUBLE, 0) as best_sell_yield,
            array(DOUBLE, 0) as best_sell_price,
            array(TIMESTAMP, 0) as update_time
        )
        
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns=`trade_date
        )
    
        columnComments = dict(STRING, STRING)
        columnComments["trade_date"] = "报价日期"
        columnComments["security_id"] = "债券编码"
        columnComments["name"] = "债券简称"
        columnComments["remain_maturity"] = "剩余期限"
        columnComments["bond_type"] = "债券类型"
        columnComments["best_buy_bank"] = "最优报买价方"
        columnComments["best_buy_yield"] = "投资者最优买入价到期收益率（%）"
        columnComments["best_buy_price"] = "投资者最优买入全价"
        columnComments["best_sell_bank"] = "最优卖报价方"
        columnComments["best_sell_yield"] = "投资者最优卖出价到期收益率（%）"
        columnComments["best_sell_price"] = "投资者最优卖出全价"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table " + tbName + " created successfully!")
    }
    } else {
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}


