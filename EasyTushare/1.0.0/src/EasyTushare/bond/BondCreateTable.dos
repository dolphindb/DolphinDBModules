            array(SYMBOL, 0) as security_id,
            array(SYMBOL, 0) as call_type,
            array(SYMBOL, 0) as is_call,
            array(DATE, 0) as ann_date,
            array(DATE, 0) as call_date,
            array(DOUBLE, 0) as call_price,
            array(DOUBLE, 0) as call_price_tax,
            array(DOUBLE, 0) as call_vol,
            array(DOUBLE, 0) as call_amount,
            array(DATE, 0) as payment_date,
            array(DATE, 0) as call_reg_date,
            array(TIMESTAMP, 0) as update_time
        )
        
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
