}

/*
 * @Description: cb_issue data import
 * @DolphinDB server version:
 * @Last modification time: 2026-03-18 10:52:57
 * @dev:
 * @Author: fangwu
 */
def appendCbIssue(token, start_date, end_date){
    dbName = "dfs://tushare_basic_db"
    tbName = "cb_issue"
    api = "cb_issue"
    cols = ["ts_code", "ann_date", "res_ann_date", "plan_issue_size", "issue_size", "issue_price", "issue_type", "issue_cost", "onl_code", "onl_name", "onl_date", "onl_size", "onl_pch_vol", "onl_pch_num", "onl_pch_excess", "onl_winning_rate", "shd_ration_code", "shd_ration_name", "shd_ration_date", "shd_ration_record_date", "shd_ration_pay_date", "shd_ration_price", "shd_ration_ratio", "shd_ration_size", "shd_ration_vol", "shd_ration_num", "shd_ration_excess", "offl_size", "offl_deposit", "offl_pch_vol", "offl_pch_num", "offl_pch_excess", "offl_winning_rate", "lead_underwriter", "lead_underwriter_vol"]
    out = loadTable(dbName, tbName)
    p = {}
    res = getApiData(token, api, {}, cols)
    if(!res.isVoid() and res.count() != 0){
        replaceColumn!(res, "ts_code", symbol(string(res[`ts_code])))
        replaceColumn!(res, "ann_date", temporalParse(string(res[`ann_date]), "yyyyMMdd"))
        replaceColumn!(res, "res_ann_date", temporalParse(string(res[`res_ann_date]), "yyyyMMdd"))
        replaceColumn!(res, "plan_issue_size", double(res[`plan_issue_size]))
        replaceColumn!(res, "issue_size", double(res[`issue_size]))
        replaceColumn!(res, "issue_price", double(res[`issue_price]))
        replaceColumn!(res, "issue_type", symbol(string(res[`issue_type])))
        replaceColumn!(res, "issue_cost", double(res[`issue_cost]))
        replaceColumn!(res, "onl_code", symbol(string(res[`onl_code])))
        replaceColumn!(res, "onl_name", string(res[`onl_name]))
        replaceColumn!(res, "onl_date", temporalParse(string(res[`onl_date]), "yyyyMMdd"))
        replaceColumn!(res, "onl_size", double(res[`onl_size]))
        replaceColumn!(res, "onl_pch_vol", double(res[`onl_pch_vol]))
        replaceColumn!(res, "onl_pch_num", int(res[`onl_pch_num]))
        replaceColumn!(res, "onl_pch_excess", double(res[`onl_pch_excess]))
        replaceColumn!(res, "onl_winning_rate", double(res[`onl_winning_rate]))
        replaceColumn!(res, "shd_ration_code", symbol(string(res[`shd_ration_code])))
        replaceColumn!(res, "shd_ration_name", string(res[`shd_ration_name]))
        replaceColumn!(res, "shd_ration_date", temporalParse(string(res[`shd_ration_date]), "yyyyMMdd"))
        replaceColumn!(res, "shd_ration_record_date", temporalParse(string(res[`shd_ration_record_date]), "yyyyMMdd"))
        replaceColumn!(res, "shd_ration_pay_date", temporalParse(string(res[`shd_ration_pay_date]), "yyyyMMdd"))
        replaceColumn!(res, "shd_ration_price", double(res[`shd_ration_price]))
        replaceColumn!(res, "shd_ration_ratio", double(res[`shd_ration_ratio]))
        replaceColumn!(res, "shd_ration_size", double(res[`shd_ration_size]))
        replaceColumn!(res, "shd_ration_vol", double(res[`shd_ration_vol]))
        replaceColumn!(res, "shd_ration_num", int(res[`shd_ration_num]))
        replaceColumn!(res, "shd_ration_excess", double(res[`shd_ration_excess]))
        replaceColumn!(res, "offl_size", double(res[`offl_size]))
        replaceColumn!(res, "offl_deposit", double(res[`offl_deposit]))
        replaceColumn!(res, "offl_pch_vol", double(res[`offl_pch_vol]))
        replaceColumn!(res, "offl_pch_num", int(res[`offl_pch_num]))
        replaceColumn!(res, "offl_pch_excess", double(res[`offl_pch_excess]))
        replaceColumn!(res, "offl_winning_rate", double(res[`offl_winning_rate]))
        replaceColumn!(res, "lead_underwriter", string(res[`lead_underwriter]))
        replaceColumn!(res, "lead_underwriter_vol", double(res[`lead_underwriter_vol]))
        res = select *, now() as update_time from res
        // basic 数据 先清空再添加
        truncate(dbName, tbName)
        out.append!(res)
        print("Success append data for Table " + api )
    } else {
        print("no data for Table " + api)
    }
    print("Success append data for Table " + api)
}

/*
 * @Description: cb_price_chg data import
 * @DolphinDB server version:
 * @Last modification time: 2026-03-18 10:52:57
 * @dev:
 * @Author: fangwu
 */
def appendCbPriceChg(token, start_date, end_date){

    // 先通过可转债的基本信息接口获取可转债的ts_code
    basic_api = "cb_basic"
    codes_ = getApiData(token, basic_api, {}, ['ts_code'])
    codes = codes_.ts_code
    codesBatchs = cut(codes,10)

    // 导入cb_price_chg数据
    dbName = "dfs://tushare_basic_db"
    tbName = "cb_price_chg"
    // 先truncate表
    truncate(dbName, tbName)
    // 导入数据
    api = "cb_price_chg"
    cols = ["ts_code", "bond_short_name", "publish_date", "change_date", "convert_price_initial", "convertprice_bef", "convertprice_aft"]

    for (oneBatch in codesBatchs){ // oneBatch = codesBatchs[0]
        oneBatchStr = oneBatch.concat(',')
        p = {"ts_code":oneBatchStr}
        res = getApiData(token, api, p, cols)
        if(!res.isVoid() and res.count() != 0){
            replaceColumn!(res, "ts_code", symbol(string(res[`ts_code])))
            replaceColumn!(res, "bond_short_name", string(res[`bond_short_name]))
            replaceColumn!(res, "publish_date", temporalParse(string(res[`publish_date]), "yyyyMMdd"))
            replaceColumn!(res, "change_date", temporalParse(string(res[`change_date]), "yyyyMMdd"))
            replaceColumn!(res, "convert_price_initial", double(res[`convert_price_initial]))
            replaceColumn!(res, "convertprice_bef", double(res[`convertprice_bef]))
            replaceColumn!(res, "convertprice_aft", double(res[`convertprice_aft]))
            res = select *, now() as update_time from res
            loadTable(dbName, tbName).append!(res)
            print("Success append data for Table " + api + " for ts_code: " + oneBatchStr)
        } else {
            print("no data for Table " + api + " for ts_code: " + oneBatchStr)
        }
    }
    print("Success append data for Table " + api)
}

/*
 * @Description: cb_rate data import
 * @DolphinDB server version:
 * @Last modification time: 2026-03-18 10:52:57
 * @dev:
 * @Author: fangwu
 */
def appendCbRate(token, start_date, end_date){

    // 先通过可转债的基本信息接口获取可转债的ts_code
    basic_api = "cb_basic"
    codes_ = getApiData(token, basic_api, {}, ['ts_code'])
    codes = codes_.ts_code

    // 遍历每个可转债的ts_code，获取其coupon_rate数据
    codesBatchs = cut(codes,10)

    dbName = "dfs://tushare_basic_db"
    tbName = "cb_rate"
    // 先清空数据
    truncate(dbName, tbName)
    api = "cb_rate"
    cols = ["ts_code", "rate_freq", "rate_start_date", "rate_end_date", "coupon_rate"]
    for (oneBatch in codesBatchs){ // oneBatch = codesBatchs[0]
        oneBatchStr = oneBatch.concat(',')
        p = {"ts_code":oneBatchStr}
        res = getApiData(token, api, p, cols)
        if(!res.isVoid() and res.count() != 0){
            replaceColumn!(res, "ts_code", symbol(string(res[`ts_code])))
            replaceColumn!(res, "rate_freq", int(res[`rate_freq]))
            replaceColumn!(res, "rate_start_date", temporalParse(string(res[`rate_start_date]), "yyyyMMdd"))
            replaceColumn!(res, "rate_end_date", temporalParse(string(res[`rate_end_date]), "yyyyMMdd"))
            replaceColumn!(res, "coupon_rate", double(res[`coupon_rate]))
            res = select *, now() as update_time from res
            loadTable(dbName, tbName).append!(res)
            print("Success append data for Table " + api + " for ts_code: " + oneBatchStr)
        } else {
            print("no data for Table " + api + " for ts_code: " + oneBatchStr)
        }
    }
    print("Success append data for Table " + api)
}

