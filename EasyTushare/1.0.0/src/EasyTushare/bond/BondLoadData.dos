/*
 * @Description: repo_daily data import
 * @DolphinDB server version:
 * @Last modification time: 2026-03-18 10:52:57
 * @dev:
 * @Author: fangwu
 */
def appendRepoDaily(token, start_date, end_date){
    dbName = "dfs://tushare_daily_db"
    tbName = "repo_daily"
    api = "repo_daily"
    cols = ["ts_code", "trade_date", "repo_maturity", "pre_close", "open", "high", "low", "close", "weight", "weight_r", "amount", "num"]
    out = loadTable(dbName, tbName)
    delete from loadTable(dbName, tbName) where trade_date between start_date and end_date
    for(oneDate in getMarketCalendar("SSE", start_date, end_date)){  // oneDate = 2020.08.04
        dateText = temporalFormat(oneDate, "yyyyMMdd")
        p = {"trade_date":dateText}
        res = getApiData(token, api, p, cols)
        if(!res.isVoid() and res.count() != 0){
            replaceColumn!(res, "ts_code", symbol(string(res[`ts_code])))
            replaceColumn!(res, "trade_date", temporalParse(string(res[`trade_date]), "yyyyMMdd"))
            replaceColumn!(res, "repo_maturity", symbol(string(res[`repo_maturity])))
            replaceColumn!(res, "pre_close", double(res[`pre_close]))
            replaceColumn!(res, "open", double(res[`open]))
            replaceColumn!(res, "high", double(res[`high]))
            replaceColumn!(res, "low", double(res[`low]))
            replaceColumn!(res, "close", double(res[`close]))
            replaceColumn!(res, "weight", double(res[`weight]))
            replaceColumn!(res, "weight_r", double(res[`weight_r]))
            replaceColumn!(res, "amount", double(res[`amount]))
            replaceColumn!(res, "num", int(res[`num]))
            res = select *, now() as update_time from res
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateText)
        } else {
            print("no data for Table " + api + " for date: " + dateText)
        }
    }
    print("Success append data for Table " + api)
}

