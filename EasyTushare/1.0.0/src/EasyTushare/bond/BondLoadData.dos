module EasyTushare::bond::BondLoadData

/* 
*  @Brief: 债券数据单个表导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/
use EasyTushare::TsInit
/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
 * @Description: bc_bestotcqt data import
 * @DolphinDB server version:
 * @Last modification time: 2026-03-18 10:52:57
 * @dev:
 * @Author: fangwu
 */
def appendBcBestotcqt(token, start_date, end_date){
    dbName = "dfs://tushare_daily_db"
    tbName = "bc_bestotcqt"
    api = "bc_bestotcqt"
    cols = ["trade_date", "ts_code", "name", "remain_maturity", "bond_type", "best_buy_bank", "best_buy_yield", "best_buy_price", "best_sell_bank", "best_sell_yield", "best_sell_price"]
    out = loadTable(dbName, tbName)
    delete from loadTable(dbName, tbName) where trade_date between start_date and end_date
    
    for(oneDate in getMarketCalendar("SSE", start_date, end_date)){ // oneDate = 2026.03.21 
        dateText = temporalFormat(oneDate, "yyyyMMdd")
        p = {"trade_date":dateText}
        res = getApiData(token, api, p, cols)
        if(!res.isVoid() and res.count() != 0){
            replaceColumn!(res, "trade_date", temporalParse(string(res[`trade_date]), "yyyyMMdd"))
            replaceColumn!(res, "ts_code", symbol(string(res[`ts_code])))
            replaceColumn!(res, "name", string(res[`name]))
            replaceColumn!(res, "remain_maturity", string(res[`remain_maturity]))
            replaceColumn!(res, "bond_type", symbol(string(res[`bond_type])))
            replaceColumn!(res, "best_buy_bank", symbol(string(res[`best_buy_bank])))
            replaceColumn!(res, "best_buy_yield", double(res[`best_buy_yield]))
            replaceColumn!(res, "best_buy_price", double(res[`best_buy_price]))
            replaceColumn!(res, "best_sell_bank", symbol(string(res[`best_sell_bank])))
            replaceColumn!(res, "best_sell_yield", double(res[`best_sell_yield]))
            replaceColumn!(res, "best_sell_price", double(res[`best_sell_price]))
            res = select *, now() as update_time from res
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateText)
        } else {
            print("no data for Table " + api + " for date: " + dateText)
        }
    }
    print("Success append data for Table " + api)
}

/*
 * @Description: bc_otcqt data import
 * @DolphinDB server version:
 * @Last modification time: 2026-03-18 10:52:57
 * @dev:
 * @Author: fangwu
 */
def appendBcOtcqt(token, start_date, end_date){

    dbName = "dfs://tushare_daily_db"
    tbName = "bc_otcqt"
    api = "bc_otcqt"
    cols = ["trade_date", "qt_time", "bank", "ts_code", "name", "maturity", "remain_maturity", "bond_type", "coupon_rate", "buy_price", "sell_price", "buy_yield", "sell_yield"]
    out = loadTable(dbName, tbName)
    delete from loadTable(dbName, tbName) where trade_date between start_date and end_date

    // 翻页处理
    // 单天会超出两千行（接口限制）
    for(oneDate in getMarketCalendar("SSE", start_date, end_date)){ // oneDate = 2024.04.29
        dateText = temporalFormat(oneDate, "yyyyMMdd")
        offset_ = 0 
        prev_count_ = 0
        do {
            res = getApiData(token, api, {"trade_date":dateText,"offset":offset_}, cols)
            cur_count_ = res.count()
            if(!res.isVoid() and cur_count_ != 0){
                // 按日期拉取数据
                replaceColumn!(res, "trade_date", temporalParse(string(res[`trade_date]), "yyyyMMdd"))
                replaceColumn!(res, "qt_time", time(temporalParse(string(res[`qt_time]), "HH:mm:ss")))
                replaceColumn!(res, "bank", symbol(string(res[`bank])))
                replaceColumn!(res, "ts_code", symbol(string(res[`ts_code])))
                replaceColumn!(res, "name", string(res[`name]))
                replaceColumn!(res, "maturity", string(res[`maturity]))
                replaceColumn!(res, "remain_maturity", string(res[`remain_maturity]))
                replaceColumn!(res, "bond_type", symbol(string(res[`bond_type])))
                replaceColumn!(res, "coupon_rate", double(res[`coupon_rate]))
                replaceColumn!(res, "buy_price", double(res[`buy_price]))
                replaceColumn!(res, "sell_price", double(res[`sell_price]))
                replaceColumn!(res, "buy_yield", double(res[`buy_yield]))
                replaceColumn!(res, "sell_yield", double(res[`sell_yield]))
                res = select *, now() as update_time from res
                out.append!(res)
                offset_ = prev_count_ + cur_count_ + 1
                prev_count_ = prev_count_ + cur_count_
                print("Success append data for Table " + api + " for date: " + dateText+ ",count:"+cur_count_.string())
            }else {
                break
            }
        } while(true)
        print("Success append data for Table " + api + " for date: " + dateText)
    }
    print("Success append data for Table " + api)
}

