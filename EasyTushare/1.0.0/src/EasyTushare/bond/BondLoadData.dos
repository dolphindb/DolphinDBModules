//  use tushare
def appendCbShare(token, start_date, end_date){
    api_basic = "cb_basic"
    codes_ = getApiData(token, api_basic, {}, ['ts_code'])
    codes = codes_.ts_code
    codesBatchs = cut(codes,2)

    dbName = "dfs://tushare_daily_db"
    tbName = "cb_share"
    // 先清空表数据
    truncate(dbName, tbName)
    
    api = "cb_share"
    cols = ["ts_code", "bond_short_name", "publish_date", "end_date", "issue_size", "convert_price_initial", "convert_price", "convert_val", "convert_vol", "convert_ratio", "acc_convert_val", "acc_convert_vol", "acc_convert_ratio", "remain_size", "total_shares"]

    for (oneBatch in codesBatchs){ // oneBatch = codesBatchs[0]
        oneBatchStr = oneBatch.concat(',')
        p = {"ts_code":oneBatchStr}
        res = getApiData(token, api, p, cols)
        if(!res.isVoid() and res.count() != 0){
            replaceColumn!(res, "ts_code", symbol(string(res[`ts_code])))
            replaceColumn!(res, "bond_short_name", string(res[`bond_short_name]))
            replaceColumn!(res, "publish_date", temporalParse(string(res[`publish_date]), "yyyyMMdd"))
            replaceColumn!(res, "end_date", temporalParse(string(res[`end_date]), "yyyyMMdd"))
            replaceColumn!(res, "issue_size", double(res[`issue_size]))
            replaceColumn!(res, "convert_price_initial", double(res[`convert_price_initial]))
            replaceColumn!(res, "convert_price", double(res[`convert_price]))
            replaceColumn!(res, "convert_val", double(res[`convert_val]))
            replaceColumn!(res, "convert_vol", double(res[`convert_vol]))
            replaceColumn!(res, "convert_ratio", double(res[`convert_ratio]))
            replaceColumn!(res, "acc_convert_val", double(res[`acc_convert_val]))
            replaceColumn!(res, "acc_convert_vol", double(res[`acc_convert_vol]))
            replaceColumn!(res, "acc_convert_ratio", double(res[`acc_convert_ratio]))
            replaceColumn!(res, "remain_size", double(res[`remain_size]))
            replaceColumn!(res, "total_shares", double(res[`total_shares]))
            res = select *, now() as update_time from res
            loadTable(dbName, tbName).append!(res)
            print("Success append data for Table " + api + " for ts_code: " + oneBatchStr)
        } else {
            print("no data for Table " + api + " for ts_code: " + oneBatchStr)
        }
    }
    print("Success append data for Table " + api)
}

