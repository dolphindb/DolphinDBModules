def appendCbBasic(token, start_date, end_date){
    dbName = "dfs://tushare_basic_db"
    tbName = "cb_basic"
    api = "cb_basic"
    cols = ["ts_code", "bond_full_name", "bond_short_name", "cb_code", "stk_code", "stk_short_name", "maturity", "par", "issue_price", "issue_size", "remain_size", "value_date", "maturity_date", "rate_type", "coupon_rate", "add_rate", "pay_per_year", "list_date", "delist_date", "exchange", "conv_start_date", "conv_end_date", "conv_stop_date", "first_conv_price", "conv_price", "rate_clause", "put_clause", "maturity_put_price", "call_clause", "reset_clause", "conv_clause", "guarantor", "guarantee_type", "issue_rating", "newest_rating", "rating_comp"]
    p = {}
    res = getApiData(token, api, p, cols)
    if(!res.isVoid() and res.count() != 0){
        replaceColumn!(res, "ts_code", symbol(string(res[`ts_code])))
        replaceColumn!(res, "bond_full_name", string(res[`bond_full_name]))
        replaceColumn!(res, "bond_short_name", string(res[`bond_short_name]))
        replaceColumn!(res, "cb_code", symbol(string(res[`cb_code])))
        replaceColumn!(res, "stk_code", symbol(string(res[`stk_code])))
        replaceColumn!(res, "stk_short_name", string(res[`stk_short_name]))
        replaceColumn!(res, "maturity", double(res[`maturity]))
        replaceColumn!(res, "par", double(res[`par]))
        replaceColumn!(res, "issue_price", double(res[`issue_price]))
        replaceColumn!(res, "issue_size", double(res[`issue_size]))
        replaceColumn!(res, "remain_size", double(res[`remain_size]))
        replaceColumn!(res, "value_date", temporalParse(string(res[`value_date]), "yyyyMMdd"))
        replaceColumn!(res, "maturity_date", temporalParse(string(res[`maturity_date]), "yyyyMMdd"))
        replaceColumn!(res, "rate_type", symbol(string(res[`rate_type])))
        replaceColumn!(res, "coupon_rate", double(res[`coupon_rate]))
        replaceColumn!(res, "add_rate", double(res[`add_rate]))
        replaceColumn!(res, "pay_per_year", int(res[`pay_per_year]))
        replaceColumn!(res, "list_date", temporalParse(string(res[`list_date]), "yyyyMMdd"))
        replaceColumn!(res, "delist_date", temporalParse(string(res[`delist_date]), "yyyyMMdd"))
        replaceColumn!(res, "exchange", symbol(string(res[`exchange])))
        replaceColumn!(res, "conv_start_date", temporalParse(string(res[`conv_start_date]), "yyyyMMdd"))
        replaceColumn!(res, "conv_end_date", temporalParse(string(res[`conv_end_date]), "yyyyMMdd"))
        replaceColumn!(res, "conv_stop_date", temporalParse(string(res[`conv_stop_date]), "yyyyMMdd"))
        replaceColumn!(res, "first_conv_price", double(res[`first_conv_price]))
        replaceColumn!(res, "conv_price", double(res[`conv_price]))
        replaceColumn!(res, "rate_clause", string(res[`rate_clause]))
        replaceColumn!(res, "put_clause", string(res[`put_clause]))
        replaceColumn!(res, "maturity_put_price", string(res[`maturity_put_price]))
        replaceColumn!(res, "call_clause", string(res[`call_clause]))
        replaceColumn!(res, "reset_clause", string(res[`reset_clause]))
        replaceColumn!(res, "conv_clause", string(res[`conv_clause]))
        replaceColumn!(res, "guarantor", string(res[`guarantor]))
        replaceColumn!(res, "guarantee_type", symbol(string(res[`guarantee_type])))
        replaceColumn!(res, "issue_rating", symbol(string(res[`issue_rating])))
        replaceColumn!(res, "newest_rating", symbol(string(res[`newest_rating])))
        replaceColumn!(res, "rating_comp", string(res[`rating_comp]))
        res = select *, now() as update_time from res

        // 导入前先删除旧数据
        truncate(dbName, tbName)
        loadTable(dbName, tbName).append!(res)
        print("Success append data for Table " + api )
    } else {
        print("no data for Table " + api )
    }
    print("Success append data for Table " + api)
}

