/*
 * @Description: append data for daily_info
 * @DolphinDB server version:
 * @Last modification time: 2026-04-03 17:37:52
 * @dev:
 * @Author: codex
 */
def appendDailyInfo(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "daily_info"
    api = "daily_info"
    cols = [
        "trade_date",
        "ts_code",
        "ts_name",
        "com_count",
        "total_share",
        "float_share",
        "total_mv",
        "float_mv",
        "amount",
        "vol",
        "trans_count",
        "pe",
        "tr",
        "exchange"
    ]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where trade_date between start_date and end_date

    days = start_date..end_date
    yearBeginDays = yearBegin(days).distinct().sort!()
    for (oneDate in yearBeginDays){  
        startDateStr =  temporalFormat(max(oneDate, start_date), "yyyyMMdd")
        endDateStr = temporalFormat(min(yearEnd(oneDate), end_date), "yyyyMMdd")
        p = {start_date:startDateStr, end_date:endDateStr}
        logRange = startDateStr + " -> " + endDateStr
        
        res = getApiData(token, api, p, cols)
        if(res.count()==4000){
            print("Warning: data count for Table " + api + " in date range " + logRange + " reaches the limit 2000, some data may be missing. Consider narrowing the date range.")
        }
        if(!res.isVoid() and res.count() != 0){
        res = select
                trade_date,
                ts_code as code,
                ts_name,
                com_count,
                total_share,
                float_share,
                total_mv,
                float_mv,
                amount,
                vol,
                trans_count,
                pe,
                tr,
                exchange,
                now() as update_time
        from res
        replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
        replaceColumn!(res, "code", symbol(string(res.code)))
        replaceColumn!(res, "ts_name", string(res.ts_name))
        replaceColumn!(res, "com_count", int(res.com_count))
        replaceColumn!(res, "total_share", double(res.total_share))
        replaceColumn!(res, "float_share", double(res.float_share))
        replaceColumn!(res, "total_mv", double(res.total_mv))
        replaceColumn!(res, "float_mv", double(res.float_mv))
        replaceColumn!(res, "amount", double(res.amount))
        replaceColumn!(res, "vol", double(res.vol))
        replaceColumn!(res, "trans_count", int(res.trans_count))
        replaceColumn!(res, "pe", double(res.pe))
        replaceColumn!(res, "tr", double(res.tr))
        replaceColumn!(res, "exchange", symbol(string(res.exchange)))
        replaceColumn!(res, "update_time", timestamp(res.update_time))
        out.append!(res)
        print("Success append data for Table " + api)
        } else {
            print("no data for Table " + api)
        }
    }
}

