/*
 * @Description: append data for index_global
 * @DolphinDB server version:
 * @Last modification time: 2026-04-03 17:37:52
 * @dev:
 * @Author: codex
 */
def appendIndexGlobal(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "index_global"
    api = "index_global"
    cols = [
        "ts_code",
        "trade_date",
        "open",
        "close",
        "high",
        "low",
        "pre_close",
        "change",
        "pct_chg",
        "swing",
        "vol",
        "amount"
    ]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where trade_date between start_date and end_date

    global_inedx_codes = ["XIN9","HSI","HKTECH","HKAH","DJI","SPX","IXIC","FTSE","FCHI","GDAXI","N225","KS11","AS51","SENSEX","IBOVESPA","RTS","TWII","CKLSE","SPTSX","CSX5P","RUT"]
    days = start_date..end_date
    len_days = size(days)
    daysBatch = days.distinct().sort!().cut(min(len_days, 30))
    for (oneBatch in daysBatch) { 
        len = size(oneBatch)-1
        // startDate = "20200201"
        // endDate = "20200228"
        startDate = temporalFormat(oneBatch[0], "yyyyMMdd")
        endDate = temporalFormat(oneBatch[len], "yyyyMMdd")
        for (code in global_inedx_codes) { // code = "XIN9"
            p = {"ts_code":code,"start_date":startDate, "end_date":endDate}
            res = getApiData(token, api, p, cols)
            if(!res.isVoid() and res.count() != 0){
                if (res.count() == 4000) {throw "count is 4000, exceded max limit, please check"}
                update res set update_time = now()
                replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
                replaceColumn!(res, "open", double(res.open))
                replaceColumn!(res, "close", double(res.close))
                replaceColumn!(res, "high", double(res.high))
                replaceColumn!(res, "low", double(res.low))
                replaceColumn!(res, "pre_close", double(res.pre_close))
                replaceColumn!(res, "change", double(res.change))
                replaceColumn!(res, "pct_chg", double(res.pct_chg))
                replaceColumn!(res, "swing", double(res.swing))
                replaceColumn!(res, "vol", double(res.vol))
                replaceColumn!(res, "amount", double(res.amount))
                replaceColumn!(res, "update_time", timestamp(res.update_time))
                out.append!(res)
                sleep(300)
                print("Success append data for Table " + api + "for " + code + "for startDate = " + startDate + "for endDate = " + endDate + "for count = " + res.count())
            } else {
                print("no data for Table " + api + "for " + code)
            }
        }
    }
    print("Success append data for Table " + api )  
}

