*/

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

// 判断指定日期 d 是否为本周最后一个交易日（A股用 XSHG / XSHE）
def isLastTradingDayOfWeek(d, market="XSHG") {
    // 本周周日（weekEnd 默认 weekday=6 即周日）
    sunday = weekEnd(d)
    monday = sunday - 6
    // 取本周一~周日之间的所有交易日
    cal = getMarketCalendar(market, monday, sunday)
    if (cal.size() == 0) return false
    lastTd = cal[cal.size()-1]   // 本周最后一个交易日
    return d == lastTd
}

def isLastTradingDayOfMonth(d, market="XSHG") {
    mStart = monthStart(d)          // 当月 1 号
    mEnd   = monthEnd(d)            // 当月最后一天（自然日）
    cal    = getMarketCalendar(market, mStart, mEnd)
    if (cal.size() == 0) return false
    return d == cal.last()
}

def getIndexCodes(token){
    markets = ["MSCI","CSI","SSE","SZSE","CICC","SW","OTH"]
    tmp = table(1:0,["ts_code","name","market"],[SYMBOL,STRING,SYMBOL])
    for(market_ in markets){
        offset_ = 0
        prev_count_=0
        curr_count = 0
        do {
            api = "index_basic"
            cols = ["ts_code","name"]
            p = {"market":market_,"offset":offset_}
            index_info = getApiData(token, api, p, cols)
            res = getApiData(token, api, p, cols)
            if(!res.isVoid() and res.count() != 0){
                update res set market = market_
                tmp.append!(res)
                curr_count = res.count()
                prev_count_ = prev_count_ + curr_count
                offset_ = prev_count_ + 1
            }
        } while(res.count()!=0)
    }
    return tmp
}

def appendIndexWeight(token, start_date,end_date){ // start_date = 2026.08.13 end_date = 2026.08.13
    // 指数权重 月度数据
    dbPath = "dfs://tushare_daily_db"
    tableName = "index_weight"
    api = "index_weight"
    cols = ["index_code", "con_code", "trade_date", "weight"]

    days = start_date..end_date
    monthBeginDays = monthBegin(days).distinct().sort!()

    index_info = getIndexCodes(token)
    count_ = 0
    len = index_info.count()

    for (oneDay in monthBeginDays) { // oneDay = 2026.08.01
        startDay = min(oneDay, start_date)
        end_day = min(monthEnd(oneDay), end_date)
        //  不是月末 直接退出
        if (!isLastTradingDayOfMonth(oneDay, "XSHG")){
            continue 
        }
        start_day_str = temporalFormat(startDay, "yyyyMMdd")
        end_day_str = temporalFormat(end_day, "yyyyMMdd")
        delete from loadTable(dbPath, tableName) where trade_date between startDay and end_day

        for (i in 0..(len-1) ){ // i=1
            index_code_ = index_info[i]["ts_code"]
            market_ = index_info[i]["market"]
            index_name_ = index_info[i]["name"]
            offset_ = 0
            prev_count_=0
            curr_count = 0
            do {
                api = "index_weight"
                cols = ["index_code", "con_code", "trade_date", "weight"]
                p = {"index_code":index_code_,"start_date":start_day_str, "end_date":end_day_str,"offset":offset_}
                res = getApiData(token, api, p, cols)
                if(!res.isVoid() and res.count() != 0){
                    update res set update_time = now()
                    // update res set index_name = index_name_
                    replaceColumn!(res, "index_code", symbol(string(res.index_code)))
                    replaceColumn!(res, "con_code", symbol(string(res.con_code)))
                    replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
                    replaceColumn!(res, "weight", double(res.weight))
                    replaceColumn!(res, "update_time", timestamp(res.update_time))

                    res.reorderColumns!(["index_code","con_code","trade_date","weight","update_time"])
                    loadTable(dbPath, tableName).append!(res)
                    print( market_ + ":" + index_name_+ "("+i+"/"+len+")" + "(" + start_day_str + " to " + end_day_str + ") appended successfully, for count:" + res.count())  
                    count_ = count_ + res.count()
                    curr_count = res.count()
                    prev_count_ = prev_count_ + curr_count
                    offset_ = prev_count_ + 1
                }
            } while(res.count()!=0)            
        } 
    }
}

/**
 *  @FunctionName: appendIndexClassify
 *  @Brief: Append a DFS table for Index Classify
 *  @Param: None
 *  @Return: None
 *  @SampleUsage: appendIndexClassify(token, p)
 */
def appendIndexClassify(token, start_date, end_date){
    // 维度数据，每次导入前，先清空
    truncate("dfs://tushare_basic_db", "index_classify")
    
    api = "index_classify"
    cols = ["index_code", "industry_name", "parent_code", "level", "industry_code", "is_pub", "src"]
    
    levels = ["L1","L2","L3"]
    for (level_ in levels) { // level_ = "L3"
        p = {"level":level_, "src":"SW2021"}
        res = getApiData(token, api, p, cols)
        
        if (!res.isVoid() and res.count() > 0) {
            // 字段类型转换
            replaceColumn!(res, "index_code", symbol(string(res.index_code)))
            replaceColumn!(res, "industry_name", string(res.industry_name))
            replaceColumn!(res, "parent_code", symbol(string(res.parent_code)))
            replaceColumn!(res, "level", symbol(string(res.level))) 
            replaceColumn!(res, "industry_code", symbol(string(res.industry_code)))
            replaceColumn!(res, "is_pub", symbol(string(res.is_pub)))
            replaceColumn!(res, "src", symbol(string(res.src)))
            // 添加更新时间
            res[`update_time] = now()
            // 写入表
            loadTable("dfs://tushare_basic_db", "index_classify").append!(res)
            
            print( level_ + ":"+ "appended successfully!")  
        }else {
            print( level_ + ":"+ "no data!")  
        }
    }
}

/**
 *  @FunctionName: appendIndexMemberAll
 *  @Brief: Append a DFS table for Index Member All
 *  @Param: None
 *  @Return: None
 *  @SampleUsage: appendIndexMemberAll(token, start_date, end_date)
 */
def appendIndexMemberAll(token, start_date, end_date){
    // 维度数据，每次导入前，先清空
    truncate("dfs://tushare_basic_db", "index_member_all")

    // 先获取所有L1指数代码
    api_level1 = "index_classify"
    p_level1 = {"level":"L1", "src":"SW2021"}
    res_level1 = getApiData(token, api_level1, p_level1, ["index_code"])

    api = "index_member_all"
    cols = ["l1_code", "l1_name", "l2_code", "l2_name", "l3_code", "l3_name", "ts_code", "name", "in_date", "out_date", "is_new"]
    for (index_code_ in res_level1.index_code) { // index_code_ = "801980.SI"
        p = {"l1_code":index_code_}
        res = getApiData(token, api, p, cols)
        if (!res.isVoid() and res.count() > 0) {  
            // 字段类型转换
            replaceColumn!(res, "l1_code", symbol(string(res.l1_code)))
            replaceColumn!(res, "l1_name", string(res.l1_name))
            replaceColumn!(res, "l2_code", symbol(string(res.l2_code)))
            replaceColumn!(res, "l2_name", string(res.l2_name))
            replaceColumn!(res, "l3_code", symbol(string(res.l3_code)))
            replaceColumn!(res, "l3_name", string(res.l3_name))
            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "name", string(res.name))
            replaceColumn!(res, "in_date", temporalParse(res.in_date, "yyyyMMdd"))
            replaceColumn!(res, "out_date", temporalParse(res.out_date, "yyyyMMdd"))
            replaceColumn!(res, "is_new", symbol(string(res.is_new)))
            // 添加更新时间
            res[`update_time] = now()
            // 写入表
            loadTable("dfs://tushare_basic_db", "index_member_all").append!(res)
            
            print( index_code_ + ":"+ "appended successfully!")  
        }else {
            print( index_code_ + ":"+ "no data!")  
        }
    }
}

/*
 * @Description: 指数日线行情数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-24 10:52:57
 * @dev: 
 * @Author: 
 */
def appendIndexDaily(token, start_date, end_date){ 
    dbPath = "dfs://tushare_daily_db"
    tableName = "index_daily"
    api = "index_daily"
    cols = ["ts_code","trade_date","close","open","high","low","pre_close","change","pct_chg","vol","amount"]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where trade_date between start_date and end_date

    start_day = temporalFormat(start_date, "yyyyMMdd")
    end_day = temporalFormat(end_date, "yyyyMMdd")

    if (start_date == end_date and !(start_date in getMarketCalendar("XSHG",start_date,end_date))){
        return 
    }

    index_info = getIndexCodes(token)
    len = index_info.count()
    for (i in 0..(len-1) ){ // i = 0
        // print(0)
        index_code_ = index_info[i]["ts_code"] // index_code_ = '000300.SH'
        index_name_ = index_info[i]["name"]
        market_ = index_info[i]["market"]
        p = {"ts_code":index_code_, "start_date":start_day, "end_date":end_day}
        res = getApiData(token, api, p, cols)
        if (!res.isVoid() and res.count() !=0){
            update res set update_time = now()
            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "close", double(res.close))
            replaceColumn!(res, "open", double(res.open))
            replaceColumn!(res, "high", double(res.high))
            replaceColumn!(res, "low", double(res.low))
            replaceColumn!(res, "pre_close", double(res.pre_close))
            replaceColumn!(res, "change", double(res.change))
            replaceColumn!(res, "pct_chg", double(res.pct_chg))
            replaceColumn!(res, "vol", double(res.vol))
            replaceColumn!(res, "amount", double(res.amount))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            out.append!(res)
            // 
            print( market_ + ":" + index_name_+ "("+i+"/"+len+")" + "(" + start_day + " to " + end_day + ") appended successfully!") 
        } else {
            print( market_ + ":" + index_name_+ "("+i+"/"+len+")" + "(" + start_day + " to " + end_day + ") no data!")
        } 
        sleep(50)  
    }  
    print("Success append data for Table " + api)
}
/*
 * @Description: 股票历史分钟行情数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-24 10:52:57
 * @dev: 
 * @Author: 
 */
def appendIdx1minK(token, start_date, end_date){ 
    // 应该是只有沪深有数据
    // markets = ["SSE","SZSE"]
    // 1min_k 数据导入
    dbPath = "dfs://tushare_minute_db"
    tableName = "idx_1min_k"
    api = "idx_mins"
    cols = ["ts_code","trade_time","open","close","high","low","vol","amount"]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where date(trade_time) between start_date and end_date

    index_info = select * from getIndexCodes(token) where market in ["SSE","SZSE"]
    for (one_date in getMarketCalendar("XSHG",start_date,end_date)) {
        index_code_ = index_info.ts_code
        codes_bantch = index_code_.cut(29)

        for (one_batch in codes_bantch) {
            // one_batch = codes_bantch[0]
            start_time = temporalFormat(one_date,"yyyy-MM-dd") + " 09:00:00"
            end_time = temporalFormat(one_date,"yyyy-MM-dd") + " 19:00:00"
            
            one_batch_str = concat(one_batch,",")
            p = {ts_code:one_batch_str, freq:"1min", start_date:start_time, end_date:end_time}
            res = getApiData(token, api, p, cols)
            if (!res.isVoid() and res.count() !=0){
    
                update res set update_time = now()
                replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                replaceColumn!(res, "trade_time", timestamp(res.trade_time))
                replaceColumn!(res, "open", double(res.open))
                replaceColumn!(res, "close", double(res.close))
                replaceColumn!(res, "high", double(res.high))
                replaceColumn!(res, "low", double(res.low))
                replaceColumn!(res, "vol", int(res.vol))
                replaceColumn!(res, "amount", double(res.amount))
                replaceColumn!(res, "update_time", timestamp(res.update_time))
                out.append!(res)
            }
        }
    }
    print("Success append data for Table " + tableName)
}


