/*
 * @Description: append data for index_basic
 * @DolphinDB server version:
 * @Last modification time: 2026-04-03 17:37:52
 * @dev:
 * @Author: codex
 */
def appendIndexBasic(token, start_date, end_date){
    dbPath = "dfs://tushare_basic_db"
    tableName = "index_basic"
    api = "index_basic"
    cols = [
        "ts_code",
        "name",
        "fullname",
        "market",
        "publisher",
        "index_type",
        "category",
        "base_date",
        "base_point",
        "list_date",
        "weight_rule",
        "desc",
        "exp_date"
    ]
    out = loadTable(dbPath, tableName)
    // 先truncate
    truncate(dbPath, tableName)

    // 导入数据
    market_list = ["MSCI","CSI","SSE","SZSE","CICC","SW","OTH"]
    for(market_ in market_list){
        // market_ = "CSI"
        offset_ = 0
        prev_count_=0
        curr_count = 0
        do {
            p = {"market":market_,"offset":offset_}
            index_info = getApiData(token, api, p, cols)
            res = getApiData(token, api, p, cols)
            if(!res.isVoid() and res.count() != 0){
                update res set update_time = now()
                replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                replaceColumn!(res, "name", string(res.name))
                replaceColumn!(res, "fullname", string(res.fullname))
                replaceColumn!(res, "market", symbol(string(res.market)))
                replaceColumn!(res, "publisher", symbol(string(res.publisher)))
                replaceColumn!(res, "index_type", symbol(string(res.index_type)))
                replaceColumn!(res, "category", symbol(string(res.category)))
                replaceColumn!(res, "base_date", temporalParse(string(res.base_date), "yyyyMMdd"))
                replaceColumn!(res, "base_point", double(res.base_point))
                replaceColumn!(res, "list_date", temporalParse(string(res.list_date), "yyyyMMdd"))
                replaceColumn!(res, "weight_rule", symbol(string(res.weight_rule)))
                replaceColumn!(res, "desc", string(res.desc))
                replaceColumn!(res, "exp_date", temporalParse(string(res.exp_date), "yyyyMMdd"))
                replaceColumn!(res, "update_time", timestamp(res.update_time))
                out.append!(res)
                curr_count = res.count()
                prev_count_ = prev_count_ + curr_count
                offset_ = prev_count_ + 1
            }
        } while(res.count()!=0)
    }
    print("Success append data for Table " + api )
}

/*
 * @Description: append data for index_weekly
 * @DolphinDB server version:
 * @Last modification time: 2026-04-03 17:37:52
 * @dev:
 * @Author: codex
 */
def appendIndexWeekly(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "index_weekly"
    api = "index_weekly"
    cols = [
        "ts_code",
        "trade_date",
        "close",
        "open",
        "high",
        "low",
        "pre_close",
        "change",
        "pct_chg",
        "vol",
        "amount"
    ]
    out = loadTable(dbPath, tableName)
    // 先删除这段日期的数据
    delete from out where trade_date between start_date and end_date 
    days = start_date..end_date
    if (size(days) == 1 and !(isLastTradingDayOfWeek(days[0], "XSHG"))) {
        return 
    }
    yearBegindays = yearBegin(days).distinct().sort!()
    for (oneYear in yearBegindays) { // oneYear = 2020.01.01
        startDate = temporalFormat(max(start_date, oneYear), "yyyyMMdd")
        endDate = temporalFormat(min(yearEnd(oneYear), end_date), "yyyyMMdd")
        for (market in ["SSE","SZSE","SW"]) { // market = "SSE"
            codes_info = getApiData(token, "index_basic", {"market": market}, ["ts_code"])
            codes = codes_info.ts_code
            len = size(codes)-1
            for (i in 0..len) { // code = "000001.SH"
                code = codes[i]
                p = {"ts_code":code,"start_date":startDate,"end_date":endDate}
                res = getApiData(token, api, p, cols)
                if(!res.isVoid() and res.count() != 0){
                    update res set update_time = now()
                    replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                    replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
                    replaceColumn!(res, "close", double(res.close))
                    replaceColumn!(res, "open", double(res.open))
                    replaceColumn!(res, "high", double(res.high))
                    replaceColumn!(res, "low", double(res.low))
                    replaceColumn!(res, "pre_close", double(res.pre_close))
                    replaceColumn!(res, "change", double(res.change))
                    replaceColumn!(res, "pct_chg", double(res.pct_chg))
                    replaceColumn!(res, "vol", double(res.vol))
                    replaceColumn!(res, "amount", double(res.amount))
                    replaceColumn!(res, "update_time", timestamp(res.update_time))
                    out.append!(res)
                    print("sucessfuly append data for Table " + api + "for " + code + "(" + market+"," + i + "/" + len + ")" + " startDate = " + startDate + " endDate = " + endDate)
                } else {
                    print("no data for Table " + api + "for " + code + "(" + market+"," + i + "/" + len + ")" + " startDate = " + startDate + " endDate = " + endDate)
                }
            }
        }
    }
    print("Success append data for Table " + api )
}

