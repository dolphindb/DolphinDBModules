/*
*  @FunctionName: createTableDailyInfo
*  @Brief: Create a DFS table for 市场交易统计
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableDailyInfo()
*/
def createTableDailyInfo(){
    dbName = "dfs://tushare_daily_db"
    tbName = "daily_info"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(DATE, 0) as trade_date,          // 交易日期
            array(SYMBOL, 0) as ts_code,           // 市场代码
            array(STRING, 0) as ts_name,           // 市场名称
            array(INT, 0) as com_count,            // 挂牌数
            array(DOUBLE, 0) as total_share,       // 总股本（亿股）
            array(DOUBLE, 0) as float_share,       // 流通股本（亿股）
            array(DOUBLE, 0) as total_mv,          // 总市值（亿元）
            array(DOUBLE, 0) as float_mv,          // 流通市值（亿元）
            array(DOUBLE, 0) as amount,            // 交易金额（亿元）
            array(DOUBLE, 0) as vol,               // 成交量（亿股）
            array(INT, 0) as trans_count,          // 成交笔数（万笔）
            array(DOUBLE, 0) as pe,                // 平均市盈率
            array(DOUBLE, 0) as tr,                // 换手率（％）
            array(SYMBOL, 0) as exchange,          // 交易所（SH上交所 SZ深交所）
            array(TIMESTAMP, 0) as update_time     // 更新时间
        )
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = "trade_date"
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["trade_date"] = "交易日期"
        columnComments["ts_code"] = "市场代码"
        columnComments["ts_name"] = "市场名称"
        columnComments["com_count"] = "挂牌数"
        columnComments["total_share"] = "总股本（亿股）"
        columnComments["float_share"] = "流通股本（亿股）"
