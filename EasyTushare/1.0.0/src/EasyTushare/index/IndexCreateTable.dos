/*
*  @FunctionName: createTableIndexBasic
*  @Brief: Create a DFS table for 指数基本信息
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableIndexBasic()
*/
def createTableIndexBasic(){
    dbName = "dfs://tushare_basic_db"
    tbName = "index_basic"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as security_id,              // TS代码
            array(STRING, 0) as name,              // 简称
            array(STRING, 0) as fullname,          // 指数全称
            array(SYMBOL, 0) as market,            // 市场
            array(SYMBOL, 0) as publisher,         // 发布方
            array(SYMBOL, 0) as index_type,        // 指数风格
            array(SYMBOL, 0) as category,          // 指数类别
            array(DATE, 0) as base_date,           // 基期
            array(DOUBLE, 0) as base_point,        // 基点
            array(DATE, 0) as list_date,           // 发布日期
            array(STRING, 0) as weight_rule,       // 加权方式
            array(STRING, 0) as desc,              // 描述
            array(DATE, 0) as exp_date,            // 终止日期
            array(TIMESTAMP, 0) as update_time     // 更新时间
        )
        db.createTable(
            table = schemaTB,
            tableName = tbName
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "TS代码"
        columnComments["name"] = "简称"
        columnComments["fullname"] = "指数全称"
        columnComments["market"] = "市场"
        columnComments["publisher"] = "发布方"
        columnComments["index_type"] = "指数风格"
        columnComments["category"] = "指数类别"
        columnComments["base_date"] = "基期"
        columnComments["base_point"] = "基点"
        columnComments["list_date"] = "发布日期"
        columnComments["weight_rule"] = "加权方式"
        columnComments["desc"] = "描述"
        columnComments["exp_date"] = "终止日期"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

