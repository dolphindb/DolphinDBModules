/*
*  @FunctionName: createTableIndexDaily
*  @Brief: Create a DFS table for 指数日线行情
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableIndexDaily()
*/
def createTableIndexDaily(){
    dbName = "dfs://tushare_daily_db"
    tbName = "index_daily"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as security_id,            // TS指数代码
            array(DATE, 0) as trade_date,           // 交易日
            array(DOUBLE, 0) as close,              // 收盘点位
            array(DOUBLE, 0) as open,               // 开盘点位
            array(DOUBLE, 0) as high,               // 最高点位
            array(DOUBLE, 0) as low,                // 最低点位
            array(DOUBLE, 0) as pre_close,          // 昨日收盘点
            array(DOUBLE, 0) as change,             // 涨跌点
            array(DOUBLE, 0) as pct_chg,            // 涨跌幅（%）
            array(DOUBLE, 0) as vol,                // 成交量（手）
            array(DOUBLE, 0) as amount,              // 成交额（千元）
            array(TIMESTAMP, 0) as update_time
        )
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = "trade_date"
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "TS指数代码"
        columnComments["trade_date"] = "交易日"
        columnComments["close"] = "收盘点位"
        columnComments["open"] = "开盘点位"
        columnComments["high"] = "最高点位"
        columnComments["low"] = "最低点位"
        columnComments["pre_close"] = "昨日收盘点"
        columnComments["change"] = "涨跌点"
        columnComments["pct_chg"] = "涨跌幅（%）"
        columnComments["vol"] = "成交量（手）"
        columnComments["amount"] = "成交额（千元）"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

