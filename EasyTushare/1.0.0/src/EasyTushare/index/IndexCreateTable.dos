            array(DOUBLE, 0) as open,              // 开盘点位
            array(DOUBLE, 0) as high,              // 最高点位
            array(DOUBLE, 0) as low,               // 最低点位
            array(DOUBLE, 0) as pre_close,         // 昨日收盘点
            array(DOUBLE, 0) as change,            // 涨跌点位
