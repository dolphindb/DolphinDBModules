/*
 * @Description: Tushare API shibor_quote data import
 * @DolphinDB server version:
 * @Last modification time: 2026-04-02 16:00:00
 * @dev:
 * @Author: codex
 */
def appendShiborQuote(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "shibor_quote"
    api = "shibor_quote"
    cols = [
        "date",
        "bank",
        "on_b",
        "on_a",
        "1w_b",
        "1w_a",
        "2w_b",
        "2w_a",
        "1m_b",
        "1m_a",
        "3m_b",
        "3m_a",
        "6m_b",
        "6m_a",
        "9m_b",
        "9m_a",
        "1y_b",
        "1y_a"
    ]
    ddbCols = [
        "date",
        "bank",
        "on_b",
        "on_a",
        "w_b1",
        "w_a1",
        "w_b2",
        "w_a2",
        "m_b1",
        "m_a1",
        "m_b3",
        "m_a3",
        "m_b6",
        "m_a6",
        "m_b9",
        "m_a9",
        "y_b1",
        "y_a1"
    ]
    out = loadTable(dbPath, tableName)

     // 处理时间范围，每个股票一年读取一次
    days = start_date..end_date
    monthBeginDays = monthBegin(days).distinct().sort!()
    for (oneDate in days){  
        // oneDate = monthBeginDays[10]
        startDateStr =  temporalFormat(max(oneDate, start_date), "yyyyMMdd")
        endDateStr = temporalFormat(min(yearEnd(oneDate), end_date), "yyyyMMdd")
        p = {start_date:startDateStr, end_date:endDateStr}
        logRange = startDateStr + " -> " + endDateStr
        delete from out where trade_date in  [max(oneDate, start_date), min(yearEnd(oneDate), end_date)]

        res = getApiData(token, api, p, cols, ddbCols)
        if(res.count()==4000){
            throw("API " + api + " for range: " + logRange + " reaches the limit of 4000 records, please narrow down the date range and try again.")
        }
        if(!res.isVoid() and res.count() != 0){
            update res set update_time = now()
            replaceColumn!(res, "date", temporalParse(string(res["date"]), "yyyyMMdd"))
            replaceColumn!(res, "bank", symbol(string(res["bank"])))
            replaceColumn!(res, "on_b", double(res["on_b"]))
            replaceColumn!(res, "on_a", double(res["on_a"]))
            replaceColumn!(res, "w_b1", double(res["w_b1"]))
            replaceColumn!(res, "w_a1", double(res["w_a1"]))
            replaceColumn!(res, "w_b2", double(res["w_b2"]))
            replaceColumn!(res, "w_a2", double(res["w_a2"]))
            replaceColumn!(res, "m_b1", double(res["m_b1"]))
            replaceColumn!(res, "m_a1", double(res["m_a1"]))
            replaceColumn!(res, "m_b3", double(res["m_b3"]))
            replaceColumn!(res, "m_a3", double(res["m_a3"]))
            replaceColumn!(res, "m_b6", double(res["m_b6"]))
            replaceColumn!(res, "m_a6", double(res["m_a6"]))
            replaceColumn!(res, "m_b9", double(res["m_b9"]))
            replaceColumn!(res, "m_a9", double(res["m_a9"]))
            replaceColumn!(res, "y_b1", double(res["y_b1"]))
            replaceColumn!(res, "y_a1", double(res["y_a1"]))
            replaceColumn!(res, "update_time", timestamp(res["update_time"]))
            out.append!(res)
            print("Success append data for Table " + api + " for range: " + logRange)
        } else {
            print("no data for Table " + api + " for range: " + logRange)
        }
    }
}

