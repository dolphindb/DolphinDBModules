        }

        if(!res.isVoid() and res.count() != 0){
            update res set update_time = now()
            replaceColumn!(res, "date", temporalParse(string(res["date"]), "yyyyMMdd"))
            replaceColumn!(res, "ltc", double(res["ltc"]))
            replaceColumn!(res, "cmt", double(res["cmt"]))
            replaceColumn!(res, "e_factor", double(res["e_factor"]))
            replaceColumn!(res, "update_time", timestamp(res["update_time"]))
            out.append!(res)
            print("Success append data for Table " + api + " for range: " + logRange)
        } else {
            print("no data for Table " + api + " for range: " + logRange)
        }
    }
}

/*
 * @Description: Tushare API us_trltr data import
 * @DolphinDB server version:
 * @Last modification time: 2026-04-02 16:00:00
 * @dev:
 * @Author: codex
 */
def appendUsTrltr(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "us_trltr"
    api = "us_trltr"
    cols = [
        "date",
        "ltr_avg"
    ]
    out = loadTable(dbPath, tableName)
     // 处理时间范围，每个股票一年读取一次
    days = start_date..end_date
    yearBeginDays = yearBegin(days).distinct().sort!()
    for (oneDate in yearBeginDays){  
        // oneDate = yearBeginDays[10]

        delete from out where trade_date in  [max(oneDate, start_date), min(yearEnd(oneDate), end_date)]
        startDateStr =  temporalFormat(max(oneDate, start_date), "yyyyMMdd")
        endDateStr = temporalFormat(min(yearEnd(oneDate), end_date), "yyyyMMdd")
        // startDateStr = "20260901"
        // endDateStr = "20260902"
        p = {start_date:startDateStr, end_date:endDateStr}
        logRange = startDateStr + " -> " + endDateStr

        res = getApiData(token, api, p, cols)
        if(res.count()==2000){
            throw("API " + api + " for range: " + logRange + " reaches the limit of 4000 records, please narrow down the date range and try again.")
        }

        res = getApiData(token, api, p, cols)
        if(!res.isVoid() and res.count() != 0){
            update res set update_time = now()
            replaceColumn!(res, "date", temporalParse(string(res["date"]), "yyyyMMdd"))
            replaceColumn!(res, "ltr_avg", double(res["ltr_avg"]))
            replaceColumn!(res, "update_time", timestamp(res["update_time"]))
            out.append!(res)
            print("Success append data for Table " + api + " for range: " + logRange)
        } else {
            print("no data for Table " + api + " for range: " + logRange)
        }

        sleep(200)
    }
}
