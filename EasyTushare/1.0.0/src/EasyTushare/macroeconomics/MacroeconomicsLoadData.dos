/*
 * @Description: Tushare API us_tycr data import
 * @DolphinDB server version:
 * @Last modification time: 2026-04-02 16:00:00
 * @dev:
 * @Author: codex
 */
def appendUsTycr(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "us_tycr"
    api = "us_tycr"
    cols = [
        "date",
        "m1",
        "m2",
        "m3",
        "m4",
        "m6",
        "y1",
        "y2",
        "y3",
        "y5",
        "y7",
        "y10",
        "y20",
        "y30"
    ]
    out = loadTable(dbPath, tableName)
    // select count(*) from loadTable(dbPath, tableName) group by trade_date order by trade_date desc 
    days = start_date..end_date
    yearBeginDays = yearBegin(days).distinct().sort!()
    for (oneDate in yearBeginDays){ 
        // oneDate = yearBeginDays[1]
        delete from out where trade_date in  [max(oneDate, start_date), min(yearEnd(oneDate), end_date)]

        startDateStr =  temporalFormat(max(oneDate, start_date), "yyyyMMdd")
        endDateStr = temporalFormat(min(yearEnd(oneDate), end_date), "yyyyMMdd")
        // startDateStr = "20260901"
        // endDateStr = "20260902"
        p = {start_date:startDateStr, end_date:endDateStr}
        logRange = startDateStr + " -> " + endDateStr
        delete from out where trade_date in  [max(oneDate, start_date), min(yearEnd(oneDate), end_date)]
        
        res = getApiData(token, api, p, cols)
        
        if(res.count() == 2000){
            print("Warning: data count reaches 4000 for Table " + api + " for range: " + logRange + ", consider to reduce the date range for more complete data")
        }

        if(!res.isVoid() and res.count() != 0){
            update res set update_time = now()
            replaceColumn!(res, "date", temporalParse(string(res["date"]), "yyyyMMdd"))
            replaceColumn!(res, "m1", double(res["m1"]))
            replaceColumn!(res, "m2", double(res["m2"]))
            replaceColumn!(res, "m3", double(res["m3"]))
            replaceColumn!(res, "m6", double(res["m6"]))
            replaceColumn!(res, "y1", double(res["y1"]))
            replaceColumn!(res, "y2", double(res["y2"]))
            replaceColumn!(res, "y3", double(res["y3"]))
            replaceColumn!(res, "y5", double(res["y5"]))
            replaceColumn!(res, "y7", double(res["y7"]))
            replaceColumn!(res, "y10", double(res["y10"]))
            replaceColumn!(res, "y20", double(res["y20"]))
            replaceColumn!(res, "y30", double(res["y30"]))
            replaceColumn!(res, "update_time", timestamp(res["update_time"]))
            if(!in("m4", res.columnNames())){
                res["m4"] = NULL$double
            }
            out.append!(res.reorderColumns!(["date","m1","m2","m3","m4","m6","y1","y2","y3","y5","y7","y10","y20","y30","update_time"]))
            print("Success append data for Table " + api + " for range: " + logRange)
        } else {
            print("no data for Table " + api + " for range: " + logRange)
        }
    }
}

