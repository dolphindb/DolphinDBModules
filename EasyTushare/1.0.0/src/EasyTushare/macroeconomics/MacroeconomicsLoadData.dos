/*
 * @Description: Tushare API cn_gdp data import
 * @DolphinDB server version:
 * @Last modification time: 2026-04-02 16:00:00
 * @dev:
 * @Author: codex
 */
def appendCnGdp(token, start_date, end_date){
    dbPath = "dfs://tushare_basic_db"
    tableName = "cn_gdp"
    api = "cn_gdp"
    cols = [
        "quarter",
        "gdp",
        "gdp_yoy",
        "pi",
        "pi_yoy",
        "si",
        "si_yoy",
        "ti",
        "ti_yoy"
    ]
    out = loadTable(dbPath, tableName)

    // 每天全量导入，所以 startYear 固定为2000， 总数据量大致为245条
    startYear = temporalFormat(2000.01.01, "yyyy")
    endYear = temporalFormat(end_date, "yyyy")
    startMonthNum = int(temporalFormat(start_date, "MM"))
    endMonthNum = int(temporalFormat(end_date, "MM"))
    startQuarter = startYear + "Q" + string(int((startMonthNum - 1) / 3) + 1)
    endQuarter = endYear + "Q" + string(int((endMonthNum - 1) / 3) + 1)
    p = {start_q:startQuarter, end_q:endQuarter}
    logRange = startQuarter + " -> " + endQuarter

    delete from out 

    res = getApiData(token, api, p, cols)
    if(!res.isVoid() and res.count() != 0){
        update res set update_time = now()
        replaceColumn!(res, "quarter", string(res["quarter"]))
        replaceColumn!(res, "gdp", double(res["gdp"]))
        replaceColumn!(res, "gdp_yoy", double(res["gdp_yoy"]))
        replaceColumn!(res, "pi", double(res["pi"]))
        replaceColumn!(res, "pi_yoy", double(res["pi_yoy"]))
        replaceColumn!(res, "si", double(res["si"]))
        replaceColumn!(res, "si_yoy", double(res["si_yoy"]))
        replaceColumn!(res, "ti", double(res["ti"]))
        replaceColumn!(res, "ti_yoy", double(res["ti_yoy"]))
        replaceColumn!(res, "update_time", timestamp(res["update_time"]))
        out.append!(res)
        print("Success append data for Table " + api + " for range: " + logRange)
    } else {
        print("no data for Table " + api + " for range: " + logRange)
    }
}

