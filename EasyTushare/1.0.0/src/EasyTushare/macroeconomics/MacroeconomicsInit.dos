module EasyTushare::macroeconomics::MacroeconomicsInit
use EasyTushare::TsInit

/* 
*  @Brief: 宏观经济历史数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use EasyTushare::macroeconomics::MacroeconomicsCreateTable

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: llm_init
*  @Brief: 初始化数据库表
*  @Param: None
*  @Return: None
*  @SampleUsage: macroeconomicsInitTables()
*/
def macroeconomicsInitTables(table_names = []){
    if (size(table_names) == 0){
       ts_create_tables = exec name from defs() where name like "EasyTushare::macroeconomics::MacroeconomicsCreateTable%"
        for(table in ts_create_tables){
            try{
                funcByName(table)()
            }
            catch(ex){
                print(table)
                print(ex)
            }
            
        }
    } else {
        for (table_name in table_names){ 
            try{
                funcByName("EasyTushare::macroeconomics::MacroeconomicsCreateTable::createTable" + snakeToUpperCamel(table_name))()
            }
            catch(ex){
                print(table_name)
                print(ex)
            }
        }   
    }
}
use EasyTushare::macroeconomics::MacroeconomicsLoadData
/**
*  @FunctionName: getMacroeconomicsTableNames
*  @Brief: 获取宏观经济数据导入函数表名
*  @Param: None
*  @Return: list
*  @SampleUsage: getMacroeconomicsTableNames()
 */
def macroeconomicsGetAllTableNames(){
    ts_create_tables = exec name from defs() where name like "EasyTushare::macroeconomics::MacroeconomicsLoadData::append%"
    return each(upperCamelToSnake, ts_create_tables.split("::")[3].substr(6))
}
/*
*  @FunctionName: macroeconomicsHistoryDataLoad
*  @Brief: 宏观经济历史数据导入函数
*  @Param: token, start_date, end_date
*  @Return: None
*  @SampleUsage: macroeconomicsHistoryDataLoad(token,start_date,end_date)
*/
def macroeconomicsHistoryDataLoad(token,start_date,end_date,table_names = []) {
    // 本次需要导入的所有表名
    all_table_names = []
    if (size(table_names) == 0){
        all_table_names = macroeconomicsGetAllTableNames()        
    } else {
        all_table_names = table_names
    }
    for (table_name in all_table_names){
        submitJob("append_" + table_name, "append_" + table_name,  funcByName("EasyTushare::macroeconomics::MacroeconomicsLoadData::append" + snakeToUpperCamel(table_name)), token, start_date, end_date)
    }
}
