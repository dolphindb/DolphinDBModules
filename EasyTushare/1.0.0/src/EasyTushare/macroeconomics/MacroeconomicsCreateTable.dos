/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}
/*
*  @FunctionName: createTableShibor
*  @Brief: Create a DFS table for Tushare API shibor
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableShibor()
*/
def createTableShibor(){
    dbName = "dfs://tushare_daily_db"
    tbName = "shibor"
    if(existsDatabase(dbName)){
        db = database(dbName)
        schemaTB = table(1:0, `trade_date`on`w1`w2`m1`m3`m6`m9`y1`update_time, [DATE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,TIMESTAMP])
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = "trade_date"
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["trade_date"] = "date"
        columnComments["on"] = "on"
        columnComments["w1"] = "1w"
        columnComments["w2"] = "2w"
        columnComments["m1"] = "1m"
        columnComments["m3"] = "3m"
        columnComments["m6"] = "6m"
        columnComments["m9"] = "9m"
        columnComments["y1"] = "1y"
        columnComments["update_time"] = "update time"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

