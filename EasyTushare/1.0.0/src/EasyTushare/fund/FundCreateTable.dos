        columnComments["dmi_mdi_bfq"] = "动向指标"
        columnComments["dmi_pdi_bfq"] = "动向指标"
        columnComments["downdays"] = "连跌天数"
        columnComments["updays"] = "连涨天数"
        columnComments["dpo_bfq"] = "区间震荡线"
