def appendFundPortfolio(token, start_date1, end_date1){
    dbPath = "dfs://tushare_daily_db"
    tableName = "fund_portfolio"
    api = "fund_portfolio"
    cols = ["ts_code","ann_date","end_date","symbol","mkv","amount","stk_mkv_ratio","stk_float_ratio"]
    out = loadTable(dbPath, tableName)
    delete from out where ann_date >= start_date1 and ann_date <= end_date1

    dts = start_date1..end_date1
    for(oneDate in dts){
        // oneDate = 2026.03.31
        dateStr = temporalFormat(oneDate, "yyyyMMdd")
        offset_ = 0 
        prev_count_ = 0
        do{
            p = {"offset":offset_,"ann_date": dateStr}
            res = getApiData(token, api, p, cols)
            cur_count_ = res.count()
            if(cur_count_ != 0){
                update res set update_time = now()

                replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                replaceColumn!(res, "ann_date", temporalParse(string(res.ann_date), "yyyyMMdd"))
                replaceColumn!(res, "end_date", temporalParse(string(res.end_date), "yyyyMMdd"))
                replaceColumn!(res, "symbol", symbol(string(res.symbol)))
                replaceColumn!(res, "mkv", double(res.mkv))
                replaceColumn!(res, "amount", double(res.amount))
                replaceColumn!(res, "stk_mkv_ratio", double(res.stk_mkv_ratio))
                replaceColumn!(res, "stk_float_ratio", double(res.stk_float_ratio))
                replaceColumn!(res, "update_time", timestamp(res.update_time))
                
                // 重命名 ts_code 为 code
                rename!(res, "ts_code", "code")
                
                out.append!(res)
                offset_ = prev_count_ + cur_count_ + 1
                prev_count_ = prev_count_ + cur_count_
            }
        }while(res.count() != 0)
        print("Success append data for Table " + api + " for date: " + dateStr)
    }
    print("Success append data for Table " + api)
}


/*
 * @Description: 基金规模数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-24 10:52:57
 * @dev: 
 * @Author: tanhua
 */
def appendFundShare(token, start_date1, end_date1){
    dbPath = "dfs://tushare_daily_db"
    tableName = "fund_share"
    api = "fund_share"
    cols = ["ts_code","trade_date","fd_share"]
    out = loadTable(dbPath, tableName)
    delete from out where trade_date >= start_date1 and trade_date <= end_date1
    dts = start_date1..end_date1
    for(oneDate in dts){
        dateStr = temporalFormat(oneDate, "yyyyMMdd")
        codes = getFundCodes(token)
        codes_lists = codes.cut(codes.size()/2000 + 1)

        for(code_list in codes_lists){
            // code_list = codes_lists[0]
            p = {"trade_date": dateStr,"ts_code":string(code_list.toStdJson()).strReplace("[","").strReplace("]","").strReplace("\"","")}
            res = getApiData(token, api, p, cols)
            if (!res.isVoid() and res.count() !=0){
            
                update res set update_time = now()

                replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
                replaceColumn!(res, "fd_share", double(res.fd_share))
                replaceColumn!(res, "update_time", timestamp(res.update_time))
                
                // 重命名 ts_code 为 code
                rename!(res, "ts_code", "code")
                
                out.append!(res)
            } 
        }
        print("Success append data for Table " + api + " for date: " + dateStr)
    }
}


/*
 * @Description: 基金规模数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-24 10:52:57
 * @dev: 
 * @Author: tanhua
 */
def appendMktIdxBmk(token, start_date1, end_date1){
    dbPath = "dfs://tushare_basic_db"
    tableName = "mkt_idx_bmk"
    api = "mkt_idx_bmk"
    cols = ["ts_code","symbol","name","fullname","bmk_level","bmk_type","bmk_src","idx_type"]
    out = loadTable(dbPath, tableName)
    truncate(dbPath,tableName)
    // bmk_levels = ["一类库","二类库"] 
    bmk_levels = ["一类库"] 
    for(one_bmk_level in bmk_levels){ // one_bmk_level = "二类库"
       
        p = {"bmk_levels": one_bmk_level}
        // p = {"ts_code":"000097.SH"}
        res = getApiData(token, api, p, cols)
        // res2 = getApiData(token, api, p, cols)
        if (!res.isVoid() and res.count() !=0){
            
            update res set update_time = now()
            
            // 重命名 ts_code 为 code
            rename!(res, "ts_code", "security_id")
            
            out.append!(res)
            print("Success append data for Table " + api+ " for " + one_bmk_level)
        } else {
            print("no data for Table " + api + " for " + one_bmk_level)
        }
    }
    print("Success append data for Table " + api)
}
