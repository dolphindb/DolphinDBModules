/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

def getFundCodes(token){
    api = "fund_basic"
    cols = ["ts_code"]
    
    p = {}
    res = getApiData(token, api, p, cols)

    offset = 1
    do{
        offset = 15000 + offset
        p = {"offset":offset}
        tmp = getApiData(token, api, p, cols)
        if(tmp.count() != 0){
            res.append!(tmp)
        }
    }while(tmp.count() != 0)
    return res["ts_code"]
}



/*
 * @Description: 公募基金列表数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-24 10:52:57
 * @dev: 
 * @Author: tanhua
 */
def appendFundBasic(token, start_date1, end_date1){
    dbPath = "dfs://tushare_basic_db"
    tableName = "fund_basic"
    api = "fund_basic"
    cols = ["ts_code","name","management","custodian","fund_type","found_date","due_date","list_date","issue_date","delist_date","issue_amount","m_fee","c_fee","duration_year","p_value","min_amount","exp_return","benchmark","status","invest_type","type","trustee","purc_startdate","redm_startdate","market"]
    out = loadTable(dbPath, tableName)
    count_ = 0
    p = {}
    res = getApiData(token, api, p, cols)
    offset = 1
    do{
        offset = 15000 + offset
        print("fetch data from offset: " + string(offset))
        p = {"offset":offset}
        tmp = getApiData(token, api, p, cols)
        if(tmp.count() != 0){
            res.append!(tmp)
        }
    }while(tmp.count() != 0)


    if (!res.isVoid() and res.count() !=0){
        
        update res set update_time = now()
        replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
        replaceColumn!(res, "name", string(res.name))
        replaceColumn!(res, "management", string(res.management))
        replaceColumn!(res, "custodian", string(res.custodian))
        replaceColumn!(res, "fund_type", string(res.fund_type))
        replaceColumn!(res, "found_date", temporalParse(string(res.found_date), "yyyyMMdd"))
        replaceColumn!(res, "due_date", temporalParse(string(res.due_date), "yyyyMMdd"))
        replaceColumn!(res, "list_date", temporalParse(string(res.list_date), "yyyyMMdd"))
        replaceColumn!(res, "issue_date", temporalParse(string(res.issue_date), "yyyyMMdd"))
        replaceColumn!(res, "delist_date", temporalParse(string(res.delist_date), "yyyyMMdd"))
        replaceColumn!(res, "issue_amount", double(res.issue_amount))
        replaceColumn!(res, "m_fee", double(res.m_fee))
        replaceColumn!(res, "c_fee", double(res.c_fee))
        replaceColumn!(res, "duration_year", double(res.duration_year))
        replaceColumn!(res, "p_value", double(res.p_value))
        replaceColumn!(res, "min_amount", double(res.min_amount))
        replaceColumn!(res, "exp_return", double(res.exp_return))
        replaceColumn!(res, "benchmark", string(res.benchmark))
        replaceColumn!(res, "status", symbol(string(res.status)))
        replaceColumn!(res, "invest_type", string(res.invest_type))
        replaceColumn!(res, "type", string(res.type))
        replaceColumn!(res, "trustee", string(res.trustee))
        replaceColumn!(res, "purc_startdate", temporalParse(string(res.purc_startdate), "yyyyMMdd"))
        replaceColumn!(res, "redm_startdate", temporalParse(string(res.redm_startdate), "yyyyMMdd"))
        replaceColumn!(res, "market", symbol(string(res.market)))
        replaceColumn!(res, "update_time", timestamp(res.update_time))
        
        // 重命名 ts_code 为 code
        rename!(res, "ts_code", "code")
        delete from out 
        out.append!(res)
        print("Success append data for Table " + api)
    } else {
        print("no data for Table " + api)
    }
    print("Success append data for Table " + api)
}

/*
