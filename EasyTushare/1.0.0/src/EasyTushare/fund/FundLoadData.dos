def appendFundCompany(token, start_date1, end_date1){
    dbPath = "dfs://tushare_basic_db"
    tableName = "fund_company"
    api = "fund_company"
    cols = ["name","shortname","short_enname","province","city","address","phone","office","website","chairman","manager","reg_capital","setup_date","end_date","employees","main_business","org_code","credit_code"]
    out = loadTable(dbPath, tableName)
    
    p = {}
    res = getApiData(token, api, p, cols)

    if (!res.isVoid() and res.count() !=0){
        
        update res set update_time = now()

        replaceColumn!(res, "name", string(res.name))
        replaceColumn!(res, "shortname", string(res.shortname))
        replaceColumn!(res, "short_enname", string(res.short_enname))
        replaceColumn!(res, "province", string(res.province))
        replaceColumn!(res, "city", string(res.city))
        replaceColumn!(res, "address", string(res.address))
        replaceColumn!(res, "phone", string(res.phone))
        replaceColumn!(res, "office", string(res.office))
        replaceColumn!(res, "website", string(res.website))
        replaceColumn!(res, "chairman", string(res.chairman))
        replaceColumn!(res, "manager", string(res.manager))
        replaceColumn!(res, "reg_capital", double(res.reg_capital))
        replaceColumn!(res, "setup_date", temporalParse(string(res.setup_date), "yyyyMMdd"))
        replaceColumn!(res, "end_date", temporalParse(string(res.end_date), "yyyyMMdd"))
        replaceColumn!(res, "employees", double(res.employees))
        replaceColumn!(res, "main_business", string(res.main_business))
        replaceColumn!(res, "org_code", string(res.org_code))
        replaceColumn!(res, "credit_code", string(res.credit_code))
        replaceColumn!(res, "update_time", timestamp(res.update_time))
        delete from out
        out.append!(res)
        print("Success append data for Table " + api)
    } else {
        print("no data for Table " + api)
    }
    print("Success append data for Table " + api)
}


/*
 * @Description: 公募基金分红数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-24 10:52:57
 * @dev: 
 * @Author: tanhua
 */
def appendFundDiv(token, start_date1, end_date1){
    dbPath = "dfs://tushare_basic_db"
    tableName = "fund_div"
    api = "fund_div"
    cols = ["ts_code","ann_date","imp_anndate","base_date","div_proc","record_date","ex_date","pay_date","earpay_date","net_ex_date","div_cash","base_unit","ear_distr","ear_amount","account_date","base_year"]
    out = loadTable(dbPath, tableName)
    
    dts = start_date1..end_date1

    delete from out where ann_date >= start_date1 and ann_date <= end_date1
    for(oneDate in dts){
        // oneDate = dts[0]
        dateStr = temporalFormat(oneDate, "yyyyMMdd")
        // dateStr = "20181220"
        p = {"ann_date": dateStr} // 2002.06.20
        res = getApiData(token, api, p, cols)

        if (!res.isVoid() and res.count() !=0){
            
            update res set update_time = now()

            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "ann_date", temporalParse(string(res.ann_date), "yyyyMMdd"))
            replaceColumn!(res, "imp_anndate", temporalParse(string(res.imp_anndate), "yyyyMMdd"))
            replaceColumn!(res, "base_date", temporalParse(string(res.base_date), "yyyyMMdd"))
            replaceColumn!(res, "div_proc", string(res.div_proc))
            replaceColumn!(res, "record_date", temporalParse(string(res.record_date), "yyyyMMdd"))
            replaceColumn!(res, "ex_date", temporalParse(string(res.ex_date), "yyyyMMdd"))
            replaceColumn!(res, "pay_date", temporalParse(string(res.pay_date), "yyyyMMdd"))
            replaceColumn!(res, "earpay_date", temporalParse(string(res.earpay_date), "yyyyMMdd"))
            replaceColumn!(res, "net_ex_date", temporalParse(string(res.net_ex_date), "yyyyMMdd"))
            replaceColumn!(res, "div_cash", double(res.div_cash))
            replaceColumn!(res, "base_unit", double(res.base_unit))
            replaceColumn!(res, "ear_distr", double(res.ear_distr))
            replaceColumn!(res, "ear_amount", double(res.ear_amount))
            replaceColumn!(res, "account_date", temporalParse(string(res.account_date), "yyyyMMdd"))
            replaceColumn!(res, "base_year", string(res.base_year))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            
            // 重命名 ts_code 为 code
            rename!(res, "ts_code", "code")
            
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateStr)
        } else {
            print("no data for Table " + api + " for date: " + dateStr)
        }
    }
    print("Success append data for Table " + api)
}

