/*
 * @Description: 基金经理数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-24 10:52:57
 * @dev: 
 * @Author: tanhua
 */
def appendFundManager(token, start_date1, end_date1){
    dbPath = "dfs://tushare_basic_db"
    tableName = "fund_manager"
    api = "fund_manager"
    cols = ["ts_code","ann_date","name","gender","birth_year","edu","nationality","begin_date","end_date","resume"]
    out = loadTable(dbPath, tableName)

    delete from out 
    
    p = {}
    res = getApiData(token, api, p, cols)

    offset = 1
    do{
        offset = 5000 + offset
        p = {"offset":offset}
        tmp = getApiData(token, api, p, cols)
        if(tmp.count() != 0){
            res.append!(tmp)
        }
    }while(tmp.count() != 0)

    if (!res.isVoid() and res.count() !=0){  
        update res set update_time = now()

        replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
        replaceColumn!(res, "ann_date", temporalParse(string(res.ann_date), "yyyyMMdd"))
        replaceColumn!(res, "name", string(res.name))
        replaceColumn!(res, "gender", string(res.gender))
        replaceColumn!(res, "birth_year", string(res.birth_year))
        replaceColumn!(res, "edu", string(res.edu))
        replaceColumn!(res, "nationality", string(res.nationality))
        replaceColumn!(res, "begin_date", temporalParse(string(res.begin_date), "yyyyMMdd"))
        replaceColumn!(res, "end_date", temporalParse(string(res.end_date), "yyyyMMdd"))
        replaceColumn!(res, "resume", string(res.resume))
        replaceColumn!(res, "update_time", timestamp(res.update_time))
        
        // 重命名 ts_code 为 code
        rename!(res, "ts_code", "code")
        
        out.append!(res)
        print("Success append data for Table " + api)
    } else {
        print("no data for Table " + api )
    }

    print("Success append data for Table " + api)
}

/*
 * @Description: 公募基金净值数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-24 10:52:57
 * @dev: 
 * @Author: tanhua
 */
def appendFundNav(token, start_date1, end_date1){
    dbPath = "dfs://tushare_daily_db"
    tableName = "fund_nav"
    api = "fund_nav"
    cols = ["ts_code","ann_date","nav_date","unit_nav","accum_nav","accum_div","net_asset","total_netasset","adj_nav"]
    out = loadTable(dbPath, tableName)
    dts = start_date1..end_date1
    for(oneDate in dts){ // oneDate = 2018.01.01
        delete from out where nav_date = oneDate
        dateStr = temporalFormat(oneDate, "yyyyMMdd")

        offset_ = 0 
        prev_count_ = 0
        do {
            p = {"nav_date": dateStr, "offset":offset_}
            res = getApiData(token, api, p, cols)
            cur_count_= res.count()
            if (cur_count_ !=0){
                update res set update_time = now()
                replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                replaceColumn!(res, "ann_date", temporalParse(string(res.ann_date), "yyyyMMdd"))
                replaceColumn!(res, "nav_date", temporalParse(string(res.nav_date), "yyyyMMdd"))
                replaceColumn!(res, "unit_nav", double(res.unit_nav))
                replaceColumn!(res, "accum_nav", double(res.accum_nav))
                replaceColumn!(res, "accum_div", double(res.accum_div))
                replaceColumn!(res, "net_asset", double(res.net_asset))
                replaceColumn!(res, "total_netasset", double(res.total_netasset))
                replaceColumn!(res, "adj_nav", double(res.adj_nav))
                replaceColumn!(res, "update_time", timestamp(res.update_time))
                
                // 重命名 ts_code 为 code
                rename!(res, "ts_code", "code")
                out.append!(res)
                
                offset_ = prev_count_ + cur_count_ + 1
                prev_count_ = prev_count_ + cur_count_
                print("Success append data for Table " + api + " for date: " + dateStr)
            } 
        } while (cur_count_ != 0)
    }
    print("Success append data for Table " + api)
}

