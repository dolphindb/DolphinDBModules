module EasyTushare::spot::SpotInit
use EasyTushare::TsInit

/* 
*  @Brief: 现货数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use EasyTushare::spot::SpotCreateTable

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: spotInitTables
*  @Brief: 初始化数据库表
*  @Param: None
*  @Return: None
*  @SampleUsage: spotInitTables()
*/
def spotInitTables(table_names = []){
    if (size(table_names) == 0){
       ts_create_tables = exec name from defs() where name like "EasyTushare::spot::SpotCreateTable%"
        for(table in ts_create_tables){
            // table = 'EasyTushare::spot::SpotCreateTable::createTopList'
            funcByName(table)()
        }
    } else {
        for (table_name in table_names){ 
            funcByName("EasyTushare::spot::SpotCreateTable::create" + snakeToUpperCamel(table_name))()
        }
    }
}

use EasyTushare::spot::SpotLoadData
/*
*  @FunctionName: spotGetAllTableNames
*  @Brief: 获取所有现货数据表名
*  @Param: None
*  @Return: list
*  @SampleUsage: spotGetAllTableNames()
*/
def spotGetAllTableNames(){
    ts_create_tables = exec name from defs() where name like "EasyTushare::spot::SpotLoadData::append%"
    return each(upperCamelToSnake, ts_create_tables.split("::")[3].substr(6))
}

/*
*  @FunctionName: spotHistoryDataLoad
*  @Brief: 现货数据导入函数
*  @Param: token, start_date, end_date
*  @Return: None
*  @SampleUsage: spotHistoryDataLoad(token,start_date,end_date)
*/
def spotHistoryDataLoad(token,start_date,end_date,table_names = []) {
    // 本次需要导入的所有表名
    all_table_names = []
    if (size(table_names) == 0){
        all_table_names = spotGetAllTableNames()        
    } else {
        all_table_names = table_names
    }
    for (table_name in all_table_names){ // table_name = "1min_k"
        submitJob("append_" + table_name, "append_" + table_name, funcByName("EasyTushare::spot::SpotLoadData::append" + snakeToUpperCamel(table_name)), token, start_date, end_date)
    }
}

