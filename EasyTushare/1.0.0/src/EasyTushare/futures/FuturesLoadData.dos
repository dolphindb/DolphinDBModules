/*
 * @Description: 期货合约信息表数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-30 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendFutBasic(token, start_date, end_date){
    dbPath = "dfs://tushare_basic_db"
    tableName = "fut_basic"
    // 先truncate
    truncate(dbPath,tableName)
    // 导入数据合约信息表数据
    api = "fut_basic"
    cols = ["ts_code","symbol","exchange","name","fut_code","multiplier","trade_unit","per_unit","quote_unit","quote_unit_desc","d_mode_desc","list_date","delist_date","d_month","last_ddate","trade_time_desc"]
    out = loadTable(dbPath, tableName)
    
    // 遍历所有交易所
    exchanges = ["CFFEX", "DCE", "CZCE", "SHFE", "INE", "GFEX"]
    for(exchange in exchanges){ // exchange = "GFEX"
        p = {"exchange":exchange}
        // p = {"exchange":exchange,"list_date":"20000101"}
        res = getApiData(token, api, p, cols)

        if (!res.isVoid() and res.count() !=0){
            
            update res set update_time = now()

            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "symbol", symbol(string(res.symbol)))
            replaceColumn!(res, "exchange", symbol(string(res.exchange)))
            replaceColumn!(res, "name", string(res.name))
            replaceColumn!(res, "fut_code", symbol(string(res.fut_code)))
            replaceColumn!(res, "multiplier", double(res.multiplier))
            replaceColumn!(res, "trade_unit", string(res.trade_unit))
            replaceColumn!(res, "per_unit", double(res.per_unit))
            replaceColumn!(res, "quote_unit", string(res.quote_unit))
            replaceColumn!(res, "quote_unit_desc", string(res.quote_unit_desc))
            replaceColumn!(res, "d_mode_desc", string(res.d_mode_desc))
            replaceColumn!(res, "list_date", temporalParse(string(res.list_date), "yyyyMMdd"))
            replaceColumn!(res, "delist_date", temporalParse(string(res.delist_date), "yyyyMMdd"))
            replaceColumn!(res, "d_month", string(res.d_month))
            replaceColumn!(res, "last_ddate", temporalParse(string(res.last_ddate), "yyyyMMdd"))
            replaceColumn!(res, "trade_time_desc", string(res.trade_time_desc))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            out.append!(res)
            print("Success append data for Table " + api + " for exchange: " + exchange)
        } else {
            print("no data for Table " + api + " for exchange: " + exchange)
        }     
    }
    print("Success append data for Table " + api)
}

/*
 * @Description: 期货日线行情数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-30 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendFutDaily(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "fut_daily"
    api = "fut_daily"
    cols = ["ts_code","trade_date","pre_close","pre_settle","open","high","low","close","settle","change1","change2","vol","amount","oi","oi_chg","delv_settle"]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where trade_date between start_date and end_date
    dts = getMarketCalendar("SSE", start_date, end_date)
    for(oneDate in dts){ // oneDate = 2026.04.02
        dateStr = temporalFormat(oneDate, "yyyyMMdd")
        p = {"trade_date":dateStr}
        res = getApiData(token, api, p, cols)

        if (!res.isVoid() and res.count() !=0){
            
            update res set update_time = now()
            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "pre_close", double(res.pre_close))
            replaceColumn!(res, "pre_settle", double(res.pre_settle))
            replaceColumn!(res, "open", double(res.open))
            replaceColumn!(res, "high", double(res.high))
            replaceColumn!(res, "low", double(res.low))
            replaceColumn!(res, "close", double(res.close))
            replaceColumn!(res, "settle", double(res.settle))
            replaceColumn!(res, "change1", double(res.change1))
            replaceColumn!(res, "change2", double(res.change2))
            replaceColumn!(res, "vol", double(res.vol))
            replaceColumn!(res, "amount", double(res.amount))
            replaceColumn!(res, "oi", double(res.oi))
            replaceColumn!(res, "oi_chg", double(res.oi_chg))
            replaceColumn!(res, "delv_settle", double(res.delv_settle))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateStr+ "for count: " + res.count())
        } else {
            print("no data for Table " + api + " for date: " + dateStr)
        }     
    }
    print("Success append data for Table " + api)
}


/*
 * @Description: 每日成交持仓排名数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-30 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendFutHolding(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "fut_holding"
    api = "fut_holding"
    cols = ["trade_date","symbol","broker","vol","vol_chg","long_hld","long_chg","short_hld","short_chg","exchange"]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where trade_date between start_date and end_date
    dts = getMarketCalendar("SSE", start_date, end_date)
    market_list = ["CZCE","SHFE","DCE","CFFEX","INE","GFEX"]
    for(oneDate in dts){
        dateStr = temporalFormat(oneDate, "yyyyMMdd")
        for(oneMarket in market_list){ // oneMarket = "GFEX"
            p = {"trade_date":dateStr,"exchange":oneMarket}
            res = getApiData(token, api, p, cols)

            if (!res.isVoid() and res.count() !=0){
                
                update res set update_time = now()
                replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
                replaceColumn!(res, "symbol", symbol(string(res.symbol)))
                replaceColumn!(res, "broker", string(res.broker))
                replaceColumn!(res, "vol", int(res.vol))
                replaceColumn!(res, "vol_chg", int(res.vol_chg))
                replaceColumn!(res, "long_hld", int(res.long_hld))
                replaceColumn!(res, "long_chg", int(res.long_chg))
                replaceColumn!(res, "short_hld", int(res.short_hld))
                replaceColumn!(res, "short_chg", int(res.short_chg))
                replaceColumn!(res, "exchange", symbol(string(res.exchange)))
                replaceColumn!(res, "update_time", timestamp(res.update_time))
                out.append!(res)
                print("Success append data for Table " + api + " for date: " + dateStr + " for exchange: " + oneMarket+ "for count: " + res.count())
            } else {
                print("no data for Table " + api + " for date: " + dateStr + " for exchange: " + oneMarket)
            }     
        }
    }
    print("Success append data for Table " + api)
}

