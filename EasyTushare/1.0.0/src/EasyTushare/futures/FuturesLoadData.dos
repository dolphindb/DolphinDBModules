/*
 * @Description: 南华期货指数日线行情数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-30 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendFutIndexDaily(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "fut_index_daily"
    api = "index_daily"
    cols = ["ts_code","trade_date","close","open","high","low","pre_close","change","pct_chg","vol","amount"]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where trade_date between start_date and end_date

    // days
    days = start_date..end_date
    yearBegins = yearBegin(days).distinct().sort!()

    index_codes = ["NHAI.NH","NHCI.NH","NHECI.NH","NHFI.NH","NHII.NH","NHMI.NH","NHNFI.NH","NHPMI.NH","A.NH","AG.NH","AL.NH","AP.NH","AU.NH","BB.NH","BU.NH","C.NH","CF.NH","CS.NH","CU.NH","CY.NH","ER.NH","FB.NH","FG.NH","FU.NH","HC.NH","I.NH","J.NH","JD.NH","JM.NH","JR.NH","L.NH","LR.NH","M.NH","ME.NH","NI.NH","P.NH","PB.NH","PP.NH","RB.NH","RM.NH","RO.NH","RS.NH","RU.NH","SC.NH","SF.NH","SM.NH","SN.NH","SP.NH","SR.NH","TA.NH","TC.NH","V.NH","WR.NH","WS.NH","Y.NH","ZN.NH"]
    for(oneYear in yearBegins){  // oneYear = 2000.01.01
        startDate = temporalFormat(max(start_date, oneYear), "yyyyMMdd")
        endDate = temporalFormat(min(end_date, yearEnd(oneYear)), "yyyyMMdd")
        for(oneCode in index_codes){ // oneCode = "NHAI.NH"
            p = {"ts_code":oneCode,"start_date":startDate, "end_date":endDate}
            res = getApiData(token, api, p, cols)

            if (!res.isVoid() and res.count() !=0){
                
                update res set update_time = now()
                replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
                replaceColumn!(res, "close", double(res.close))
                replaceColumn!(res, "open", double(res.open))
                replaceColumn!(res, "high", double(res.high))
                replaceColumn!(res, "low", double(res.low))
                replaceColumn!(res, "pre_close", double(res.pre_close))
                replaceColumn!(res, "change", double(res.change))
                replaceColumn!(res, "pct_chg", double(res.pct_chg))
                replaceColumn!(res, "vol", double(res.vol))
                replaceColumn!(res, "amount", double(res.amount))
                replaceColumn!(res, "update_time", timestamp(res.update_time))
                out.append!(res)
                print("Success append data for Table " + tableName + " for " + startDate + " to " + endDate+ " for " + oneCode)
            } else {
                print("no data for Table " + tableName + " for " + startDate + " to " + endDate+ " for " + oneCode)
            }     
        }
    }
    print("Success append data for Table " + tableName)
}

