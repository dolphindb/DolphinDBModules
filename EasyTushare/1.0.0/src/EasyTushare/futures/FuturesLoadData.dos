            replaceColumn!(res, "low", double(res.low))
            replaceColumn!(res, "close", double(res.close))
            replaceColumn!(res, "pre_close", double(res.pre_close))
            replaceColumn!(res, "settle", double(res.settle))
            replaceColumn!(res, "pre_settle", double(res.pre_settle))
            replaceColumn!(res, "vol", double(res.vol))
            replaceColumn!(res, "amount", double(res.amount))
            replaceColumn!(res, "oi", double(res.oi))
            replaceColumn!(res, "oi_chg", double(res.oi_chg))
            replaceColumn!(res, "exchange", symbol(string(res.exchange)))
            replaceColumn!(res, "change1", double(res.change1))
            replaceColumn!(res, "change2", double(res.change2))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            out.append!(res)
            print("Success append data for Table " + tableName + " for date: " + dateStr + "for count: " + res.count())
        } else {
            print("no data for Table " + tableName + " for date: " + dateStr)
        }     
    }
    print("Success append data for Table " + tableName)
}

