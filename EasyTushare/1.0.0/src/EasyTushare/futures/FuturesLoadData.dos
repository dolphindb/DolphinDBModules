/*
 * @Description: 期货主要品种交易周报数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-30 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendFutWeeklyDetail(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "fut_weekly_detail"
    api = "fut_weekly_detail"
    cols = ["exchange","prd","name","vol","vol_yoy","amount","amout_yoy","cumvol","cumvol_yoy","cumamt","cumamt_yoy","open_interest","interest_wow","mc_close","close_wow","week","week_date"]
    out = loadTable(dbPath, tableName)
    
    weeks = string(1..52)
    years = year(start_date)..year(end_date)
    years = years.sort!()
    
    for (oneYear in years){  // oneYear = 2020
        for (oneWeek in weeks){ // oneWeek = "01"
            startWeek = string(oneYear) + oneWeek
            endWeek = string(oneYear) + oneWeek
            // startWeek = '202601'
            // endWeek = '202601'
            p = {"start_week":startWeek, "end_week":endWeek}
            res = getApiData(token, api, p, cols)
            if (res.isVoid() and res.count() ==0) {
                startWeek = string(oneYear) + oneWeek.lpad(2,"0")
                endWeek = string(oneYear) + oneWeek.lpad(2,"0")
                p = {"start_week":startWeek, "end_week":endWeek}
                res = getApiData(token, api, p, cols)
            }

            if (!res.isVoid() and res.count() !=0){
                
                update res set update_time = now()
                replaceColumn!(res, "exchange", symbol(string(res.exchange)))
                replaceColumn!(res, "prd", symbol(string(res.prd)))
                replaceColumn!(res, "name", string(res.name))
                replaceColumn!(res, "vol", int(res.vol))
                replaceColumn!(res, "vol_yoy", double(res.vol_yoy))
                replaceColumn!(res, "amount", double(res.amount))
                replaceColumn!(res, "amout_yoy", double(res.amout_yoy))
                replaceColumn!(res, "cumvol", int(res.cumvol))
                replaceColumn!(res, "cumvol_yoy", double(res.cumvol_yoy))
                replaceColumn!(res, "cumamt", double(res.cumamt))
                replaceColumn!(res, "cumamt_yoy", double(res.cumamt_yoy))
                replaceColumn!(res, "open_interest", int(res.open_interest))
                replaceColumn!(res, "interest_wow", double(res.interest_wow))
                replaceColumn!(res, "mc_close", double(res.mc_close))
                replaceColumn!(res, "close_wow", double(res.close_wow))
                replaceColumn!(res, "week", string(res.week))
                replaceColumn!(res, "week_date", temporalParse(string(res.week_date), "yyyyMMdd"))
                replaceColumn!(res, "update_time", timestamp(res.update_time))

                curentCounts = exec count(*) from out where week = startWeek
                if (curentCounts>0) {
                    delete from out where week = startWeek
                }
                out.append!(res)
                print("Success append data for Table " + api+ " for week: " + startWeek+ "for count: " + res.count())
            } else {
                print("no data for Table " + api+ " for week: " + startWeek)
            }     
        }
    }
}

