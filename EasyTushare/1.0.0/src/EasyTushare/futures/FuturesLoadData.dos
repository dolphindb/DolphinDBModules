module EasyTushare::futures::FuturesLoadData
/* 
*  @Brief: 期货数据单个表导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use EasyTushare::TsInit
/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
 * @Description: 期货合约涨跌停价格（盘前）数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-30 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendFtLimit(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "ft_limit"
    api = "ft_limit"
    cols = ["trade_date","ts_code","name","up_limit","down_limit","m_ratio","cont","exchange"]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where trade_date between start_date and end_date
    dts = getMarketCalendar("SSE", start_date, end_date)
    for(oneDate in dts){ // oneDate = 2026.04.01
        dateStr = temporalFormat(oneDate, "yyyyMMdd")
        p = {"trade_date":dateStr}
        res = getApiData(token, api, p, cols)

        if (!res.isVoid() and res.count() !=0){
            
            update res set update_time = now()
            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "name", string(res.name))
            replaceColumn!(res, "up_limit", double(res.up_limit))
            replaceColumn!(res, "down_limit", double(res.down_limit))
            replaceColumn!(res, "m_ratio", double(res.m_ratio))
            replaceColumn!(res, "cont", symbol(string(res.cont)))
            replaceColumn!(res, "exchange", symbol(string(res.exchange)))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateStr)
        } else {
            print("no data for Table " + api + " for date: " + dateStr)
        }     
    }
    print("Success append data for Table " + api)
}

/*
 * @Description: 期货历史分钟行情数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-30 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendFt1minK(token, start_date, end_date){
    dbPath = "dfs://tushare_minute_db"
    tableName = "fut_1min_k"
    api = "ft_mins"
    cols = ["ts_code","trade_time","open","close","high","low","vol","amount","oi"]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where date(trade_time) between start_date and end_date
    
    days = start_date..end_date
    for (one_date in days){ 
        startDate = one_date-1 
        endDate = one_date

        exchange_list = ["CZCE","SHFE","DCE","CFFEX","INE","GFEX"]
        for (oneMarket in exchange_list){    // oneMarket = "SHFE"
            code_info = getApiData(token, "fut_basic", {"exchange":oneMarket}, ["ts_code","list_date","delist_date"])
            
            replaceColumn!(code_info, "list_date", temporalParse(string(code_info.list_date), "yyyyMMdd"))
            replaceColumn!(code_info, "delist_date", temporalParse(string(code_info.delist_date), "yyyyMMdd"))
            code_list = exec distinct ts_code from code_info where delist_date >= endDate and list_date <= startDate   
            // ts_code = "LC.GFE"
            // 前一天晚上的 21：00 到今天的 19：00点
            startDateTime = temporalFormat(startDate, "yyyy-MM-dd") + " 21:00:00"
            endDateTime = temporalFormat(endDate, "yyyy-MM-dd") + " 19:00:00"
            
            if (size(code_list) > 15) {
                cut_codes = cut(code_list,15)
            } else {
                cut_codes = [code_list]
            }
            if (size(code_list)>0) {
                for (one_batch in cut_codes){ // i = 0
                    one_batch_str = concat(one_batch,",")
                    p = {"ts_code":one_batch_str, "freq":"1min", "start_date":startDateTime, "end_date":endDateTime}
                    res = getApiData(token, api, p, cols)

                    if (!res.isVoid() and res.count() !=0){
                        if (res.count() == 8000) {throw "count is 8000, Exceeded interface return data row limit,please check"}
                        update res set update_time = now()
                        replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                        replaceColumn!(res, "trade_time", timestamp(res.trade_time))
                        replaceColumn!(res, "open", double(res.open))
                        replaceColumn!(res, "close", double(res.close))
                        replaceColumn!(res, "high", double(res.high))
                        replaceColumn!(res, "low", double(res.low))
                        replaceColumn!(res, "vol", int(res.vol))
                        replaceColumn!(res, "amount", double(res.amount))
                        replaceColumn!(res, "oi", double(res.oi))
                        replaceColumn!(res, "update_time", timestamp(res.update_time))
                        out.append!(res)
                        print("Success append data for Table " + tableName + " for " + startDateTime + " to " + endDateTime + " for " + one_batch_str+ ") for count" + res.count())
                    } else {
                        print("no data for Table " + tableName + " for " + startDateTime + " to " + endDateTime + " for " + one_batch_str+ ")")
                    }     
                }
            }
        }
    }
}

