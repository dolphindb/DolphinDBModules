*/
def createTableFutBasic(){
    dbName = "dfs://tushare_basic_db"
    tbName = "fut_basic"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as security_id,               // 合约代码 (原ts_code)
            array(SYMBOL, 0) as base_code,             // 交易标识
            array(SYMBOL, 0) as exchange,            // 交易市场
            array(STRING, 0) as name,                // 中文简称
            array(SYMBOL, 0) as fut_code,            // 合约产品代码
            array(DOUBLE, 0) as multiplier,          // 合约乘数
            array(STRING, 0) as trade_unit,          // 交易计量单位
            array(DOUBLE, 0) as per_unit,            // 交易单位(每手)
            array(STRING, 0) as quote_unit,          // 报价单位
            array(STRING, 0) as quote_unit_desc,     // 最小报价单位说明
            array(STRING, 0) as d_mode_desc,         // 交割方式说明
            array(DATE, 0) as list_date,             // 上市日期
            array(DATE, 0) as delist_date,           // 最后交易日期
            array(STRING, 0) as d_month,             // 交割月份
            array(DATE, 0) as last_ddate,            // 最后交割日
            array(STRING, 0) as trade_time_desc,     // 交易时间说明
            array(TIMESTAMP, 0) as update_time       // 更新时间
        )
        db.createTable(
            table = schemaTB,
            tableName = tbName
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "合约代码"
        columnComments["base_code"] = "交易标识"
        columnComments["exchange"] = "交易市场"
        columnComments["name"] = "中文简称"
        columnComments["fut_code"] = "合约产品代码"
        columnComments["multiplier"] = "合约乘数"
        columnComments["trade_unit"] = "交易计量单位"
        columnComments["per_unit"] = "交易单位(每手)"
        columnComments["quote_unit"] = "报价单位"
        columnComments["quote_unit_desc"] = "最小报价单位说明"
        columnComments["d_mode_desc"] = "交割方式说明"
        columnComments["list_date"] = "上市日期"
        columnComments["delist_date"] = "最后交易日期"
        columnComments["d_month"] = "交割月份"
        columnComments["last_ddate"] = "最后交割日"
