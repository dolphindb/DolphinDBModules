/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: createTableFtLimit
*  @Brief: Create a DFS table for futures price limits
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableFtLimit()
*/
def createTableFtLimit(){
    dbName = "dfs://tushare_daily_db"
    tbName = "ft_limit"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(DATE, 0) as trade_date,            // 交易日期
            array(SYMBOL, 0) as security_id,               // TS股票代码 (原ts_code)
            array(STRING, 0) as name,                // 合约名称
            array(DOUBLE, 0) as up_limit,            // 涨停价
            array(DOUBLE, 0) as down_limit,          // 跌停价
            array(DOUBLE, 0) as m_ratio,             // 最低交易保证金率（%）
            array(SYMBOL, 0) as cont,                // 合约代码
            array(SYMBOL, 0) as exchange,            // 交易所代码
            array(TIMESTAMP, 0) as update_time       // 更新时间
        )
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = "trade_date"
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["trade_date"] = "交易日期"
        columnComments["security_id"] = "TS股票代码"
        columnComments["name"] = "合约名称"
        columnComments["up_limit"] = "涨停价"
        columnComments["down_limit"] = "跌停价"
        columnComments["m_ratio"] = "最低交易保证金率（%）"
        columnComments["cont"] = "合约代码"
        columnComments["exchange"] = "交易所代码"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

