/*
*  @FunctionName: createTableFutWeeklyDetail
*  @Brief: Create a DFS table for futures weekly trading details
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableFutWeeklyDetail()
*/
def createTableFutWeeklyDetail(){
    dbName = "dfs://tushare_daily_db"
    tbName = "fut_weekly_detail"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as exchange,            // 交易所代码
            array(SYMBOL, 0) as prd,                 // 期货品种代码
            array(STRING, 0) as name,                // 品种名称
            array(INT, 0) as vol,                    // 成交量（手）
            array(DOUBLE, 0) as vol_yoy,             // 同比增减（%）
            array(DOUBLE, 0) as amount,              // 成交金额（亿元）
            array(DOUBLE, 0) as amout_yoy,           // 同比增减（%）
            array(INT, 0) as cumvol,                 // 年累计成交总量（手）
