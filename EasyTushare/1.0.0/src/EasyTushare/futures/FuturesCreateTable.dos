}

/*
*  @FunctionName: createTableFutDaily
*  @Brief: Create a DFS table for futures daily data
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableFutDaily()
*/
def createTableFutDaily(){
    dbName = "dfs://tushare_daily_db"
    tbName = "fut_daily"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as security_id,               // TS合约代码 (原ts_code)
            array(DATE, 0) as trade_date,            // 交易日期
            array(DOUBLE, 0) as pre_close,          // 昨收盘价
            array(DOUBLE, 0) as pre_settle,         // 昨结算价
            array(DOUBLE, 0) as open,               // 开盘价
            array(DOUBLE, 0) as high,               // 最高价
            array(DOUBLE, 0) as low,                // 最低价
            array(DOUBLE, 0) as close,              // 收盘价
            array(DOUBLE, 0) as settle,             // 结算价
            array(DOUBLE, 0) as change1,            // 涨跌1 收盘价-昨结算价
            array(DOUBLE, 0) as change2,            // 涨跌2 结算价-昨结算价
            array(DOUBLE, 0) as vol,                // 成交量(手)
            array(DOUBLE, 0) as amount,             // 成交金额(万元)
            array(DOUBLE, 0) as oi,                 // 持仓量(手)
            array(DOUBLE, 0) as oi_chg,             // 持仓量变化
            array(DOUBLE, 0) as delv_settle,        // 交割结算价
            array(TIMESTAMP, 0) as update_time      // 更新时间
        )
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = "trade_date"
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "TS合约代码"
        columnComments["trade_date"] = "交易日期"
        columnComments["pre_close"] = "昨收盘价"
        columnComments["pre_settle"] = "昨结算价"
        columnComments["open"] = "开盘价"
        columnComments["high"] = "最高价"
        columnComments["low"] = "最低价"
        columnComments["close"] = "收盘价"
        columnComments["settle"] = "结算价"
        columnComments["change1"] = "涨跌1 收盘价-昨结算价"
        columnComments["change2"] = "涨跌2 结算价-昨结算价"
        columnComments["vol"] = "成交量(手)"
        columnComments["amount"] = "成交金额(万元)"
        columnComments["oi"] = "持仓量(手)"
        columnComments["oi_chg"] = "持仓量变化"
        columnComments["delv_settle"] = "交割结算价"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

