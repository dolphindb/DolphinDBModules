/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}
/*
*  @FunctionName: createTableNpr
*  @Brief: Create a DFS table for National Policy Repository
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableNpr()
*/
def createTableNpr(){
    dbName = "dfs://tushare_daily_db"
    tbName = "npr"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(TIMESTAMP, 0) as pub_time,        // publish time
            array(STRING, 0) as title,              // title
            array(STRING, 0) as url,                // policy URL
            array(STRING, 0) as content_html,       // content html
            array(STRING, 0) as pcode,              // policy code
            array(SYMBOL, 0) as puborg,             // publisher
            array(SYMBOL, 0) as ptype,              // policy type
            array(TIMESTAMP, 0) as update_time      // update time
        )
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = "pub_time"
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["pub_time"] = "发布时间"
        columnComments["title"] = "标题"
        columnComments["url"] = "政策文件url"
        columnComments["content_html"] = "正文内容"
        columnComments["pcode"] = "发文字号"
        columnComments["puborg"] = "发文机关"
        columnComments["ptype"] = "主题分类"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

/*
*  @FunctionName: createTableResearchReport
*  @Brief: Create a DFS table for Broker Research Reports
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableResearchReport()
*/
def createTableResearchReport(){
    dbName = "dfs://tushare_daily_db"
    tbName = "research_report"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(DATE, 0) as trade_date,           // report date
            array(STRING, 0) as abstr,              // abstract
            array(STRING, 0) as title,              // title
            array(SYMBOL, 0) as report_type,        // report type
            array(STRING, 0) as author,             // author
            array(STRING, 0) as name,               // stock name
            array(SYMBOL, 0) as security_id,            // TS code
            array(SYMBOL, 0) as inst_csname,        // institution
            array(SYMBOL, 0) as ind_name,           // industry
            array(STRING, 0) as url,                // report URL
            array(TIMESTAMP, 0) as update_time      // update time
        )
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = "trade_date"
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["trade_date"] = "研报发布时间"
        columnComments["abstr"] = "研报摘要"
        columnComments["title"] = "研报标题"
        columnComments["report_type"] = "研报类别"
        columnComments["author"] = "作者"
        columnComments["name"] = "股票名称"
        columnComments["security_id"] = "股票代码"
        columnComments["inst_csname"] = "机构简称"
        columnComments["ind_name"] = "行业名称"
        columnComments["url"] = "下载链接"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

