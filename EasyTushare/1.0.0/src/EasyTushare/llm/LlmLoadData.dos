def appendNpr(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "npr"
    api = "npr"
    cols = [
        "pubtime",
        "title",
        "url",
        "content_html",
        "pcode",
        "puborg",
        "ptype"
    ]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where date(pub_time) between start_date and end_date
    for(oneDate in start_date..end_date){ // oneDate = 2026.07.10
        dateText = temporalFormat(oneDate, "yyyy-MM-dd")
        dtStart = dateText + " 00:00:00"
        dtEnd = dateText + " 23:59:59"
        p = {start_date:dtStart, end_date:dtEnd}
        res = getApiData(token, api, p, cols)
        if(!res.isVoid() and res.count() != 0){
            res = select pubtime as pub_time, title, url, content_html, pcode, puborg, ptype from res
            update res set update_time = now()
            replaceColumn!(res, "pub_time", timestamp(res.pub_time))
            replaceColumn!(res, "title", string(res.title))
            replaceColumn!(res, "url", string(res.url))
            replaceColumn!(res, "content_html", string(res.content_html))
            replaceColumn!(res, "pcode", string(res.pcode))
            replaceColumn!(res, "puborg", symbol(string(res.puborg)))
            replaceColumn!(res, "ptype", symbol(string(res.ptype)))
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateText)
        } else {
            print("no data for Table " + api + " for date: " + dateText)
        }
    }
    print("Success append data for Table " + api)
}

