/*
 * @Description: Major news data import
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-03 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendMajorNews(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "major_news"
    api = "major_news"
    cols = [
        "title",
        "content",
        "pub_time",
        "src"
    ]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where date(pub_time) between start_date and end_date
    for(oneDate in start_date..end_date){
        dateText = temporalFormat(oneDate, "yyyy-MM-dd")
        dateText = temporalFormat(oneDate, "yyyy-MM-dd")
        dtStart = dateText + " 00:00:00"
        dtEnd = dateText + " 23:59:59"
        p = {start_date:dtStart, end_date:dtEnd}
        res = getApiData(token, api, p, cols)
        if(!res.isVoid() and res.count() != 0){
            update res set update_time = now()
            replaceColumn!(res, "title", string(res.title))
            replaceColumn!(res, "content", string(res.content))
            replaceColumn!(res, "pub_time", timestamp(res.pub_time))
            replaceColumn!(res, "src", symbol(string(res.src)))
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateText)
        } else {
            print("no data for Table " + api + " for date: " + dateText)
        }
    }
    print("Success append data for Table " + api)
}

/*
 * @Description: News flash data import
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-03 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendNews(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "news"
    api = "news"
    cols = [
        "datetime",
        "content",
        "title",
        "channels"
    ]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where date(date_time) >= start_date and date(date_time)<=end_date
    srcVals = ["sina","wallstreetcn","10jqka","eastmoney","yuncaijing","fenghuang","jinrongjie","cls","yicai"]
    for(oneDate in start_date..end_date){ // oneDate = 2026.07.10
        dateText = temporalFormat(oneDate, "yyyy-MM-dd")
        dtStart = dateText + " 00:00:00"
        dtEnd = dateText + " 23:59:59"
        for(srcVal in srcVals){ // srcVal = 'fenghuang'
            p = {src:srcVal, start_date:dtStart, end_date:dtEnd}
            res = getApiData(token, api, p, cols)

            if(!res.isVoid() and res.count() != 0){
                res = select datetime as date_time, content, title, channels ,now() as update_time from res
                // replaceColumn!(res, "date_time", timestamp(temporalParse(iif(strlen(string(res.date_time))==16,string(res.date_time)+ ":00",string(res.date_time)), "yyyy-MM-dd HH:mm:ss")))
                replaceColumn!(res, "date_time", timestamp(res.date_time))
                replaceColumn!(res, "content", string(res.content))
                replaceColumn!(res, "title", string(res.title))
                out.append!(res)
                print("Success append data for Table " + api + " for date: " + dateText + " src: " + srcVal)
            } else {
                print("no data for Table " + api + " for date: " + dateText + " src: " + srcVal)
            }
        }  
    }
    print("Success append data for Table " + api)
}

/*
 * @Description: National policy repository data import
