module EasyTushare::llm::LlmLoadData
/* 
*  @Brief: 大模型语料数据单个表导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use EasyTushare::TsInit

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
 * @Description: 上市公司公告数据导入
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-03 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendAnnsD(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "anns_d"
    api = "anns_d"
    cols = [
        "ann_date",
        "ts_code",
        "name",
        "title",
        "url",
        "rec_time"
    ]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where ann_date between start_date and end_date
    for(oneDate in start_date..end_date){
        dateStr = temporalFormat(oneDate, "yyyyMMdd") // dateStr = "20260710"
        p = {ann_date:dateStr}
        res = getApiData(token, api, p, cols)

        if (!res.isVoid() and res.count() !=0){
            
            update res set update_time = now()

            replaceColumn!(res, "ann_date", temporalParse(string(res.ann_date), "yyyyMMdd"))
            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "name", string(res.name))
            replaceColumn!(res, "title", string(res.title))
            replaceColumn!(res, "url", string(res.url))
            replaceColumn!(res, "rec_time", timestamp(res.rec_time))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateStr)
        } else {
            print("no data for Table " + api + " for date: " + dateStr)
        }     
    }
    print("Success append data for Table " + api)
}

/*
 * @Description: CCTV news data import
 * @DolphinDB server version: 
 * @Last modification time: 2026-03-03 10:52:57
 * @dev: 
 * @Author: fangwu
 */
def appendCctvNews(token, start_date, end_date){
    dbPath = "dfs://tushare_daily_db"
    tableName = "cctv_news"
    api = "cctv_news"
    cols = [
        "date",
        "title",
        "content"
    ]
    out = loadTable(dbPath, tableName)
    delete from loadTable(dbPath, tableName) where news_date between start_date and end_date
    for(oneDate in start_date..end_date){ // oneDate = 2026.04.21
        dateStr = temporalFormat(oneDate, "yyyyMMdd")
        p = {date:dateStr}
        res = getApiData(token, api, p, cols)
        if(!res.isVoid() and res.count() != 0){
            res = select date as news_date, title, content from res
            update res set update_time = now()
            replaceColumn!(res, "news_date", temporalParse(string(res.news_date), "yyyyMMdd"))
            replaceColumn!(res, "title", string(res.title))
            replaceColumn!(res, "content", string(res.content))
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateStr)
        } else {
            print("no data for Table " + api + " for date: " + dateStr)
        }
    }
    print("Success append data for Table " + api)
}

