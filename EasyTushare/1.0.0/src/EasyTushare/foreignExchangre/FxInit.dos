module EasyTushare::foreignExchangre::FxInit
use EasyTushare::TsInit

/* 
*  @Brief: 外汇数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/

use EasyTushare::foreignExchangre::FxCreateTable

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: fxInit
*  @Brief: 初始化数据库表
*  @Param: None
*  @Return: None
*  @SampleUsage: fxInit()
*/
def fxInitTables(table_names = []){
    if (size(table_names) == 0){
       ts_create_tables = exec name from defs() where name like "EasyTushare::foreignExchangre::FxCreateTable%"
        for(table in ts_create_tables){
            funcByName(table)()
        }
    } else {
        for (table_name in table_names){ 
            funcByName("EasyTushare::foreignExchangre::FxCreateTable::create" + snakeToUpperCamel(table_name))()
        }   
    }
}

use EasyTushare::foreignExchangre::FxLoadData  

/**
*  @FunctionName: getFxTableNames
*  @Brief: 获取外汇数据导入函数表名
*  @Param: None
*  @Return: list
*  @SampleUsage: getFxTableNames()
*/
def fxGetAllTableNames(){
    ts_create_tables = exec name from defs() where name like "EasyTushare::foreignExchangre::FxLoadData::append%"
    return each(upperCamelToSnake, ts_create_tables.split("::")[3].substr(6))
}

/*
*  @FunctionName: fxHistoryDataLoad
*  @Brief: 外汇数据导入函数
*  @Param: token, start_date, end_date
*  @Return: None
*  @SampleUsage: fxHistoryDataLoad(token,start_date,end_date)
*/
def fxHistoryDataLoad(token,start_date,end_date,table_names = []) {
    // 本次需要导入的所有表名
    all_table_names = []
    if (size(table_names) == 0){
        all_table_names = fxGetAllTableNames()        
    } else {
        all_table_names = table_names
    }
    for (table_name in all_table_names){
        submitJob("append_" + table_name, "append_" + table_name,  funcByName("EasyTushare::foreignExchangre::FxLoadData::append" + snakeToUpperCamel(table_name)), token, start_date, end_date)
    }
}
