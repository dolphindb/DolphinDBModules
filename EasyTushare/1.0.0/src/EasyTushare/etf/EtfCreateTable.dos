module EasyTushare::etf::EtfCreateTable

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: createTableEtfBasic
*  @Brief: Create a DFS table for ETF basic information
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableEtfBasic()
*/
def createTableEtfBasic(){
    dbName = "dfs://tushare_basic_db"
    tbName = "etf_basic"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(SYMBOL, 0) as security_id,               // 基金交易代码
            array(STRING, 0) as csname,             // ETF中文简称
            array(STRING, 0) as extname,            // ETF扩位简称
            array(STRING, 0) as cname,              // 基金中文全称
            array(SYMBOL, 0) as index_code,         // ETF基准指数代码
            array(STRING, 0) as index_name,         // ETF基准指数中文全称
            array(DATE, 0) as setup_date,           // 设立日期
            array(DATE, 0) as list_date,            // 上市日期
            array(SYMBOL, 0) as list_status,        // 存续状态
            array(SYMBOL, 0) as exchange,           // 交易所
            array(STRING, 0) as mgr_name,           // 基金管理人简称
            array(STRING, 0) as custod_name,        // 基金托管人名称
            array(DOUBLE, 0) as mgt_fee,            // 基金管理人收取的费用
            array(SYMBOL, 0) as etf_type,           // 基金投资通道类型
            array(TIMESTAMP, 0) as update_time      // 更新时间
        )
        db.createTable(
            table = schemaTB,
            tableName = tbName
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "基金交易代码"
        columnComments["csname"] = "ETF中文简称"
        columnComments["extname"] = "ETF扩位简称"
        columnComments["cname"] = "基金中文全称"
        columnComments["index_code"] = "ETF基准指数代码"
        columnComments["index_name"] = "ETF基准指数中文全称"
        columnComments["setup_date"] = "设立日期"
        columnComments["list_date"] = "上市日期"
        columnComments["list_status"] = "存续状态"
        columnComments["exchange"] = "交易所"
        columnComments["mgr_name"] = "基金管理人简称"
        columnComments["custod_name"] = "基金托管人名称"
        columnComments["mgt_fee"] = "基金管理人收取的费用"
        columnComments["etf_type"] = "基金投资通道类型"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

/*
*  @FunctionName: createTableEtfIndex
