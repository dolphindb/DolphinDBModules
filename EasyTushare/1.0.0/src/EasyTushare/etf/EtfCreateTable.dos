            array(STRING, 0) as pub_party_name,     // 指数发布机构
            array(DATE, 0) as pub_date,             // 指数发布日期
            array(DATE, 0) as base_date,            // 指数基日
            array(DOUBLE, 0) as bp,                 // 指数基点(点)
            array(STRING, 0) as adj_circle,         // 指数成份证券调整周期
            array(TIMESTAMP, 0) as update_time      // 更新时间
        )
        db.createTable(
            table = schemaTB,
            tableName = tbName
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["security_id"] = "指数代码"
        columnComments["indx_name"] = "指数全称"
        columnComments["indx_csname"] = "指数简称"
        columnComments["pub_party_name"] = "指数发布机构"
        columnComments["pub_date"] = "指数发布日期"
        columnComments["base_date"] = "指数基日"
        columnComments["bp"] = "指数基点(点)"
        columnComments["adj_circle"] = "指数成份证券调整周期"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

/*
*  @FunctionName: createTableEtfShareSize
*  @Brief: Create a DFS table for ETF share size data
*  @Param: None
*  @Return: None
*  @SampleUsage: createTableEtfShareSize()
*/
def createTableEtfShareSize(){
    dbName = "dfs://tushare_daily_db"
    tbName = "etf_share_size"
    if(existsDatabase(dbName)){
        db = database(dbName)
        if(!existsTable(dbName, tbName)){
        schemaTB = table(
            array(DATE, 0) as trade_date,           // 交易日期
            array(SYMBOL, 0) as security_id,               // ETF代码
            array(STRING, 0) as etf_name,           // 基金名称
            array(DOUBLE, 0) as total_share,        // 总份额（万份）
            array(DOUBLE, 0) as total_size,         // 总规模（万元）
            array(DOUBLE, 0) as nav,                // 基金份额净值(元)
            array(DOUBLE, 0) as close,              // 收盘价（元）
            array(SYMBOL, 0) as exchange,           // 交易所
            array(TIMESTAMP, 0) as update_time      // 更新时间
        )
        db.createPartitionedTable(
            table = schemaTB,
            tableName = tbName,
            partitionColumns = "trade_date"
        )
        go
        columnComments = dict(STRING, STRING)
        columnComments["trade_date"] = "交易日期"
        columnComments["security_id"] = "ETF代码"
        columnComments["etf_name"] = "基金名称"
        columnComments["total_share"] = "总份额（万份）"
        columnComments["total_size"] = "总规模（万元）"
        columnComments["nav"] = "基金份额净值(元)"
        columnComments["close"] = "收盘价（元）"
        columnComments["exchange"] = "交易所"
        columnComments["update_time"] = "更新时间"
        setColumnComment(loadTable(dbName, tbName), columnComments)
        print("Table of " + tbName + " created successfully!")
        }
    }else{
        print("Database of " + dbName + " does not exist, please create database first!")
    }
}

