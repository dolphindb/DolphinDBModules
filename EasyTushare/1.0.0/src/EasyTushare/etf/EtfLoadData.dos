def appendEtfIndex(token, start_date1, end_date1){
    dbPath = "dfs://tushare_basic_db"
    tableName = "etf_index"
    api = "etf_index"
    cols = ["ts_code","indx_name","indx_csname","pub_party_name","pub_date","base_date","bp","adj_circle"]
