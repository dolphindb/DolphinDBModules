module EasyTushare::etf::EtfLoadData
use EasyTushare::TsInit

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

/*
*  @FunctionName: appendEtfBasic
*  @Brief: 追加ETF基础信息数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendEtfBasic("your_token", 2025.01.01, 2025.02.01)
*/
//  start_date = 2000.01.01
//  end_date = 2026.03.24   
def appendEtfBasic(token, start_date1, end_date1){
    dbPath = "dfs://tushare_basic_db"
    tableName = "etf_basic"
    api = "etf_basic"
    cols = ["ts_code","csname","extname","cname","index_code","index_name","setup_date","list_date","list_status","exchange","mgr_name","custod_name","mgt_fee","etf_type"]
    out = loadTable(dbPath, tableName)
    
    p = {}
    res = getApiData(token, api, p, cols)

    if (!res.isVoid() and res.count() !=0){
        
        update res set update_time = now()

        replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
        replaceColumn!(res, "csname", string(res.csname))
        replaceColumn!(res, "extname", string(res.extname))
        replaceColumn!(res, "cname", string(res.cname))
        replaceColumn!(res, "index_code", symbol(string(res.index_code)))
        replaceColumn!(res, "index_name", string(res.index_name))
        replaceColumn!(res, "setup_date", temporalParse(string(res.setup_date), "yyyyMMdd"))
        replaceColumn!(res, "list_date", temporalParse(string(res.list_date), "yyyyMMdd"))
        replaceColumn!(res, "list_status", symbol(string(res.list_status)))
        replaceColumn!(res, "exchange", symbol(string(res.exchange)))
        replaceColumn!(res, "mgr_name", string(res.mgr_name))
        replaceColumn!(res, "custod_name", string(res.custod_name))
        replaceColumn!(res, "mgt_fee", double(res.mgt_fee))
        replaceColumn!(res, "etf_type", symbol(string(res.etf_type)))
        replaceColumn!(res, "update_time", timestamp(res.update_time))
        
        // 重命名 ts_code 为 code
        // renameColumn!(res, "ts_code", "code")
        delete from out
        out.append!(res)
        print("Success append data for Table " + api)
    } else {
        print("no data for Table " + api)
    }     
}
/*
*  @FunctionName: appendEtfIndex
*  @Brief: 追加ETF基准指数列表数据
*  @Param: token - Tushare API令牌
