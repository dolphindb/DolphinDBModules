    }     
}

/*
*  @FunctionName: appendEtfShareSize
*  @Brief: 追加ETF份额规模数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendEtfShareSize("your_token", 2025.01.01, 2025.02.01)
*/
def appendEtfShareSize(token, start_date1, end_date1){
    dbPath = "dfs://tushare_daily_db"
    tableName = "etf_share_size"
    api = "etf_share_size"
    cols = ["trade_date","ts_code","etf_name","total_share","total_size","nav","close","exchange"]
    out = loadTable(dbPath, tableName)
    dts = getMarketCalendar("SSE", start_date1, end_date1)
    delete from out where trade_date >= start_date1 and trade_date <= end_date1
    for(oneDate in dts){
        dateStr = temporalFormat(oneDate, "yyyyMMdd")
        p = {"trade_date":dateStr}
        res = getApiData(token, api, p, cols)

        if (!res.isVoid() and res.count() !=0){
            
            update res set update_time = now()

            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "etf_name", string(res.etf_name))
            replaceColumn!(res, "total_share", double(res.total_share))
            replaceColumn!(res, "total_size", double(res.total_size))
            replaceColumn!(res, "nav", double(res.nav))
            replaceColumn!(res, "close", double(res.close))
            replaceColumn!(res, "exchange", symbol(string(res.exchange)))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            
            // 重命名 ts_code 为 code
            // renameColumn!(res, "ts_code", "code")
            
            out.append!(res)
            print("Success append data for Table " + api + " for date: " + dateStr)
        } else {
            print("no data for Table " + api + " for date: " + dateStr)
        }     
    }
    print("Success append data for Table " + api)
}
/*
*  @FunctionName: appendFundAdj
*  @Brief: 追加基金复权因子数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendFundAdj("your_token", 2025.01.01, 2025.02.01)
*/
def appendFundAdj(token, start_date1, end_date1){
    dbPath = "dfs://tushare_daily_db"
    tableName = "fund_adj"
    api = "fund_adj"
    cols = ["ts_code","trade_date","adj_factor"]
    out = loadTable(dbPath, tableName)
    
    // 示例基金代码，实际使用时可能需要循环处理多个代码
    p = {"list_status":"L"}
    api1 = "etf_basic"
    fundCodes = exec ts_code from getApiData(token, api1, p, cols)
    delete from out where trade_date >= start_date1 and trade_date <= end_date1
    for(ts_code in fundCodes){
        start_str = temporalFormat(start_date1, "yyyyMMdd")
        end_str = temporalFormat(end_date1, "yyyyMMdd")
        
        p = {"ts_code":ts_code, "start_date":start_str, "end_date":end_str}
        res = getApiData(token, api, p, cols)

        if (!res.isVoid() and res.count() !=0){
            
            update res set update_time = now()

            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "adj_factor", double(res.adj_factor))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            out.append!(res)
            print("Success append data for Table " + api + " for code: " + ts_code)
        } else {
            print("no data for Table " + api + " for code: " + ts_code)
        }     
    }
    print("Success append data for Table " + api)
}

/*
*  @FunctionName: appendEtfDaily
*  @Brief: 追加ETF日线行情数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendEtfDaily("your_token", 2025.01.01, 2025.02.01)
*/
def appendEtfDaily(token, start_date1, end_date1){
    dbPath = "dfs://tushare_daily_db"
    tableName = "fund_daily"
    api = "fund_daily"
    cols = ["ts_code","trade_date","open","high","low","close","pre_close","change","pct_chg","vol","amount"]
    out = loadTable(dbPath, tableName)
    
    // 示例ETF代码，实际使用时可能需要循环处理多个代码
    p = {"list_status":"L"}
    api1 = "etf_basic"
    etfCodes = exec ts_code from getApiData(token, api1, p, cols)
    delete from out where trade_date >= start_date1 and trade_date <= end_date1
    for(ts_code in etfCodes){
        // ts_code = etfCodes[0]
        start_str = temporalFormat(start_date1, "yyyyMMdd")
        end_str = temporalFormat(end_date1, "yyyyMMdd")
        
        p = {"ts_code":ts_code, "start_date":start_str, "end_date":end_str}
        res = getApiData(token, api, p, cols)

        if (!res.isVoid() and res.count() !=0){
            
            update res set update_time = now()
            replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
            replaceColumn!(res, "trade_date", temporalParse(string(res.trade_date), "yyyyMMdd"))
            replaceColumn!(res, "open", double(res.open))
            replaceColumn!(res, "high", double(res.high))
            replaceColumn!(res, "low", double(res.low))
            replaceColumn!(res, "close", double(res.close))
            replaceColumn!(res, "pre_close", double(res.pre_close))
            replaceColumn!(res, "change", double(res.change))
            replaceColumn!(res, "pct_chg", double(res.pct_chg))
            replaceColumn!(res, "vol", double(res.vol))
            replaceColumn!(res, "amount", double(res.amount))
            replaceColumn!(res, "update_time", timestamp(res.update_time))
            out.append!(res)
            print("Success append data for Table " + api + " for code: " + ts_code)
        } else {
            print("no data for Table " + api + " for code: " + ts_code)
        }     
    }
}

/*
*  @FunctionName: appendEtfStk1Mins
*  @Brief: 追加ETF历史1分钟行情数据
*  @Param: token - Tushare API令牌
*  @Param: start_date - 开始日期，格式为YYYY.MM.DD
*  @Param: end_date - 结束日期，格式为YYYY.MM.DD
*  @Return: None
*  @SampleUsage: appendEtfStk1Mins("your_token", 2025.01.01, 2025.02.01)
*/
def appendEtfStk1Mins(token, start_date1, end_date1){
    dbPath = "dfs://tushare_minute_db"
    tableName = "stk_1_mins"
    api = "etf_mins"
    cols = ["ts_code","trade_time","open","close","high","low","vol","amount"]
    out = loadTable(dbPath, tableName)
    
    // 示例ETF代码，实际使用时可能需要循环处理多个代码
    p = {"list_status":"L"}
    api1 = "etf_basic"
    etfCodes = exec ts_code from getApiData(token, api1, p, cols)
    freq = "1min"

    // 处理时间范围，每个股票一个月读取一次
    days = getMarketCalendar("XSHG",start_date1, end_date1)
    delete from out where date(trade_time) >= start_date1 and date(trade_time) <= end_date1
    for (one_day in days) { // i=0
        start_day = temporalFormat(one_day, "yyyy-MM-dd")
        end_day = temporalFormat(one_day, "yyyy-MM-dd")
        start_time = start_day + " 09:00:00"
        end_time = end_day + " 19:00:00"

        codes_batchs = etfCodes.cut(29)
        for (one_batch in codes_batchs) { // code = "000001.SZ,000002.SZ"
            // one_batch = codes_batchs[0]
            codebath_str = one_batch.concat(",")
            p = {"ts_code":codebath_str, "freq":freq, "start_date":start_time, "end_date":end_time}
            res = getApiData(token, api, p, cols)

            if (!res.isVoid() and res.count() !=0){
            
                update res set update_time = now()

                replaceColumn!(res, "ts_code", symbol(string(res.ts_code)))
                replaceColumn!(res, "trade_time", timestamp(res.trade_time))
                replaceColumn!(res, "open", double(res.open))
                replaceColumn!(res, "close", double(res.close))
                replaceColumn!(res, "high", double(res.high))
                replaceColumn!(res, "low", double(res.low))
                replaceColumn!(res, "vol", int(res.vol))
                replaceColumn!(res, "amount", double(res.amount))
                replaceColumn!(res, "update_time", timestamp(res.update_time))
                
                // 重命名 ts_code 为 code
                // renameColumn!(res, "ts_code", "code")
                
                out.append!(res)
                print("Success append data for Table " + api + " for code: " + codebath_str + " for count:" + res.count())
            } 
            sleep(200)   
        }
    }
    
    
    print("Success append data for Table " + api)
}
