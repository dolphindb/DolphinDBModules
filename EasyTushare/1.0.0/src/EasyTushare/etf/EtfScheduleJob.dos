module EasyTushare::etf::EtfScheduleJob
use EasyTushare::TsInit

/* 
*  @Brief: 股票每日增量数据导入函数模块
*  @Author: DolphinDB
*  @Last modification time: 2026.03.31
*  @DolphinDB server version: 3.00.5 2026.02.06 LINUX x86_64
*/
use EasyTushare::etf::EtfLoadData

/*
*  @FunctionName: module_info
*  @Brief: 模块信息,一个相同模块dir下的每个dos都需要有module_info函数,且是相同的
*  @Param: None
*  @Return: dict
*  @SampleUsage: module_info()
*/
def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "EasyTushare"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}

use EasyTushare::etf::EtfInit
/*
*  @FunctionName: loadEtfDataDaily
*  @Brief: ETF每日增量数据导入函数
*  @Param: token tushareETF数据导入任务token
*  @Return: none
*  @SampleUsage: loadEtfDataDaily(token)
*/
def loadEtfDataDaily(token,table_names,funcDef){
    // 公共变量
    print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 开始执行tushare-etf每日增量数据导入任务...")

    start_date = today()
    end_date = today()
    for (table_name in table_names){
        if (table_name == "etf_share_size") {
             print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 开始导入" + table_name + "表...")
            func = funcDef[table_name]
            func(token, start_date-1, end_date-1)
            print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 结束导入" + table_name + "表")
        } else {
            print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 开始导入" + table_name + "表...")
            func = funcDef[table_name]
            func(token, start_date, end_date)
            print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 结束导入" + table_name + "表")
        }
    }
    print("[INFO] " + now().format("yyyy.MM.dd HH:mm:ss") + " 当日所有tushare etf数据导入任务完成!")
}

/**
 * @FunctionName: getTablesFuncDefs
 * @Brief: 获取每个函数的函数引用
 * @Param: table_names 表名
 * @Return: none
 * @SampleUsage: getTablesFuncDefs()
 */
def etfGetTablesFuncDefs(table_names=[]) {
    all_table_names = []
    if (size(table_names) == 0){
        all_table_names = etfGetAllTableNames()
    } else {
        all_table_names = table_names
    }
    // 构造函数引用字典，传递给scheduleJob
    funcDef = dict(STRING,ANY)
    for (table_name in all_table_names){
        funcDef[table_name] = funcByName("EasyTushare::etf::EtfLoadData::append" + snakeToUpperCamel(table_name))
    }
    return funcDef
}

/**
 * @FunctionName: scheduleJobEtfDataDaily
 * @Brief: ETF每日增量数据导入任务
 * @Param: token tushareETF数据导入任务token
 * @Return: none
 * @SampleUsage: scheduleJobEtfDataDaily(token)
 */
def scheduleJobEtfDataDaily(token,table_names=[],onCompleteFunc = NULL){
    // 构造函数引用字典，传递给scheduleJob
    funcDef = etfGetTablesFuncDefs(table_names)
    try{deleteScheduledJob(`loadEtfDataDaily)} catch(ex) {print(ex)}
    if (onCompleteFunc == NULL) {
        scheduleJob("loadEtfDataDaily","loadEtfDataDaily",loadEtfDataDaily{token,funcDef.keys(),funcDef},20:00m,today(),2099.01.01,"D")
    } else {
        scheduleJob("loadEtfDataDaily","loadEtfDataDaily",loadEtfDataDaily{token,funcDef.keys(),funcDef},20:00m,today(),2099.01.01,"D",,onCompleteFunc)
    }
}
