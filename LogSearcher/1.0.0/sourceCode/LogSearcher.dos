        logDir = getHomeDir() + "/" + params["nodeAlias"] + "/resource"
    } else {
        logDir = getHomeDir() + "/resource"
    }
    filePattern = "%hardware.log"
    extractTsAndLevelFunc = def (lines) {
        ts = temporalParse(lines.split(",").at(0), "yyyy.MM.ddTHH:mm:ss.nnnnnnnnn")
        level = take("INFO", ts.size())
        return ts, level
    }
    ret = searchLogFromFileInner(params, logDir, filePattern, extractTsAndLevelFunc, true)
    
    return ret
}

def searchDmesgLog(params) {
    ret = table(1:0, `timestamp`logLevel`logFile`content, [NANOTIMESTAMP, SYMBOL, STRING, STRING])
    cfg = getConfig("enableShellFunction")
    if (bool(cfg) == false) {
        customWriteLog("The config enableShellFunction is false, searching for dmesg is disabled")
        return ret
    }
    startTime = params["startTime"]
    endTime = params["endTime"]
    pattern = params["pattern"]
    mode = params["mode"]
    logLevel_ = params["logLevel"]
    if (!in("ERROR", logLevel_)) {
        return ret
    }

    tmpFilename = "LogSearcher_dmesg_" + getNodeAlias() + "_" + temporalFormat(now(), "yyyyMMddHmsSSS") + "_tmp.txt"
    execName = params["dolphindbPath"].split("/").last()
    shell("dmesg | grep " + execName + " | awk -F ] '{\"cat /proc/uptime | cut -d \\\" \\\" -f 1\" | getline st;a=substr( $1,2, length($1) - 1);print strftime(\"%F %H:%M:%S %Z\",systime()-st+a)\" -> \"$0}' > " + tmpFilename)
    fin = file(tmpFilename)

    do {
        line = readLine(fin)
        if (isVoid(line)) {
            break
        }  
        ts = nanotimestamp(temporalParse(line.substr(0, 19), "yyyy-MM-dd HH:mm:ss"))
        if (ts < startTime or ts > endTime) {
            continue
        }
        ret_ = table(
            ts as timestamp,
            "ERROR" as logLevel,
            string(NULL) as logFile,
            line as content
        )
        ret_ = searchLogByPattern(ret_, pattern, mode)
        ret.append!(ret_)
    } while(true)
    
    rm(tmpFilename)
    return ret
}

def searchCoredumpLog(params) {
    ret = table(1:0, `timestamp`logLevel`logFile`content, [NANOTIMESTAMP, SYMBOL, STRING, STRING])
    cfg = getConfig("enableShellFunction")
    if (bool(cfg) == false) {
        customWriteLog("The config enableShellFunction is false, searching for coredump is disabled")
        return ret
    }
    startTime = nanotimestamp(params["startTime"])
    endTime = nanotimestamp(params["endTime"])
    pattern = params["pattern"]
    mode = params["mode"]
    logLevel_ = params["logLevel"]
    if (!in("ERROR", logLevel_)) {
        return ret
    }
    dolphindbPath = params["dolphindbPath"]
    execName = dolphindbPath.split("/").last()

    tmpFilename = "LogSearcher_coredump_" + getNodeAlias() + "_" + temporalFormat(now(), "yyyyMMddHmsSSS") + "_tmp.txt"
    shell("cat /proc/sys/kernel/core_pattern > " + tmpFilename)
    f = file(tmpFilename)
    line = readLine(f)
    f.close()
    if (line.startsWith("/")) { // 绝对路径
        s = line.split("/")
        dir = s[0:(s.size()-1)].concat("/")
    } else if (char(line[0]).isAlpha()) { // 形如 core-%e，生成 coredump 在当前目录
        shell("pwd > " + tmpFilename)
        f = file(tmpFilename)
        dir = readLine(f)
        f.close()
    } else {
        customWriteLog("Unsupported core_pattern: " + line, ERROR)
        rm(tmpFilename)
        return ret
    }
    
    info = select * from files(dir) where isDir == false and lastModified >= startTime and lastModified <= endTime and !filename.startsWith("LogSearcher")
    for (item in info) {
        // item = info[9]
        filename = item["filename"]
        filePath = dir + "/" + filename
        shell("file " + filePath + " > " + tmpFilename)
        f = file(tmpFilename)
        line = readLine(f)
        f.close()
        if (strFind(line, "core") != -1 and strFind(line, execName) != -1) {
            content = ""
            shell("gdb " + dolphindbPath + " " + filePath + ' --eval-command "bt" --eval-command "quit" > ' + tmpFilename)
            f = file(tmpFilename)
            do {
                line = readLine(f)
                if (content.strlen() >= 65400) {
                    content += "\n...\nbacktrace is too long, please view full content via command line."
                    break
                }
                if (isVoid(line)) {
                    break
                }
                content += line + "\n"
            } while(true)
            ret_ = table(
                item["lastModified"] as timestamp,
                "ERROR" as logLevel,
                filePath as logFile,
                content as content
            )
            ret_ = searchLogByPattern(ret_, pattern, mode)
            ret.append!(ret_)
        }
    }
    ret = select * from ret order by timestamp desc
    rm(tmpFilename)
    return ret
}

def searchLogInParallel(params, nodes, searchFunc) {
    params_ = params
    clusterPerf = select * from rpc(getControllerAlias(), getClusterPerf{true}) where name in nodes
    params_["controllerAlias"] = getControllerAlias()
    ret = table(1:0, `timestamp`logLevel`logFile`content`node, [NANOTIMESTAMP, SYMBOL, STRING, STRING, STRING])

    aliveNodesInfo = select name, mode from clusterPerf where state == 1
    if (aliveNodesInfo.size() > 0) {
        f = def (searchFunc, params) {
            nodeAlias = getNodeAlias()
            params_ = params
            params_["nodeAlias"] = nodeAlias
            params_["nodeType"] = getNodeType()
            params_["state"] = 1
            params_["enableAuditLog"] = getConfigEx(nodeAlias, "enableAuditLog", false)
            params_["enableStructuredAuditLog"] = getConfigEx(nodeAlias, "enableStructuredAuditLog", false)
            params_["enableDFSQueryLog"] = getConfigEx(nodeAlias, "enableDFSQueryLog", false)
            params_["resourceSamplingInterval"] = getConfigEx(nodeAlias, "resourceSamplingInterval", -1)
            ret_ = searchFunc(params_)
            update ret_ set node = nodeAlias
            return ret_
        }
        ret = pnodeRun(f{searchFunc, params_}, aliveNodesInfo["name"])
    }

    deadNodesInfo = select name, mode, agentSite from clusterPerf where state == 0
    if (deadNodesInfo.size() > 0) {
        if (isVoid(params_["adminPassword"])) {
            customWriteLog("The config adminPassword is empty, skip dead nodes: " + deadNodesInfo["name"].concat(", "), WARNING)
        } else {
            f = def (searchFunc, params, nodeAlias, nodeType, agentSite) {
                s = agentSite.split(":")
                host = s[0]
                port = int(s[1])
                params_ = params
                params_["nodeAlias"] = nodeAlias
                params_["nodeType"] = nodeType
                params_["state"] = 0
                params_["enableAuditLog"] = getConfigEx(nodeAlias, "enableAuditLog", false)
                params_["enableStructuredAuditLog"] = getConfigEx(nodeAlias, "enableStructuredAuditLog", false)
                params_["enableDFSQueryLog"] = getConfigEx(nodeAlias, "enableDFSQueryLog", false)
                params_["resourceSamplingInterval"] = getConfigEx(nodeAlias, "resourceSamplingInterval", -1)

                conn = xdb(host, port, "admin", params_["adminPassword"])
                ret_ = remoteRun(conn, searchFunc{params_})
                update ret_ set node = nodeAlias
                return ret_
            }
            res = peach(f{searchFunc, params_}, deadNodesInfo["name"], deadNodesInfo["mode"], deadNodesInfo["agentSite"])
            for (item in res) {
                if (!isVoid(item)) {
                    ret.append!(item)
                }
            }
        }
    }

    return ret
}

def searchLogFromFile(params) {
    logTypes = params["logType"]
    nodes = params["node"]
    ret = table(1:0, `timestamp`logLevel`logFile`content`node`logType, [NANOTIMESTAMP, SYMBOL, SYMBOL, STRING, SYMBOL, SYMBOL])
    res = []$TABLE
    for (logType_ in logTypes) {
        customWriteLog("Start to search log type: " + logType_)
        // 这一段不能封装为函数，有 BUG D20-23813
        if (logType_ == "running") {
            searchFunc = searchRunningLog
        } else if (logType_ == "job") {
            searchFunc = searchJobLog
        } else if (logType_ == "query") {
            searchFunc = searchQueryLog
        } else if (logType_ == "audit") {
            searchFunc = searchAuditLog
        } else if (logType_ == "aclAudit") {
            searchFunc = searchAclAuditLog
        } else if (logType_ == "access") {
            searchFunc = searchAccessLog
        } else if (logType_ == "hardware") {
            searchFunc = searchHardwareLog
        } else if (logType_ == "coredump") {
            searchFunc = searchCoredumpLog
        } else if (logType_ == "dmesg") {
            searchFunc = searchDmesgLog
        } else {
            throw "unsupported logType: " + logType_
        }
        if (logType_ == "dmesg" or logType_ == "coredump") {
            // 一台机器看一次
            clusterPerf = rpc(getControllerAlias(), getClusterPerf{true})
            nodes_ = exec first(name) as node from clusterPerf where name in nodes and state == 1 group by host
            nodes_ = nodes_["node"]
            log = searchLogInParallel(params, nodes_, searchFunc)
            log = select timestamp, logLevel, host as node, logFile, content from log left join clusterPerf on log.node == clusterPerf.name
        } else {
            log = searchLogInParallel(params, nodes, searchFunc)
        }
        update log set logType = logType_
        reorderColumns!(log, ret.schema().colDefs.name)
        ret.append!(log)
    }

    ret = select timestamp, logLevel, node, logType, logFile, content from ret order by timestamp, node, logType
    return ret
}

def searchLogInner(params) {
    isCacheHit = false
    if (params["cacheSize"] == 0) {
        ret = searchLogFromFile(params)
    } else {
        cachedJobInfo = select * from getSearchHistory(params)
        if (cachedJobInfo.size() > 0) {
            node = cachedJobInfo["jobNode"].last()
            cachedJobId = cachedJobInfo["jobId"].last()
            customWriteLog("Hit cache! JobId: " + cachedJobId + ", node: " + node)
            ret = rpc(node, searchLogFromCache, params, cachedJobId)
            isCacheHit = true
        } else {
            ret = searchLogFromFile(params)
        }
    }
    
    return ret, isCacheHit
}

def searchLog(params=NULL) {
    validatePrivilege()
    params_ = generateDefaultParams(params)
    ret, isCacheHit = searchLogInner(params_)
    if ((!isCacheHit and (memSize(ret) \ 1024 \ 1024) <= params_["cacheSize"]) or params_["cacheSize"] < 0) {
        jobDesc = generateJobDesc(params_)
        cacheFunc = def (log) {
            return log
        }
        jobId = submitJob("searchLog", jobDesc, cacheFunc, ret)
        customWriteLog("Cache! JobId: " + jobId)
    }
    return ret
}

def saveLogInner(log, dir, params_) {
    nodes = exec distinct(node) from log
    logTypes = exec distinct(logType) from log
    clusterPerf = rpc(getControllerAlias(), getClusterPerf{true})
    for (node_ in nodes) {
        for (logType_ in logTypes) {
            log_ = select * from log where node == node_ and logType == logType_
            if (log_.size() == 0) {
                continue
            }
            addColumn(log_, `filename, [STRING])
            if (logType_ == "dmesg") {
                update log_ set filename = "dmesg.log"
            } else if (logType_ == "coredump") {
                update log_ set filename = each(last, logFile.split("/")) + "." + temporalFormat(timestamp, "yyyyMMddHmsSSS") + ".log"
            } else if (logType_ == "access" or logType_ == "hardware") {
                filenames = each(last, log_["logFile"].split("/"))
                filenames = strReplace(filenames, logType_, node_ + "_" + logType_)
                update log_ set filename = filenames
            } else {
                update log_ set filename = each(last, logFile.split("/"))
            }

            nodeInfo = select * from clusterPerf where name == node_
            if (nodeInfo.size() == 0) {
                host = node_
            } else {
                host = nodeInfo["host"].first()
            }
            if (!exists(dir + "/" + host)) {
                mkdir(dir + "/" + host)
            }

            filenames = exec distinct(filename) from log_ 
            for (filename_ in filenames) {
                // filename_ = filenames[0]
                filepath = dir + "/" + host + "/" + filename_
                f = file(filepath, "w")
                content = exec content from log_ where filename == filename_
                f.writeLines(content)
                f.close()
            }
        }
    }
}

def saveLog(log, params=NULL) {
    validatePrivilege()
    if (log.form() != 6) {
        throw("log must be a table")
    }
    params_ = generateDefaultParams(params)
    v = version().split(" ").first()
    dir = params_["saveDir"] + "/LogSearcher_" + v + "_" + temporalFormat(params_["startTime"], "yyyyMMddHmsSSS") + "_" + temporalFormat(params_["endTime"], "yyyyMMddHmsSSS") + "_" + temporalFormat(now(), "yyyyMMddHmsSSS")

    try {
        mkdir(dir)
        saveLogInner(log, dir, params_)
    } catch(err) {
        customWriteLog("Save log error: " + err, ERROR)
        rmdir(dir, true)
        return
    }

    return dir
}

