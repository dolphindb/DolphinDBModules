
#include "setup/settings.txt"

use alphalens
go

testData = loadText(DATA_DIR+"/testData.csv")
prices = select close from testData pivot by tradeDate as Date, securityId
factor = select tradeDate as Date, securityId as asset, vwap as factor from testData
groupData = select tradeDate as Date, securityId as asset, rand(3, count(testData)) as Group from testData
factor_data = get_clean_factor_and_forward_returns(factor, prices, groupby=groupData)

def checkAllTables(res, byGroupFlag=false) {
    try {
        if (byGroupFlag==true) {
            assert count(res['mean_group_ic'])!=0
        }
        else {
            assert count(res['mean_monthly_ic'])!=0
        }
        assert count(res['ic_ts'])!=0
        assert count(res['Information_Analysis'])!=0
        assert count(res['ic'])!=0   
    } catch(ex) {
        return false
    }
    return true
}

@testing: case = "test_alphalens_function_create_information_tear_sheet"
res = create_information_tear_sheet(factor_data)
assert 1, form(res)==5
assert 2, checkAllTables(res)==true

@testing: case = "test_alphalens_function_create_information_tear_sheet_group_neutral"
res = create_information_tear_sheet(factor_data, group_neutral=true)
assert 1, checkAllTables(res)==true
res = create_information_tear_sheet(factor_data, group_neutral=false)
assert 2, checkAllTables(res)==true

@testing: case = "test_alphalens_function_create_information_tear_sheet_by_group"
res = create_information_tear_sheet(factor_data, by_group=false)
assert 1, checkAllTables(res)==true
res = create_information_tear_sheet(factor_data, by_group=true)
assert 2, checkAllTables(res, true)==true
