#include "setup/settings.txt"

use alphalens
go

testData = loadText(DATA_DIR+"/testData.csv")
prices = select close from testData pivot by tradeDate as Date, securityId
factor = select tradeDate as Date, securityId as asset, vwap as factor from testData
groupData = select tradeDate as Date, securityId as asset, rand(3, count(testData)) as Group from testData
factor_data = get_clean_factor_and_forward_returns(factor, prices, groupby=groupData)

def checkAllTables(res) {
    try {
        assert count(res['plot_cumulative_returns_1'])!=0
        assert count(res['cumulative_factor_data'])!=0
        assert count(res['cum_ret'])!=0
        assert count(res['std_spread_quant'])!=0
        assert count(res['returns_analysis'])!=0
        assert count(res['mean_ret_spread_quant'])!=0
        assert count(res['mean_quant_rateret_bydate'])!=0
        assert count(res['mean_quant_ret_bydate'])!=0
        assert count(res['factor_returns_'])!=0
        assert count(res['mean_quant_rateret'])!=0        
    } catch(ex) {
        return false
    }
    return true
}

@testing: case = "test_alphalens_function_plot_create_returns_tear_sheet"
res = plot_create_returns_tear_sheet(factor_data)
assert 1, form(res)==5
assert 2, checkAllTables(res)==true

@testing: case = "test_alphalens_function_plot_create_returns_tear_sheet_long_short"
res = plot_create_returns_tear_sheet(factor_data, long_short=true)
assert 1, checkAllTables(res)==true
res = plot_create_returns_tear_sheet(factor_data, long_short=false)
assert 2, checkAllTables(res)==true

@testing: case = "test_alphalens_function_plot_create_returns_tear_sheet_group_neutral"
res = plot_create_returns_tear_sheet(factor_data, group_neutral=true)
assert 1, checkAllTables(res)==true
res = plot_create_returns_tear_sheet(factor_data, group_neutral=false)
assert 2, checkAllTables(res)==true

@testing: case = "test_alphalens_function_plot_create_returns_tear_sheet_by_group"
res = plot_create_returns_tear_sheet(factor_data, by_group=false)
assert 1, checkAllTables(res)==true
res = plot_create_returns_tear_sheet(factor_data, by_group=true)
assert 2, checkAllTables(res)==true
