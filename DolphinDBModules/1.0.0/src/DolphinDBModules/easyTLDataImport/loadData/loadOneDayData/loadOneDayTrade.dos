module DolphinDBModules::easyTLDataImport::loadData::loadOneDayData::loadOneDayTrade

use DolphinDBModules::easyTLDataImport::tbSchema::csvSchema::tradeCsvSchema

def module_info(){
    res = dict(STRING,ANY)
    res["moduleName"] = "DolphinDBModules"
    res["moduleVersion"] = "1.0.0"
    res["isFree"] = true
    return res
}
/*
 * @FunctionName: transformTradeSH
 * @Brief: Transforms the trade data for the Shanghai market into a standardized format.
 * @Param: day: The specific trading day for which the data is being processed.
 * @Param: merge: A boolean flag indicating whether to merge the data from different exchanges.
 * @Param: t: The input data table containing the original trade data.
 * @Return: A table containing transformed trade data in the specified format.
 */
def transformTradeSH(day, merge, t){
	// Process the trade data format based on the presence of the "BizIndex" column
	if("BizIndex" in t.colNames())	tmpData = select * from t
	else							tmpData = select *, long(NULL) as BizIndex from t

	// Standardize the data type if merging is enabled
	if(merge==true){
		tmpData = select TradeChan as ChannelNo, 
						TradeIndex as ApplSeqNum, 
						string(NULL) as MDStreamID, 
						TradeBuyNo as BidApplSeqNum, 
						TradeSellNo as OfferApplSeqNum, 
						SecurityID as SecurityID, 
						string(NULL) as SecurityIDSource, 
						TradPrice as TradePrice, 
						TradVolume as TradeQty, 
						string(NULL) as ExecType, 
						day as TradeDate, 
						TradTime as TradeTime, 
						LocalTime as LocalTime, 
						SeqNo as SeqNo, 
						DataStatus as DataStatus, 
						TradeMoney as TradeMoney, 
						TradeBSFlag as TradeBSFlag, 
						BizIndex as BizIndex, 
						string(NULL) as OrderKind, 
						"SH" as Market 
					from tmpData
	}else{
		tmpData = select DataStatus as DataStatus, 
						TradeIndex as ApplSeqNum, 
						TradeChan as ChannelNo, 
						SecurityID as SecurityID, 
						day as TradeDate,
						TradTime as TradeTime, 
						TradPrice as TradePrice, 
						TradVolume as TradeQty, 
						TradeMoney as TradeMoney, 
						TradeBuyNo as BidApplSeqNum, 
						TradeSellNo as OfferApplSeqNum, 
						TradeBSFlag as TradeBSFlag, 
						BizIndex as BizIndex, 
						LocalTime as LocalTime, 
						SeqNo as SeqNo 
					from tmpData
	}
	return tmpData
}

/*
 * @FunctionName: transformTradeSZ
 * @Brief: Transforms the trade data for the Shenzhen market into a standardized format.
 * @Param: day: The specific trading day for which the data is being processed.
 * @Param: merge: A boolean flag indicating whether to merge the data from different exchanges.
 * @Param: t: The input data table containing the original trade data.
 * @Return: A table containing transformed trade data in the specified format.
 */
def transformTradeSZ(day, merge, t){
	// Standardize the data type if merging is enabled
	if(merge==true){
		if(day < 2016.05.07){
			tmpData = select SetNo as ChannelNo, 
							RecNo as ApplSeqNum, 
							string(NULL) as MDStreamID, 
							BuyOrderRecNo as BidApplSeqNum, 
							SellOrderRecNo as OfferApplSeqNum, 
							SecurityID as SecurityID, 
							string(NULL) as SecurityIDSource, 
							Price as TradePrice, 
							TradeQty as TradeQty, 
							FunctionCode as ExecType, 
							day as TradeDate, 
							TradeTime as TradeTime, 
							LocalTime as LocalTime, 
							SeqNo as SeqNo, 
							int(NULL) as DataStatus, 
							double(NULL) as TradeMoney, 
							string(NULL) as TradeBSFlag, 
							long(NULL) as BizIndex, 
							OrderKind as OrderKind, 
							"SZ" as Market 
						from t
		}else{
			tmpData = select ChannelNo as ChannelNo, 
							ApplSeqNum as ApplSeqNum, 
							MDStreamID as MDStreamID, 
							BidApplSeqNum as BidApplSeqNum, 
							OfferApplSeqNum as OfferApplSeqNum, 
							SecurityID as SecurityID, 
							SecurityIDSource as SecurityIDSource, 
							LastPx as TradePrice, 
							LastQty as TradeQty, 
							string(char(ExecType)) as ExecType, 
							day as TradeDate, 
							TransactTime as TradeTime, 
							LocalTime as LocalTime, 
							SeqNo as SeqNo, 
							int(NULL) as DataStatus, 
							double(NULL) as TradeMoney, 
							string(NULL) as TradeBSFlag, 
							long(NULL) as BizIndex, 
							string(NULL) as OrderKind, 
							"SZ" as Market 
						from t
		}	
	}else{
		if(day < 2016.05.07){
			tmpData = select SetNo as ChannelNo, 
							RecNo as ApplSeqNum, 
							string(NULL) as MDStreamID, 
							BuyOrderRecNo as BidApplSeqNum, 
							SellOrderRecNo as OfferApplSeqNum, 
							SecurityID as SecurityID, 
							string(NULL) as SecurityIDSource, 
							Price as TradePrice, 
							TradeQty as TradeQty, 
							FunctionCode as ExecType, 
							day as TradeDate, 
							TradeTime as TradeTime, 
							LocalTime as LocalTime, 
							SeqNo as SeqNo, 
							OrderKind 
					from t
		}else{
			tmpData = select ChannelNo as ChannelNo, 
							ApplSeqNum as ApplSeqNum, 
							MDStreamID as MDStreamID, 
							BidApplSeqNum as BidApplSeqNum, 
							OfferApplSeqNum as OfferApplSeqNum, 
							SecurityID as SecurityID, 
							SecurityIDSource as SecurityIDSource, 
							LastPx as TradePrice, 
							LastQty as TradeQty, 
							string(char(ExecType)) as ExecType, 
							day as TradeDate, 
							TransactTime as TradeTime, 
							LocalTime as LocalTime, 
							SeqNo as SeqNo, 
							string(NULL) as OrderKind 
						from t
		}
	}
	return tmpData
}

/*
 * @FunctionName: appendTrade
 * @Brief: Appends or upserts transformed trade data into the specified trade table in the database.
 * @Param: day: The specific trading day for which the data is being processed.
 * @Param: merge: A boolean flag indicating whether to merge the data from different exchanges.
 * @Param: t: The input data table containing the original trade data to be transformed and appended.
 * @Param: isConcatTime: A boolean flag indicating whether to concatenate trade date and trade time into a single timestamp.
 * @Param: isDataDuplicated: A boolean flag indicating whether to remove duplicate entries from the data.
 * @Param: dbNameTrade: The name of the database containing the trade data table.
 * @Param: tbNameTrade: The name of the trade data table where the transformed data will be appended or upserted.
 * @Param: transformFunc: A function reference used for transforming the trade data format.
 */
def appendTrade(day, merge, t, isConcatTime, isDataDuplicated, dbNameTrade, tbNameTrade, transformFunc){
	// Call the transformation function to standardize the data
	tmpData = transformFunc(day, merge, t)
	
	// Remove duplicate entries from the data if specified
	if(isDataDuplicated==true){
		tmpData = select * from tmpData where isDuplicated([ChannelNo, ApplSeqNum], LAST)=false
	}

	// Handle concatenation of trade date and time if specified
	if(isConcatTime==true){
		tmpData.replaceColumn!(`TradeTime, concatDateTime(tmpData["TradeDate"], tmpData["TradeTime"]))
		tmpData.dropColumns!(`TradeDate)
	}
	
	// Determine how to handle data entry based on duplication flag
	pt = loadTable(dbNameTrade, tbNameTrade)
	if(isDataDuplicated==true){
		keyColNames=`ApplSeqNum`ChannelNo
		upsert!(pt, tmpData, keyColNames=keyColNames) 
	}else{
		append!(pt, tmpData)
	}
}


/*
 * @FunctionName: loadOneDayTradeSH
 * @Brief: Loads one day's worth of trade data from specified CSV files for the Shanghai market.
 * @Param: csvFiles: A vector of CSV file paths containing the entrust data for the specified day.
 * @Param: day: The specific trading day for which the data is being loaded.
 * @Param: dbNameTrade: The name of the database where the trade data will be stored.
 * @Param: dbNameTrade: The name of the table where the trade data will be loaded.
 * @Param: merge: A boolean flag indicating whether to merge the data from different exchanges.
 * @Param: isConcatTime: A boolean flag indicating whether to concatenate trade date and time into a single timestamp.
 * @Param: isDataDuplicated: A boolean flag indicating whether to handle duplicate data entries during loading.
 * @Return: A message indicating the success or failure of the loading process, or an error message if an error occurs.
 */
def loadOneDayTradeSH(csvFiles, day, dbNameTrade, tbNameTrade, merge, isConcatTime, isDataDuplicated){
	// Check if the required data file exists for the specified trading day
	csvNames = "Transaction.csv"
	csvPath = csvFiles[endsWith(csvFiles, csvNames)][0]
	if(csvPath==NULL){
		errorMessage = dict(`message`code, ["上交所 [" + string(day) + "] 日期的 [" + csvNames + "] 的 csv 文件不全或者不存在", "error"])
		return errorMessage
	}

	// Validate the number of columns in the Trade data against the expected schema
	schemaTB = tradeCsvSchemaSH(day)
	schemaTest = extractTextSchema(csvPath)
	if(schemaTB.rows() != schemaTest.rows()){
		errorMessage = dict(`message`code, ["[" + csvPath + "] 的数据格式有误，列数不匹配", "error"])
		return errorMessage
	}

	try{
		// Create a data source for loading the CSV in chunks
		ds = textChunkDS(filename=csvPath, chunkSize=512, schema=schemaTB)
		// Use map-reduce to process the data, appending the transformed entries to the database
		mr(ds, appendTrade{day, merge, , isConcatTime, isDataDuplicated, dbNameTrade, tbNameTrade, transformTradeSH}, parallel=false)
	}catch(ex){
		errorMessage = dict(`message`code, [string(ex[0])+":"+string(ex[1]), "error"])
		return errorMessage
	}
	return true
}


/*
 * @FunctionName: loadOneDayTradeSZ
 * @Brief: Loads one day's worth of trade data from specified CSV files for the Shenzhen market.
 * @Param: csvFiles: A vector of CSV file paths containing the entrust data for the specified day.
 * @Param: day: The specific trading day for which the data is being loaded.
 * @Param: dbNameTrade: The name of the database where the trade data will be stored.
 * @Param: dbNameTrade: The name of the table where the trade data will be loaded.
 * @Param: merge: A boolean flag indicating whether to merge the data from different exchanges.
 * @Param: isConcatTime: A boolean flag indicating whether to concatenate trade date and time into a single timestamp.
 * @Param: isDataDuplicated: A boolean flag indicating whether to handle duplicate data entries during loading.
 * @Return: A message indicating the success or failure of the loading process, or an error message if an error occurs.
 */
def loadOneDayTradeSZ(csvFiles, day, dbNameTrade, tbNameTrade, merge, isConcatTime, isDataDuplicated){
	// Check if the required data file exists for the specified trading day
	csvNames = iif(day < 2016.05.07, "Trade.csv", "mdl_6_36_0.csv")
	csvPath = csvFiles[endsWith(csvFiles, csvNames)][0]
	if(csvPath==NULL){
		errorMessage = dict(`message`code, ["深交所 [" + string(day) + "] 日期的 [" + csvNames + "] 的 csv 文件不全或者不存在", "error"])
		return errorMessage
	}

	// Validate the number of columns in the Entrust data against the expected schema
	schemaTB = tradeCsvSchemaSZ(day)
	schemaTest = extractTextSchema(csvPath)
	if(schemaTB.rows() != schemaTest.rows()){
		errorMessage = dict(`message`code, ["[" + csvPath + "] 的数据格式有误，列数不匹配", "error"])
		return errorMessage
	}

	try{
		// Create a data source for loading the CSV in chunks
		ds = textChunkDS(filename=csvPath, chunkSize=512, schema=schemaTB)
		// Use map-reduce to process the data, appending the transformed entries to the database
		mr(ds, appendTrade{day, merge, , isConcatTime, isDataDuplicated, dbNameTrade, tbNameTrade, transformTradeSZ}, parallel=false)
	}catch(ex){
		errorMessage = dict(`message`code, [string(ex[0])+":"+string(ex[1]), "error"])
		return errorMessage
	}
	return true
}