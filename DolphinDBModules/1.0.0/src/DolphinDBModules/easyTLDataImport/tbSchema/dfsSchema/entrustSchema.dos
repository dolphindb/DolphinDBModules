/*
 * @FunctionName: entrustSchemaTb
 * @Brief: Defines the schema for the entrust data table for the Shenzhen market and the Shanghai market. 
 * @Param: isConcatTime: A boolean flag indicating whether to concatenate trade date and time into a single timestamp (true) or keep them as separate columns (false).
 * @Return: A table schema defining the structure of the trade data table.
 */
def entrustSchemaTb(isConcatTime){
	if(isConcatTime==true){
		name = `ChannelNo`ApplSeqNum`MDStreamID`SecurityID`SecurityIDSource`Price`OrderQty`Side`TradeTime`OrderType`LocalTime`SeqNo`OrderNO`DataStatus`BizIndex`Market
		type = [`INT, `LONG, `SYMBOL, `SYMBOL, `SYMBOL, `DOUBLE, `LONG, `SYMBOL, `TIMESTAMP, `SYMBOL, `TIME, `LONG, `LONG, `INT,`LONG, `SYMBOL]
	}else{
		name = `ChannelNo`ApplSeqNum`MDStreamID`SecurityID`SecurityIDSource`Price`OrderQty`Side`TradeDate`TradeTime`OrderType`LocalTime`SeqNo`OrderNO`DataStatus`BizIndex`Market
		type = [`INT, `LONG, `SYMBOL, `SYMBOL, `SYMBOL, `DOUBLE, `LONG, `SYMBOL, `DATE, `TIME, `SYMBOL, `TIME, `LONG, `LONG, `INT,`LONG, `SYMBOL]
	}
	return table(1:0, name, type)
}

