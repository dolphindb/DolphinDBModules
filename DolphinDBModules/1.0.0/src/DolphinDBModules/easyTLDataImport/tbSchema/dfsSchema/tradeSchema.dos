/*
 * @FunctionName: tradeSchemaTb
 * @Brief: Defines the schema for the trade data table for the Shenzhen market and the Shanghai market. 
 * @Param: isConcatTime: A boolean flag indicating whether to concatenate trade date and time into a single timestamp (true) or keep them as separate columns (false).
 * @Return: A table schema defining the structure of the trade data table.
 */
def tradeSchemaTb(isConcatTime){
	if(isConcatTime==true){
		name = `ChannelNo`ApplSeqNum`MDStreamID`BidApplSeqNum`OfferApplSeqNum`SecurityID`SecurityIDSource`TradePrice`TradeQty`ExecType`TradeTime`LocalTime`SeqNo`DataStatus`TradeMoney`TradeBSFlag`BizIndex`OrderKind`Market
		type = [`INT, `LONG, `SYMBOL, `LONG, `LONG, `SYMBOL, `SYMBOL, `DOUBLE, `LONG, `SYMBOL, `TIMESTAMP, `TIME, `LONG, `INT, `DOUBLE, `SYMBOL, `LONG, `SYMBOL, `SYMBOL]
	}else{
		name = `ChannelNo`ApplSeqNum`MDStreamID`BidApplSeqNum`OfferApplSeqNum`SecurityID`SecurityIDSource`TradePrice`TradeQty`ExecType`TradeDate`TradeTime`LocalTime`SeqNo`DataStatus`TradeMoney`TradeBSFlag`BizIndex`OrderKind`Market
		type = [`INT, `LONG, `SYMBOL, `LONG, `LONG, `SYMBOL, `SYMBOL, `DOUBLE, `LONG, `SYMBOL, `DATE, `TIME, `TIME, `LONG, `INT, `DOUBLE, `SYMBOL, `LONG, `SYMBOL, `SYMBOL]
	}
	return table(1:0, name, type)
}

